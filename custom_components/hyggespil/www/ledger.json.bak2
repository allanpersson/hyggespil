org","q":"slægt oryctolagus","ok":true},{"u":"https://snl.no/kanin","d":"snl.no","q":"store norske leksikon biologi dyreriket virveldyr pattedyr haredyr harefamilien oryctolagus","ok":true}]},"kwho|{\"a\":\"Høne\",\"age\":3,\"c\":[\"Jeg lægger æg.\",\"Jeg siger kokkelik.\",\"Jeg har fjer og vinger.\",\"Jeg bor på en gård.\",\"Jeg kan ikke flyve langt.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/H%C3%B8ne","d":"wikipedia.org","q":"høner lægger æg uafhængigt af en hanes tilstedeværelse","ok":true},{"u":"https://snl.no/h%C3%B8ne","d":"snl.no","q":"høne er hunndyret hos hønsefugler, inkludert høns","ok":true}]},"kwho|{\"a\":\"And\",\"age\":3,\"c\":[\"Jeg siger rap.\",\"Jeg svømmer i vand.\",\"Jeg har svømmefødder.\",\"Jeg har en flad næb.\",\"Jeg spiser brød og smådyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/And","d":"wikipedia.org","q":"andens fødder er flade og tæerne adspredt med svømmehud imellem","ok":true},{"u":"https://snl.no/and","d":"snl.no","q":"and som holdes husdyr er oftest tam form av","ok":true}]},"kwho|{\"a\":\"Gås\",\"age\":4,\"c\":[\"Jeg er større end en and.\",\"Jeg siger honk.\",\"Jeg har en lang hals.\",\"Jeg svømmer i vand.\",\"Jeg kan være meget højlydt.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/G%C3%A5s","d":"wikipedia.org","q":"halsen er ret lang, men kraftig og bevægelig","ok":true},{"u":"https://snl.no/g%C3%A5s","d":"snl.no","q":"gjess store norske leksikon biologi dyreriket virveldyr fugler andefugler","ok":true}]},"kwho|{\"a\":\"Mus\",\"age\":3,\"c\":[\"Jeg er meget lille.\",\"Jeg har store ører.\",\"Jeg siger pip.\",\"Jeg spiser ost og korn.\",\"Jeg bor i et hul.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Mus","d":"wikipedia.org","q":"den findes i næsten alle lande hvor den lever sammen med mennesker i deres huse","ok":true},{"u":"https://snl.no/mus","d":"snl.no","q":"mus store norske leksikon biologi dyreriket virveldyr pattedyr gnag","ok":true}]},"kwho|{\"a\":\"Bi\",\"age\":4,\"c\":[\"Jeg kan flyve.\",\"Jeg laver honning.\",\"Jeg har en brod.\",\"Jeg samler pollen fra blomster.\",\"Jeg bor i en bikube.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Bi","d":"wikipedia.org","q":"redebyggende og lever i kolonier med en dronning og arbejderbier, ligesom honningbien","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Bee","d":"newworldencyclopedia.org","q":"bees convert nectar to honey in their digestive tract","ok":true}]},"kwho|{\"a\":\"Sommerfugl\",\"age\":4,\"c\":[\"Jeg var engang en larve.\",\"Jeg har store, farverige vinger.\",\"Jeg flyver fra blomst til blomst.\",\"Jeg drikker nektar.\",\"Jeg har seks ben.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Sommerfugl","d":"wikipedia.org","q":"har en livscyklus med en fuldstændig forvandling , nemlig som æg , larve (kålorm), puppe og fuldt udviklet insekt","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Butterfly","d":"newworldencyclopedia.org","q":"caterpillars larvae, or caterpillars , are multi-legged eating machines","ok":true}]},"kwho|{\"a\":\"Snegl\",\"age\":3,\"c\":[\"Jeg har et hus på ryggen.\",\"Jeg er meget langsom.\",\"Jeg efterlader en slimet stribe.\",\"Jeg kommer frem, når det regner.\",\"Jeg spiser blade.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Snegl","d":"wikipedia.org","q":"sneglenes bløde krop er ofte beskyttet af en kalkskal . dette sneglehus er typisk rundt eller kegleformet og snoet","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Snail","d":"newworldencyclopedia.org","q":"snails are found in freshwater, marine, and terrestrial environments","ok":true}]},"kwho|{\"a\":\"Edderkop\",\"age\":4,\"c\":[\"Jeg har otte ben.\",\"Jeg laver spindelvæv.\",\"Jeg fanger insekter i mit net.\",\"Jeg har ikke vinger.\",\"Jeg bor i hjørner.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Edderkop","d":"wikipedia.org","q":"er karakteriseret ved at have en todelt krop, otte ben , spindevorter og giftkirtler","ok":true},{"u":"https://snl.no/edderkopp","d":"snl.no","q":"edderkopper er en gruppe som hører til edderkoppdyrene","ok":true}]},"kwho|{\"a\":\"Regnorm\",\"age\":4,\"c\":[\"Jeg har ingen ben.\",\"Jeg lever i jorden.\",\"Jeg er lang og tynd.\",\"Jeg spiser jord og blade.\",\"Fiskere bruger mig som madding.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Regnorm","d":"wikipedia.org","q":"stor regnorm , lumbricus terrestris","ok":true},{"u":"https://snl.no/meitemark","d":"snl.no","q":"meitemark er en gruppe leddormer som lever i jorden","ok":true}]},"kwho|{\"a\":\"Ugle\",\"age\":4,\"c\":[\"Jeg kan dreje mit hoved meget langt.\",\"Jeg er vågen om natten.\",\"Jeg siger uhu.\",\"Jeg har store øjne.\",\"Jeg spiser mus.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ugle","d":"wikipedia.org","q":"de stort set ikke kan bevæge øjnene, men i stedet må dreje hele hovedet","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Owl","d":"newworldencyclopedia.org","q":"most owls are nocturnal, actively hunting for prey only under the cover of darkness","ok":true}]},"kwho|{\"a\":\"Ræv\",\"age\":4,\"c\":[\"Jeg har en busket hale.\",\"Jeg er orange og hvid.\",\"Jeg er snu.\",\"Jeg bor i en hule.\",\"Jeg spiser både dyr og bær.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/R%C3%A6v","d":"wikipedia.org","q":"halen er busket og ender som regel i en mere eller mindre hvid spids","ok":true},{"u":"https://snl.no/rev","d":"snl.no","q":"man kan karakterisere rødreven som et mellomstort landrovdyr","ok":true}]},"kwho|{\"a\":\"Egern\",\"age\":4,\"c\":[\"Jeg har en stor, busket hale.\",\"Jeg samler nødder.\",\"Jeg kan klatre i træer.\",\"Jeg har store, skarpe tænder.\",\"Jeg er lille og hurtig.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Egern","d":"wikipedia.org","q":"halen er lang og busket","ok":true},{"u":"https://snl.no/ekorn","d":"snl.no","q":"ekorn er en gnagerart i ekornfamilien","ok":true}]},"kwho|{\"a\":\"Pingvin\",\"age\":4,\"c\":[\"Jeg kan ikke flyve.\",\"Jeg svømmer i koldt vand.\",\"Jeg går på to ben.\",\"Jeg har en sort og hvid dragt.\",\"Jeg bor i kolde egne.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Pingvin","d":"wikipedia.org","q":"pingviner ( spheniscidae ) er en familie af flyveudygtige, dykkende sø fugle","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Penguin","d":"newworldencyclopedia.org","q":"is the common name for any of the aquatic, gregarious, flightless birds comprising the family spheniscidae","ok":true}]},"kwho|{\"a\":\"Elefant\",\"age\":5,\"c\":[\"Jeg er verdens største landdyr.\",\"Jeg har en lang snabel.\",\"Jeg har store ører.\",\"Jeg spiser planter.\",\"Jeg har stødtænder.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Elefant","d":"wikipedia.org","q":"orden proboscidea ( snabeldyr )","ok":true},{"u":"https://lex.dk/elefant","d":"lex.dk","q":"pattedyr afrotheria elefant, se elefanter","ok":true}]},"kwho|{\"a\":\"Løve\",\"age\":4,\"c\":[\"Jeg har en manke.\",\"Jeg siger brøl.\",\"Jeg lever i flok.\",\"Jeg er gul og stor.\",\"Jeg er et stort kattedyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/L%C3%B8ve","d":"wikipedia.org","q":"løven (latin: panthera leo) er en af de fem store katte","ok":true},{"u":"https://snl.no/l%C3%B8ve","d":"snl.no","q":"løve er et rovdyr i kattefamilien","ok":true}]},"kwho|{\"a\":\"Tiger\",\"age\":4,\"c\":[\"Jeg har sorte striber på orange pels.\",\"Jeg er verdens største kattedyr.\",\"Jeg bor i skov og jungle.\",\"Jeg har skarpe tænder.\",\"Jeg er et stort kattedyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Tiger","d":"wikipedia.org","q":"tigeren (latin: panthera tigris) er den største katteart","ok":true},{"u":"https://snl.no/tiger","d":"snl.no","q":"tiger er et rovdyr i kattefamilien","ok":true}]},"kwho|{\"a\":\"Zebra\",\"age\":3,\"c\":[\"Jeg har sorte og hvide striber.\",\"Jeg ligner en hest.\",\"Jeg bor på savannen.\",\"Jeg løber i flok.\",\"Jeg er et hovdyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Zebra","d":"wikipedia.org","q":"zebraer er en underslægt i hesteslægten","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Zebra","d":"newworldencyclopedia.org","q":"zebra is the common name for various wild horse like odd toed ungulates","ok":true}]},"kwho|{\"a\":\"Giraf\",\"age\":3,\"c\":[\"Jeg er verdens højeste dyr.\",\"Jeg har en meget lang hals.\",\"Jeg har brune pletter.\",\"Jeg spiser blade fra træer.\",\"Jeg bor på savannen.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Giraf","d":"wikipedia.org","q":"giraffen (latin: giraffa camelopardalis) er verdens højeste landlevende dyr","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Giraffe","d":"newworldencyclopedia.org","q":"tallest of all land living animal species","ok":true}]},"kwho|{\"a\":\"Abe\",\"age\":3,\"c\":[\"Jeg kan klatre i træer.\",\"Jeg spiser frugt.\",\"Jeg har hænder og fingre.\",\"Jeg er nysgerrig og legesyg.\",\"Jeg bor i skov og jungle.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Abe","d":"wikipedia.org","q":"en abe er i snæver forstand betegnelsen på en primat","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Monkey","d":"newworldencyclopedia.org","q":"a monkey is any member of two of the three groupings of simian primates","ok":true}]},"kwho|{\"a\":\"Isbjørn\",\"age\":4,\"c\":[\"Jeg er hvid.\",\"Jeg bor i det kolde nord.\",\"Jeg kan svømme i isvand.\",\"Jeg spiser fisk og sæler.\",\"Jeg er et stort rovdyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Isbj%C3%B8rn","d":"wikipedia.org","q":"isbjørnen (latin: ursus maritimus) er en stor gullighvid bjørn","ok":true},{"u":"https://snl.no/isbj%C3%B8rn","d":"snl.no","q":"isbjørn er en art i bjørnefamilien og verdens største landlevende rovdyr","ok":true}]},"kwho|{\"a\":\"Bjørn\",\"age\":4,\"c\":[\"Jeg har brun pels.\",\"Jeg bor i skov.\",\"Jeg kan stå på bagbenene.\",\"Jeg spiser bær og honning.\",\"Jeg sover om vinteren.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://snl.no/bj%C3%B8rn","d":"snl.no","q":"bjørn (egentlig brunbjørn) er et pattedyr i familien bjørner","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Brown_bear","d":"newworldencyclopedia.org","q":"brown bear is the common name for a large bear ursus arctos","ok":true}]},"kwho|{\"a\":\"Ulv\",\"age\":4,\"c\":[\"Jeg hyler til månen.\",\"Jeg lever i flok.\",\"Jeg ligner en hund.\",\"Jeg bor i skov og mark.\",\"Jeg er et rovdyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ulv","d":"wikipedia.org","q":"ulven (eller den grå ulv) (canis lupus) er et rovdyr","ok":true},{"u":"https://snl.no/ulv","d":"snl.no","q":"ulv er et rovpattedyr i hundefamilien","ok":true}]},"kwho|{\"a\":\"Krokodille\",\"age\":4,\"c\":[\"Jeg har skarpe tænder.\",\"Jeg lever i vand og på land.\",\"Jeg ligner en dinosaur.\",\"Jeg har en lang snude.\",\"Jeg er et krybdyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Krokodille","d":"wikipedia.org","q":"krokodiller forekommer hovedsageligt i tropisk lavland","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Crocodile","d":"newworldencyclopedia.org","q":"crocodile is the common name for any species belonging to the reptile family crocodylidae","ok":true}]},"kwho|{\"a\":\"Slange\",\"age\":3,\"c\":[\"Jeg har ingen ben.\",\"Jeg kryber på jorden.\",\"Jeg kan være giftig.\",\"Jeg har skæl.\",\"Jeg er et krybdyr.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Slange","d":"wikipedia.org","q":"slanger er langstrakte benløse kødædende krybdyr i underordenen serpentes","ok":true},{"u":"https://snl.no/slanger","d":"snl.no","q":"slanger er en underorden av reptiler","ok":true}]},"kwho|{\"a\":\"Skildpadde\",\"age\":3,\"c\":[\"Jeg har et hus på ryggen.\",\"Jeg er meget langsom.\",\"Jeg trækker hovedet ind.\",\"Jeg lever på land og i vand.\",\"Jeg har skæl.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Skildpadde","d":"wikipedia.org","q":"skildpadder (testudines) er en orden af krybdyr der opstod for cirka 220 millioner år siden","ok":true},{"u":"https://www.newworldencyclopedia.org/entry/Turtle","d":"newworldencyclopedia.org","q":"turtle is any aquatic or terrestrial reptile of the order testudines","ok":true}]},"kwho|{\"a\":\"Frø\",\"age\":3,\"c\":[\"Jeg hopper.\",\"Jeg siger kvæk.\",\"Jeg lever ved vand.\",\"Jeg var først en haletudse.\",\"Jeg har store bagben.\"]}":{"pool":"kwho","status":"be
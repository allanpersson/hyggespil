":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Tour_de_France","d":"lex.dk","q":"Løbet er blevet kørt siden 1903","ok":true},{"u":"https://en.wikipedia.org/wiki/Tour_de_France","d":"wikipedia.org","q":"The race was first organized in 1903 to increase sales for the newspaper L'Auto","ok":true},{"u":"https://lex.dk/Erik_Fosnes_Hansen","d":"lex.dk","q":"der spillede ved Titanics forlis i 1912","ok":true},{"u":"https://en.wikipedia.org/wiki/Titanic","d":"wikipedia.org","q":"RMS Titanic was a British ocean liner that sank in the early hours of 15 April 1912 after striking an iceberg","ok":true}],"note":"Første Tour 1903; Titanic sank 15. april 1912. A skete først."},"tl|Første verdenskrig slutter (1918) | Genforeningen med Sønderjylland (1920)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/1._Verdenskrig","d":"lex.dk","q":"krigshandlingerne varede indtil våbenhvilen d. 11. november 1918","ok":true},{"u":"https://en.wikipedia.org/wiki/Armistice_of_11_November_1918","d":"wikipedia.org","q":"The Armistice of 11 November 1918 was the armistice that ended fighting on land, at sea, and in the air in World War I","ok":true},{"u":"https://lex.dk/Genforeningen","d":"lex.dk","q":"Genforeningen er de sønderjyske landsdeles genforening med Danmark 9. juli 1920.","ok":true},{"u":"https://en.wikipedia.org/wiki/1920_Schleswig_plebiscites","d":"wikipedia.org","q":"the larger northern portion (Zone I) voted to join Denmark, which occurred 15 June 1920","ok":true}],"note":"Våbenhvile 11. november 1918; genforeningen 1920. A skete først."},"tl|Hitler bliver kansler (1933) | Anden verdenskrig begynder (1939)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Adolf_Hitler","d":"lex.dk","q":"I januar 1933 blev Hitler udnævnt til regeringschef, rigskansler","ok":true},{"u":"https://en.wikipedia.org/wiki/Adolf_Hitler","d":"wikipedia.org","q":"On 30 January 1933, the new cabinet was sworn in during a brief ceremony in Hindenburg's office.","ok":true},{"u":"https://lex.dk/2._Verdenskrig","d":"lex.dk","q":"i Europa med Tysklands angreb på Polen den 1. september 1939.","ok":true},{"u":"https://en.wikipedia.org/wiki/Invasion_of_Poland","d":"wikipedia.org","q":"Fall Weiss was initiated on 1 September 1939 and was the first operation of Second World War in Europe","ok":true}],"note":"Hitler kansler 30. januar 1933; Polen angrebet 1. september 1939. A skete først."},"tl|Pearl Harbor (1941) | D-Day (landgangen i Normandiet) (1944)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Pearl_Harbor","d":"lex.dk","q":"Søndag den 7.12.1941 om morgenen iværksatte en japansk flådestyrke","ok":true},{"u":"https://en.wikipedia.org/wiki/Attack_on_Pearl_Harbor","d":"wikipedia.org","q":"Fuchida led the Japanese attack on December 7, 1941.","ok":true},{"u":"https://lex.dk/D-dag","d":"lex.dk","q":"de allieredes invasion i Normandiet 6. juni 1944","ok":true},{"u":"https://en.wikipedia.org/wiki/Normandy_landings","d":"wikipedia.org","q":"D-Day: 6 June 1944: The Normandy Landings","ok":true}],"note":"Pearl Harbor 7. december 1941; D-Day 6. juni 1944. A skete først."},"tl|Atombomben over Hiroshima (1945) | Israel grundlægges (1948)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Hiroshima","d":"lex.dk","q":"De to atombomber, der detonerede over Hiroshima og Nagasaki 6. og 9. august 1945.","ok":true},{"u":"https://en.wikipedia.org/wiki/Atomic_bombings_of_Hiroshima_and_Nagasaki","d":"wikipedia.org","q":"Hiroshima was the primary target of the first atomic bombing mission on 6 August","ok":true},{"u":"https://lex.dk/Israels_historie","d":"lex.dk","q":"Den jødiske stat blev proklameret den 14. maj 1948 på grundlag af en FN-beslutning om deling af Palæstina.","ok":true},{"u":"https://en.wikipedia.org/wiki/Israel","d":"wikipedia.org","q":"Israel declared independence on 14 May 1948","ok":true}],"note":"Hiroshima 6. august 1945; Israel proklameret 14. maj 1948. A skete først."},"tl|Koreakrigen begynder (1950) | Elizabeth II krones (1953)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Nordkoreas_historie","d":"lex.dk","q":"den 25. juni 1950 udbrød Koreakrigen","ok":true},{"u":"https://en.wikipedia.org/wiki/Korean_War","d":"wikipedia.org","q":"On 25 June 1950, North Korea launched an invasion of South Korea","ok":true},{"u":"https://lex.dk/tv_-_programhistorie","d":"lex.dk","q":"kroningen af Elizabeth 2. i 1953","ok":true},{"u":"https://en.wikipedia.org/wiki/Coronation_of_Elizabeth_II","d":"wikipedia.org","q":"took place on 2 June 1953 at Westminster Abbey","ok":true}],"note":"Koreakrigen udbrød 25. juni 1950; Elizabeth II kronet 2. juni 1953. A skete først."},"tl|Dronning Elizabeth II krones (1953) | Sputnik opsendes (1957)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/tv_-_programhistorie","d":"lex.dk","q":"kroningen af Elizabeth 2. i 1953","ok":true},{"u":"https://en.wikipedia.org/wiki/Coronation_of_Elizabeth_II","d":"wikipedia.org","q":"took place on 2 June 1953 at Westminster Abbey","ok":true},{"u":"https://lex.dk/Sputnik","d":"lex.dk","q":"Sputnik 1, der blev opsendt den 4. oktober 1957 fra Bajkonur i Sovjetunionen","ok":true},{"u":"https://en.wikipedia.org/wiki/Sputnik_1","d":"wikipedia.org","q":"It was launched into an elliptical low Earth orbit by the Soviet Union on 4 October 1957","ok":true}],"note":"Kroning 2. juni 1953; Sputnik 4. oktober 1957. A skete først."},"tl|Berlinmuren bygges (1961) | Cubakrisen (1962)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Berlinmuren","d":"lex.dk","q":"blev påbegyndt om natten til den 13. august 1961","ok":true},{"u":"https://en.wikipedia.org/wiki/Berlin_Wall","d":"wikipedia.org","q":"Construction of the Berlin Wall was commenced by the government of the GDR on 13 August 1961.","ok":true},{"u":"https://lex.dk/Cubakrisen","d":"lex.dk","q":"Den 14. oktober 1962 fotograferede et spionfly af denne type (U-2) affyringsramper til atommissiler i Cuba.","ok":true},{"u":"https://en.wikipedia.org/wiki/Cuban_Missile_Crisis","d":"wikipedia.org","q":"The crisis lasted from 16 to 28 October 1962","ok":true}],"note":"Berlinmuren 13. august 1961; Cubakrisen oktober 1962. A skete først."},"tl|Vietnamkrigen eskalerer (Tonkinbugten) (1964) | Månelandingen (1969)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/Vietnamkrigen","d":"lex.dk","q":"1964 Begivenheder i Tonkin-bugten i august bliver anledning til amerikanske bombninger og militær optrapning.","ok":true},{"u":"https://en.wikipedia.org/wiki/Gulf_of_Tonkin_incident","d":"wikipedia.org","q":"1964 naval confrontation between North Vietnam and the United States","ok":true},{"u":"https://lex.dk/Apollo_11","d":"lex.dk","q":"Ørnene landede kl. 20:17 den 20. juli 1969 med blot styrebrændstof til 20-50 sekunder tilbage.","ok":true},{"u":"https://www.nasa.gov/mission/apollo-11/","d":"nasa.gov","q":"July 20, 1969: One Giant Leap For Mankind","ok":true}],"note":"Tonkinbugt-hændelserne og optrapningen skete i 1964; Apollo 11 landede 20. juli 1969."},"tl|John Lennon skydes (1980) | Første IBM-pc (1981)":{"pool":"tl","status":"bekræftet","date":"2026-11-08","sources":[{"u":"https://lex.dk/John_Lennon","d":"lex.dk","q":"Han blev myrdet i 1980.","ok":true},{"u":"https://en.wikipedia.org/wiki/Assassination_of_John_Lennon","d":"wikipedia.org","q":"On the night of 8 December 1980, English musician John Lennon, formerly of the Beatles, was fatally shot","ok":true},{"u":"https://lex.dk/pc_-_personlig_computer","d":"lex.dk","q":"Den dengang ubestridt største computerproducent, IBM, introducerede i 1981 sin personlige computer IBM PC.","ok":true},{"u":"https://da.wikipedia.org/wiki/IBM_PC","d":"wikipedia.org","q":"den første blev lanceret 12. august 1981.","ok":true}],"note":"Lennon blev skudt 8. december 1980; IBM 
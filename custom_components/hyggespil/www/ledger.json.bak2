ue,"sources":[{"u":"https://en.wikipedia.org/wiki/Cattle","d":"wikipedia.org","q":"For mother cows to continue producing milk, they give birth to one calf per year.","ok":true},{"u":"https://animaldiversity.org/accounts/Bos_taurus/","d":"animaldiversity.org","q":"One calf is born after approximately nine months of gestation.","ok":true}]},"kest|Hvor mange horn har en gede?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Goat","d":"wikipedia.org","q":"Most goats naturally have two horns , their shape and size depending on the breed.","ok":true},{"u":"https://animaldiversity.org/accounts/Capra_hircus/","d":"animaldiversity.org","q":"The horns are hollow, and grow either scimitar or corkscrew.","ok":true}]},"kest|Hvor mange tænder har en kamel?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://animaldiversity.org/accounts/Camelus_dromedarius/","d":"animaldiversity.org","q":"Dromedary camels have a total of 34 teeth, with a dental formula of 1/3; 1/1; 3/2; 3/3.","ok":true},{"u":"https://en.wikipedia.org/wiki/Dromedary_camel","d":"wikipedia.org","q":"The dromedary has 22 milk teeth , which are eventually replaced by 34 permanent teeth .","ok":true}]},"kest|Hvor mange tæer har en skildpadde på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Turtle","d":"wikipedia.org","q":"The limbs of turtles are adapted for various means of locomotion and habits and most have five toes.","ok":true},{"u":"https://animaldiversity.org/accounts/Trachemys_scripta/","d":"animaldiversity.org","q":"They have webbed feet for swimming with five digits on each limb.","ok":true}]},"kest|Hvor mange tæer har en gris på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Pig","d":"wikipedia.org","q":"There are four hoofed toes on each foot; the two larger central toes bear most of the weight, while the outer two are also used in soft ground.","ok":true},{"u":"https://lex.dk/svinefamilien","d":"lex.dk","q":"På hver fod har svin fire tæer, som er beklædt med klove.","ok":true}]},"kest|Hvor mange tæer har en ræv på hver bagpote?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Red_fox","d":"wikipedia.org","q":"The forepaws have five digits, while the hind feet have only four and lack dewclaws .","ok":true},{"u":"https://animaldiversity.org/accounts/Vulpes_vulpes/","d":"animaldiversity.org","q":"The manus has 5 claws and the pes 4 claws.","ok":true}]},"kest|Hvor mange tæer har en meerkat på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Meerkat","d":"wikipedia.org","q":"[ 3 ] Digitigrade , the meerkat has four digits on each foot with thick pads underneath.","ok":true},{"u":"https://animaldiversity.org/accounts/Suricata_suricatta/","d":"animaldiversity.org","q":"Meerkats have 4 long, curved claws on each foot.","ok":true}]},"kest|Hvor mange tæer har en myrdyr på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Giant_anteater","d":"wikipedia.org","q":"[ 23 ] The giant anteater has broad ribs and five toes on each foot.","ok":true},{"u":"https://animaldiversity.org/accounts/Myrmecophaga_tridactyla/","d":"animaldiversity.org","q":"Their hindfeet have 5 short claws, while their forefeet have 5 claws with the inner 3 being very long and sharp.","ok":true}]},"kest|Hvor mange led består et edderkopben af?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Spider","d":"wikipedia.org","q":"8-claws Each of the eight legs of a spider consists of seven distinct parts.","ok":true},{"u":"https://animaldiversity.org/accounts/Araneus_diadematus/","d":"animaldiversity.org","q":"Each leg has seven segments: a coxa and a trochanter, which are both short;","ok":true}]},"kest|Hvor mange tæer har en lemur på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Lemur","d":"wikipedia.org","q":"Like all primates, lemurs have five divergent digits with nails (in most cases) on their hands and feet.","ok":true},{"u":"https://animaldiversity.org/accounts/Lemur_catta/","d":"animaldiversity.org","q":"Ring-Tailed Lemurs have four thin fingers and a thumb on their upper and lower appendages, each ending in a dark colored nail.","ok":true}]},"kest|Hvor mange fingre har en flagermus på hver hånd?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bat","d":"wikipedia.org","q":"Bats have five elongated digits, which all radiate around the wrist.","ok":true},{"u":"https://animaldiversity.org/accounts/Myotis_lucifugus/","d":"animaldiversity.org","q":"The fore and hind limbs have five metapodials.","ok":true}]},"kest|Hvor mange tæer har et pindsvin på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://animaldiversity.org/accounts/Erinaceus_europaeus/","d":"animaldiversity.org","q":"It is plantigrade and has 5 well developed pads and claws on each foot. The first and fifth toes are smaller and weaker than the second, third, and fourth toes.","ok":true},{"u":"https://lex.dk/pindsvin","d":"lex.dk","q":"at de træder på hele fodfladen), og de fleste arter har fem tæer på fødderne.","ok":true}]},"kest|Hvor mange tæer har en skunk på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Skunk","d":"wikipedia.org","q":"[ 8 ] They have moderately elongated bodies, short, muscular legs and five toes on each foot.","ok":true},{"u":"https://animaldiversity.org/accounts/Mephitis_mephitis/","d":"animaldiversity.org","q":"Their legs are stout, with five-toed plantigrade feet and long foreclaws for digging.","ok":true}]},"kest|Hvor mange tæer har en vaskebjørn på hver fod?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Raccoon","d":"wikipedia.org","q":"[ 116 ] [ 117 ] The five digits of the paws have no webbing between them, which is unusual for a carnivoran .","ok":true},{"u":"https://animaldiversity.org/accounts/Procyon_lotor/","d":"animaldiversity.org","q":"Both their forepaws and hindpaws have five toes.","ok":true}]},"kest|Hvor mange spener har en hun-pungrotte?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Virginia_opossum","d":"wikipedia.org","q":"Opossums have 13 nipples , arranged in a circle of 12 with one in the middle.","ok":true},{"u":"https://animaldiversity.org/accounts/Didelphis_virginiana/","d":"animaldiversity.org","q":"After an extremely short gestation period of 12 to 13 days, 4 to 25 altricial \"honey bee-sized\" young are born, although females generally have only 13 mammae, some of wh","ok":true}]},"kest|Hvor mange fjer har en rød junglehane på halen?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Gallus_gallus","d":"wikipedia.org","q":"The tail consists of 14 iridescent feathers that shimmer with blue, purple, and green in direct light.","ok":true},{"u":"https://animaldiversity.org/accounts/Gallus_gallus/","d":"animaldiversity.org","q":"They have a total of fourteen tail feathers.","ok":true}]},"kest|Hvor mange kløer har en muldvarp på hver forpotte?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://animaldiversity.org/accounts/Talpa_europaea/","d":"animaldiversity.org","q":"The front feet have 5 strong claws and are permanently turned outward.","ok":true},{"u":"https://en.wikipedia.org/wiki/Talpidae","d":"wikipedia.org","q":"Both sexes have claws on all five fingers and on all five toes.","ok":true}]},"kest|Hvor mange tæer har en treslang på hver bagben?":{"pool":"kest","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bradypus","d":"wikipedia.org","q":"All sloths have three digits on their hindlimbs ;","ok":true},{"u":"https://animaldiversity.org/accounts/Bradypus_variegatus/","d":"animaldiversity.org","q":"They have long forelimbs with three clawed-toes on each limb.","ok":true}]},"kwho|{\"a\":\"Pindsvin\",\"age\":6,\"c\":[\"Jeg har mange pigge på ryggen.\",\"Jeg kan rulle mig sammen til en kugle.\",\"Jeg er mest vågen om natten.\",\"Jeg går i vinterdvale.\",\"Jeg spiser insekter, snegle og regnorme.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-13","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Pindsvin","d":"wikipedia.org","q":"Pindsvinet kan stritte med sine pigge og rulle sig sammen i forsvarsposition, hvor hoved og lemmer skjules.","ok":true},{"u":"https://lex.dk/pindsvin","d":"lex.dk","q":"Pindsvin er rovdyr, der primært æder insekter","ok":true}]},"kwho|{\"a\":\"Papegøje\",\"age\":8,\"c\":[\"Jeg er ofte meget farverig.\",\"Jeg har et stærkt, krumt næb.\",\"Jeg har to tæer, der peger frem, og to, der peger tilbage.\",\"Nogle af mine arter kan efterligne menneskelig tale.\",\"Jeg lever i flokke.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-13","daily":true,"sources":[{"u":"https://lex.dk/papegøjer","d":"lex.dk","q":"Foden, der gerne bruges til manipulation af føden, har to fremadrettede og to bagudrettede tæer.","ok":true},{"u":"https://en.wikipedia.org/wiki/Parrot","d":"wikipedia.org","q":"the ability of some species to imitate human speech","ok":true}]},"kwho|{\"a\":\"Krokodille\",\"age\":8,\"c\":[\"Jeg er et krybdyr, der lever både i vand og på land.\",\"Jeg har et meget stærkt bid.\",\"Jeg lægger æg, som jeg begraver i jorden.\",\"Mine tænder skiftes hele livet.\",\"Jeg bærer mine nyklækkede unger i munden ned til vandet.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-13","daily":true,"sources":[{"u":"https://lex.dk/krokodiller","d":"lex.dk","q":"tænderne sidder i huler i kæberne og skiftes livet igennem","ok":true},{"u":"https://en.wikipedia.org/wiki/Crocodile","d":"wikipedia.org","q":"All crocodiles are semiaquatic","ok":true}]},"kwho|{\"a\":\"Ko\",\"age\":3,\"c\":[\"Jeg siger mu.\",\"Jeg giver mælk.\",\"Jeg spiser græs.\",\"Jeg bor på en gård.\",\"Jeg har fire ben.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ko","d":"wikipedia.org","q":"muh! et muh fra en ko","ok":true},{"u":"https://snl.no/ku","d":"snl.no","q":"ku melkes med melkemaskin","ok":true}]},"kwho|{\"a\":\"Gris\",\"age\":3,\"c\":[\"Jeg siger øf.\",\"Jeg er lyserød og rund.\",\"Jeg elsker mudder.\",\"Jeg spiser næsten alt.\",\"Jeg bor på en gård.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Gris","d":"wikipedia.org","q":"øf! et svinegrynt","ok":true},{"u":"https://snl.no/gris","d":"snl.no","q":"gris, også kalt tamsvin eller bare svin","ok":true}]},"kwho|{\"a\":\"Får\",\"age\":3,\"c\":[\"Jeg har blød, hvid uld.\",\"Jeg siger bæ.\",\"Jeg spiser græs.\",\"Jeg bor på en gård.\",\"Jeg giver uld til tøj.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/F%C3%A5r","d":"wikipedia.org","q":"fåret holdes for dets uld, kød og mælk","ok":true},{"u":"https://snl.no/sau","d":"snl.no","q":"sauen har i tillegg vært viktig både som en kilde til ull","ok":true}]},"kwho|{\"a\":\"Ged\",\"age\":4,\"c\":[\"Jeg har to horn.\",\"Jeg siger mæh.\",\"Jeg kan klatre godt.\",\"Jeg spiser græs og blade.\",\"Jeg bor på en gård.\"]}":{"pool":"kwho","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"ht
"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Dew","d":"wikipedia.org","q":"Dew is water in the form of droplets that appears on thin, exposed objects in the morning or evening due to condensation.","ok":true},{"u":"https://lex.dk/dug","d":"lex.dk","q":"Dug er vanddråber, som er afsat på græs, blade, grene og lignende ved fortætning","ok":true}]},"kodd|{\"o\":[\"Papir\",\"Glas\",\"Jern\",\"Sten\"],\"a\":0,\"age\":7,\"e\":\"Papir laves af træ og planter – de andre laves af sten, sand og metal.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Paper","d":"wikipedia.org","q":"Paper is a thin sheet of matted cellulose fibers. Largely derived from lignocellulose, paper is created from a pulp dissolved into a slurry that is drained and dried into","ok":true},{"u":"https://lex.dk/papir","d":"lex.dk","q":"Det fremstilles af træ eller andet plantemateriale, som først findeles til fibre.","ok":true}]},"kodd|{\"o\":[\"Selleri\",\"Gulerod\",\"Rødbede\",\"Pastinak\"],\"a\":0,\"age\":8,\"e\":\"Selleri er en stængel – de andre er rødder.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Celery","d":"wikipedia.org","q":"stalk celery (Dulce Group), consumed for its fibrous edible stalks","ok":true},{"u":"https://en.wikipedia.org/wiki/Beetroot","d":"wikipedia.org","q":"Beetroot or beet is the taproot portion of a Beta vulgaris subsp. vulgaris plant","ok":true},{"u":"https://en.wikipedia.org/wiki/Parsnip","d":"wikipedia.org","q":"The parsnip is a root vegetable closely related to carrot and parsley","ok":true},{"u":"https://lex.dk/gulerod","d":"lex.dk","q":"Det er en- eller toårige urter med pælerod","ok":true}]},"kodd|{\"o\":[\"Schweiz\",\"Danmark\",\"Sverige\",\"Norge\"],\"a\":0,\"age\":8,\"e\":\"Schweiz' flag er kvadratisk – de andre landes flag er rektangulære.\"}":{"pool":"kodd","status":"bekræfte
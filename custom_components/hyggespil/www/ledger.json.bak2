":"ordtrappe","status":"ikke-faktuel","date":"2026-11-20","sources":[],"daily":true},"harry|Hvor mange milliarder dollars indspillede de otte Harry Potter-film tilsammen verden over?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"with $7.7 billion in worldwide receipts.","ok":true},{"u":"https://variety.com/2020/digital/news/peacock-harry-potter-movies-streaming-free-1234726281/","d":"variety.com","q":"worldwide haul of $7.7 billion","ok":true}],"daily":true},"harry|Hvor blev det meste af Harry Potter-filmserien optaget?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"Leavesden Studios was the main base for filming Harry Potter","ok":true},{"u":"https://www.bbc.com/news/articles/ck8790rrqx57o","d":"bbc.com","q":"All eight films were shot at Warner Bros. Studios Leavesden in Hertfordshire.","ok":true}],"daily":true},"harry|Hvem skrev manuskripterne til alle Harry Potter-filmene undtagen én?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"Steve Kloves wrote the screenplays for all but the fifth film","ok":true},{"u":"https://www.slashfilm.com/514053/harry-potter-screenwriter-rewriting-akira/","d":"slashfilm.com","q":"he wrote all but the fifth film","ok":true}],"daily":true},"harry|Hvem instruerede flest Harry Potter-film?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"David Yates directed four of the films in the series","ok":true},{"u":"https://www.hollywoodreporter.com/movies/movie-news/harry-potter-spinoff-fantastic-beasts-726580/","d":"hollywoodreporter.com","q":"Yates directed four \"Harry Potter\" movies","ok":true}],"daily":true},"harry|Hvorfor stoppede Chris Columbus som instruktør efter den anden Harry Potter-film?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"he did not want to return for Prisoner of Azkaban, claiming he was 'burned out'.","ok":true},{"u":"https://www.telegraph.co.uk/culture/film/3586569/Harry-Potters-biggest-challenge-yet.html","d":"telegraph.co.uk","q":"The original director has resigned claiming to be burnt out.","ok":true}],"daily":true},"harry|Hvad ville Steven Spielberg gøre anderledes med Harry Potter, hvis han havde instrueret den?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"Spielberg wanted to combine the story of the novels and make an animated film","ok":true},{"u":"https://collider.com/steven-spielberg-animated-harry-potter/","d":"collider.com","q":"Let's combine a couple of the books, let's make it animated","ok":true}],"daily":true},"harry|For hvor mange af Harry Potter-bøgerne solgte J.K. Rowling først filmrettighederne til Warner Bros.?":{"pool":"harry","status":"bekræftet","date":"2026-11-20","sources":[{"u":"https://en.wikipedia.org/wiki/Harry_Potter_(film_series)","d":"wikipedia.org","q":"the film rights for the first four Harry Potter books","ok":true},{"u":"https://variety.com/2013/film/news/harry-potter-jk-rowling-warner-bros-chronology-1200609008/","d":"variety.com","q":"a deal for films based on the first four books","ok":true}],"daily":true},"ordkaede|AND dyr":{"pool":"ordkaede","status":"ikke-faktuel","date":"2026-11-20","sources":[],"daily":true},"ordkaede|AGURK mad":{"pool":"ordkaede","status":"ikke-faktuel","date":"2026-11-20","sources":[],"daily":true},"ordkaede|GLAS hjemmet":{"pool":"ordkaede","status":"ikke-faktuel","date":"2026-11-20","sources":[],"daily":true},"ordkaede|HAT tøj":{"pool":"ordkaede","status":"ikke-
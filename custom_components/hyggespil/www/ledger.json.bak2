us":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Bag skyerne er himlen altid _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Når man taler om solen, _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Penge vokser ikke på _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Den, der gemmer til sidst, _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Små ting glæder _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Man skal ikke dømme en bog _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Græsset er altid grønnere _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Ingen nyheder er _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Man skal ikke gøre en myg til _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Alt har en ende, kun _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Man skal ikke kaste perler for _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Man kan ikke lave en omelet uden at slå _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Når man er i Rom, skal man gøre som _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Den, der graver en grav for andre, _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"provw|«Det koster ikke noget at _____»":{"pool":"provw","status":"bekræftet","date":"2026-11-19","sources":[{"u":"https://ordnet.dk/ddo","d":"ordnet.dk","q":"ordlyd kontrolleret i Den Danske Ordbog (80/82) og andre opslag (2/82)","ok":true}]},"ftl_cykel|Hvad skal en cyklist som minimum have på styret under kørslen?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cyklist skal under kørslen have begge fødder på pedalerne og mindst den ene hånd på styret.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"du skal altid have mindst én hånd på styret","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Du skal have begge fødder på pedalerne og mindst én hånd på styret","ok":true}]},"ftl_cykel|Hvor gammel skal den person mindst være, der skal ledsage og have kontrol over et barn under 6 år, som cykler i trafikken?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Barn under 6 år må ikke cykle uden at være under ledsagelse og kontrol af en person, der er fyldt 15 år.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Barn under 6 år må ikke cykle uden at være under ledsagelse og kontrol af en person, der er fyldt 15 år.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/born-pa-cykel/born-pa-cykel-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Et barn under 6 år må kun cykle i trafikken, hvis barnet er sammen med en person, der er mindst 15 år og har kontrol over barnet.","ok":true}]},"ftl_cykel|Hvor lange må genstande, du medfører på cyklen, højst være efter færdselslovens hovedregel?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Ting, du har med på cyklen, må højst være tre meter lange og én meter brede.","ok":true}]},"ftl_cykel|Hvor brede må genstande, du medfører på cyklen, højst være efter færdselslovens hovedregel?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Ting, du har med på cyklen, må højst være tre meter lange og én meter brede.","ok":true}]},"ftl_cykel|Hvad gælder som udgangspunkt, hvis du vil cykle på et fortov eller en gangsti?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Det er forbudt at cykle på fortov eller gangsti","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"må du som udgangspunkt ikke cykle på fortov eller gangsti","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Det er forbudt at cykle på fortovet.","ok":true}]},"ftl_cykel|Hvad gælder for en cykel med tre hjul, fx en ladcykel, når den kører sammen med andre cyklister?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cykel med tre eller flere hjul må dog aldrig føres ved siden af anden cykel.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Cykel med tre eller flere hjul må dog aldrig føres ved siden af anden cykel.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"På ladcykel (og andre trehjulede cykler) må du ikke køre ved siden af andre.","ok":true}]},"ftl_cykel|Hvornår må to cyklister køre ved siden af hinanden?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Hvor der er tilstrækkelig plads hertil, må to cyklister dog køre ved siden af hinanden, hvis dette kan ske uden fare eller unødig ulempe.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Hvor der er tilstrækkelig plads hertil, må to cyklister dog køre ved siden af hinanden, hvis dette kan ske uden fare eller unødig ulempe.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"I må kun køre to og to, hvis det ikke er til gene for andre.","ok":true}]},"ftl_cykel|Hvordan skal en cyklist svinge til venstre i et vejkryds ifølge færdselsloven?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cyklist, der ønsker at svinge til venstre, skal fortsætte gennem krydset til dets modsatte side og må først foretage svingningen, når det kan ske uden ulempe for den øvri","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Cyklist, der ønsker at svinge til venstre, skal fortsætte gennem krydset til dets modsatte side og må først foretage svingningen, når det kan ske uden ulempe for den øvri","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-svinger-du-til-venstre-pa-cykel/","d":"sikkertrafik.dk","q":"Cyklist, der ønsker at svinge til venstre, skal fortsætte gennem krydset til dets modsatte side og må først foretage svingningen, når det kan ske uden ulempe for den øvri","ok":true}]},"ftl_cykel|Hvordan giver en cyklist tegn, når det er nødvendigt at vise, at man standser eller hurtigt nedsætter farten?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Tegnet skal gives ved brug af stoplygte, hvor anbringelse heraf på køretøjet er påbudt eller tilladt, og i øvrigt ved, at en arm rækkes i vejret.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Du skal række armen op, før du stopper, når det er nødvendigt at vise andre, at du stopper.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/haandtegn","d":"cyklistforbundet.dk","q":"Når du svinger, rækker du armen ud i den retning, du svinger i – når du stopper, rækker du armen op.","ok":true}]},"ftl_cykel|Hvordan giver en cyklist tegn, før hun drejer til siden?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Tegnet skal gives ved hjælp af blinklys, hvor anbringelse heraf på køretøjet er påbudt eller tilladt, og i øvrigt ved, at en arm rækkes vandret ud til siden.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Du skal række armen ud, før du svinger.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/haandtegn","d":"cyklistforbundet.dk","q":"Når du svinger, rækker du armen ud i den retning, du svinger i – når du stopper, rækker du armen op.","ok":true}]},"ftl_cykel|Hvilket bremsekrav gælder i dag for en ny almindelig tohjulet cykel?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En cykel skal være forsynet med mindst to uafhængige bremsesystemer, der virker på henholdsvis for- og baghjul.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"den skal være udstyret med mindst 2 uafhængige bremsesystemer","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/udstyrsbekendtgoerelse","d":"cyklistforbundet.dk","q":"Bremser: Cyklen skal være udstyret med to uafhængige bremser: én for, og én bag.","ok":true}]},"ftl_cykel|På hvilken afstand skal cyklens lygter mindst kunne ses tydeligt?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"Lygten skal afgive lys, der er tydelig synligt på mindst 300 meters afstand og er synligt fra siderne.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"Cykellygter skal afgive lys som er tydeligt synligt henholdsvis forfra og bagfra i mindst 300 meters afstand.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/cyklens-udstyr/cyklens-udstyr/","d":"sikkertrafik.dk","q":"Cykellygterne skal kunne ses tydeligt på mindst 300 meters afstand og også være synlige fra siden.","ok":true}]},"ftl_cykel|Hvilken lysfarve skal en cykels forlygte og baglygte have i lygtetændingstiden?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"Ved kørsel i lygtetændingstiden skal en cykel være forsynet med mindst én forlygte, der afgiver hvidt eller gulligt lys, og én baglygte, der afgiver rødt lys.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"Forlygter skal afgive hvidt eller gulligt lys, og baglygter skal afgive rødt lys.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/udstyrsbekendtgoerelse","d":"cyklistforbundet.dk","q":"Baglyset skal være rødt og forlygten skal afgive et hvidt eller gulligt lys","ok":true}]},"ftl_cykel|Hvilket signalapparat skal en cykel være forsynet med?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En cykel skal være forsynet med en klart lydende klokke, som skal være anbragt på styret. Cyklen må ikke være forsynet med andet signalapparat.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/cyklens-udstyr/cyklens-udstyr/","d":"sikkertrafik.dk","q":"Ringeklokken skal sidde på styret, og du må ikke erstatte den med et horn eller andet larmende.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/udstyrsbekendtgoerelse","d":"cyklistforbundet.dk","q":"Ringeklokke: Cyklen skal være forsynet med en ringeklokke, som kan ringe klart og tydeligt.","ok":true}]},"ftl_cykel|Hvad gælder der for promille, når man cykler?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cykel, hestekøretøj eller hest må ikke føres eller forsøges ført af nogen, der af de grunde, der er nævnt i stk. 2, eller som følge af påvirkning af spiritus befinder sig","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Du må gerne cykle, selvom du har drukket alkohol, men du skal kunne styre din cykel på en betryggende måde","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Der er ingen fast promillegrænse på cykel, men du må ikke cykle, hvis du er så beruset, at det ikke er sikkert.","ok":true}]},"ftl_cykel|Hvad gælder for brug af håndholdt mobiltelefon, mens du cykler?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Førere af køretøjer må under kørsel ikke benytte sig af håndholdt teleudstyr og andre håndholdte kommunikationsapparater","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Det er forbudt at bruge håndholdt mobiltelefon, når du cykler.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/boedetakster","d":"cyklistforbundet.dk","q":"Du cykler med håndholdt mobiltelefon","ok":true}]},"ftl_cykel|Færdselsloven forbyder standsning og parkering på fortov. Hvad gælder for cykler?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"1. pkt. gælder ikke cykler og tohjulede knallerter.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Ja - cyklister er undtaget fra reglen om, at man ikke må parkere på fortovet.","ok":true},{"u":"https://www.kk.dk/sites/default/files/2023-08/17.08.23%20-%20svar%20til%20Astrid%20Aller%20%28F%29%20om%20cykelparkering%20p%C3%A5%20vejbanen.pdf","d":"kk.dk","q":"Cykler er yderligere undtaget fra forbud mod at parkere på cykelsti, gangsti og fortov.","ok":true}]},"ftl_cykel|Op til hvilken hastighed må motoren på en almindelig elcykel højst yde hjælp, mens der trædes i pedalerne?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En el-hjælpemotor må kun afgive effekt ved hastigheder på 25 km/t eller derunder.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"Motoren må hjælpe til op til 25 km/t, når der trædes i pedalerne. Derefter skal den slå fra.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/el-cykel/hvad-siger-loven-om-el-cykel/","d":"sikkertrafik.dk","q":"Motoren må hjælpe til op til 25 km/t, når der trædes i pedalerne. Derefter skal den slå fra.","ok":true}]},"ftl_cykel|Hvad er den højeste motoreffekt, en elcykel må have for stadig at være en almindelig cykel?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En el-hjælpemotor må højst have en effekt på 250 W.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"Motorens effekt må højst være 250 watt.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/el-cykel/hvad-siger-loven-om-el-cykel/","d":"sikkertrafik.dk","q":"Motorens effekt må højst være 250 watt.","ok":true}]},"ftl_cykel|Hvor på vejen skal en cyklist som udgangspunkt køre?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cyklist skal altid holde til højre på den vognbane, der er beliggende yderst til højre i færdselsretningen.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Cyklist skal altid holde til højre på den vognbane, der er beliggende yderst til højre i færdselsretningen.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert/","d":"sikkertrafik.dk","q":"Du skal holde så langt til højre som muligt.","ok":true}]},"ftl_cykel|Hvad må en cyklist ikke gøre under kørslen?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cyklist må ikke under kørslen holde fast i andet køretøj eller letbanekøretøj eller i fører af eller passager på andet køretøj eller letbanekøretøj.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/boedetakster","d":"cyklistforbundet.dk","q":"Du holder fast i andet køretøj.","ok":true},{"u":"https://sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler/boder","d":"sikkertrafik.dk","q":"holder fast i et andet køretøj","ok":true}]},"ftl_cykel|Hvor gammel skal føreren af en cykel mindst være, hvis der transporteres børn på cyklen?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"Føreren af cyklen skal være fyldt 15 år, når der transporteres børn på cyklen.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/born-pa-cykel/born-pa-cykel-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Man skal være mindst 15 år for at have børn med på cyklen.","ok":true},{"u":"https://taenk.dk/forbrugerliv/familieliv/boern-med-paa-cyklen-faa-styr-paa-reglerne","d":"taenk.dk","q":"Cykler du med børn, skal du selv være fyldt 15 år.","ok":true}]},"ftl_cykel|Hvor hurtigt må en elcykels gå-assistent højst hjælpe, når der ikke trædes i pedalerne?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En el-cykel kan dog være indrettet med en elektrisk gå-funktion, således at cyklens el-hjælpemotor kan afgive effekt ved hastigheder på 6 km/t eller derunder","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"En elcykel må ikke kunne indstilles til at køre hurtigere end 6 km/t, uden at der trædes i pedalerne.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/el-cykel/hvad-siger-loven-om-el-cykel/","d":"sikkertrafik.dk","q":"En el-cykel må ikke kunne indstilles til at køre hurtigere end 6 km/t, uden at der trædes i pedalerne.","ok":true}]},"ftl_cykel|Hvor lang brugstid skal en batteridrevet cykellygte (der ikke lader op under kørsel) mindst have?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"For en batteridrevet lygte, undtagen lygte, hvor opladningen sker under kørsel, gælder, at den skal have en brugstid på mindst 5 timer.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/guides-og-inspiration/den-store-lygteguide","d":"cyklistforbundet.dk","q":"Batteridrevne lygter skal kunne lyse i mindst 5 timer.","ok":true},{"u":"https://www.cykelexperten.dk/viden/hvornaar-skal-cykellygter-taendes-lygtetid","d":"cykelexperten.dk","q":"En batteridrevet lygte, som ikke lader op under kørsel, skal have brugstid på mindst 5 timer ved konstant brug af lys","ok":true}]},"ftl_cykel|Hvor bred må en almindelig tohjulet cykel højst være?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"En cykel må hverken i belæsset eller ubelæsset stand have en større bredde end 1 m, dog må en cykel med mere end to hjul have en bredde på indtil 1,25 m.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"En cykel med to hjul må højst være 3,5 m lang og 1 m bred, og den skal være udstyret med mindst 2 uafhængige bremsesystemer.","ok":true},{"u":"https://cykelvalget.dk/blog/ladcykel-vs-elcykel","d":"cykelvalget.dk","q":"Højst 1 m. En cykel med mere end to hjul må være op til 1,25 m bred (§ 5).","ok":true}]},"ftl_cykel|Hvor hurtigt skal en blinkende cykellygte mindst blinke?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/182136","d":"retsinformation.dk","q":"For- og baglygte på cykel og påhængs- eller sidevogn hertil kan afgive blinkende lys. Blinkfrekvensen skal være mindst 120 blink pr. minut.","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/guides-og-inspiration/den-store-lygteguide","d":"cyklistforbundet.dk","q":"Hvis en lygte blinker, skal den blinke mindst 120 gange i minuttet.","ok":true},{"u":"https://journals.aau.dk/index.php/td/article/download/6204/5468/19269","d":"journals.aau.dk","q":"For- og/eller baglygte må gerne blinke, hvis der blinkes med mindst 120 blink pr. minut.","ok":true}]},"ftl_cykel|Hvor gammel skal et barn mindst være, før det må cykle uden ledsagelse af en voksen?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Barn under 6 år må ikke cykle uden at være under ledsagelse og kontrol af en person, der er fyldt 15 år.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/born-pa-cykel/born-pa-cykel-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Et barn under 6 år må kun cykle i trafikken, hvis barnet er sammen med en person, der er mindst 15 år og har kontrol over barnet.","ok":true},{"u":"https://cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Barn under 6 år må ikke cykle uden at være under ledsagelse og kontrol af en person, der er fyldt 15 år.","ok":true}]},"ftl_cykel|Hvor lange må genstande, der medføres på en cykel, højst være?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true},{"u":"https://sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert","d":"sikkertrafik.dk","q":"Ting, du har med på cyklen, må højst være tre meter lange og én meter brede.","ok":true},{"u":"https://cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"På cykel må ikke medføres genstande, der er mere end 3 m lange eller 1 m brede.","ok":true}]},"ftl_cykel|Hvor mange må højst køre ved siden af hinanden, hvis der er tilstrækkelig plads?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Hvor der er tilstrækkelig plads hertil, må to cyklister dog køre ved siden af hinanden, hvis dette kan ske uden fare eller unødig ulempe.","ok":true},{"u":"https://sikkertrafik.dk/rad-og-viden/cykel/faerdselsregler-for-cyklister/sadan-cykler-du-lovligt-og-sikkert","d":"sikkertrafik.dk","q":"I må kun køre to og to, hvis det ikke er til gene for andre.","ok":true},{"u":"https://cyklistforbundet.dk/alt-om-cykling/lov-og-regler/faerdselsloven-for-cyklister","d":"cyklistforbundet.dk","q":"Cykel må ikke føres ved siden af andet køretøj. Hvor der er tilstrækkelig plads hertil, må to cyklister dog køre ved siden af hinanden, hvis dette kan ske uden fare eller","ok":true}]},"ftl_cykel|Hvor stor effekt må en elcykels hjælpemotor højst have?":{"pool":"ftl_cykel","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2016/976/dan/pdf","d":"retsinformation.dk","q":"En el-hjælpemotor må højst have en effekt på 250 W.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/cykel/el-cykel/hvad-siger-loven-om-el-cykel/","d":"sikkertrafik.dk","q":"Motorens effekt må højst være 250 watt.","ok":true},{"u":"https://fstyr.dk/privat/krav-til-koeretoejer/cykler","d":"fstyr.dk","q":"Motorens effekt må højst være 250 watt.","ok":true}]},"ftl_bil|Hvad er den generelle hastighedsgrænse for en personbil på motorvej, hvis der ikke er skiltet med en anden hastighed?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På motorveje må hastigheden ikke overstige 130 km i timen.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/fart/fartgraenser/","d":"sikkertrafik.dk","q":"Byzone: 50 km/t Landeveje: 80 km/t Motortrafikveje: 80 km/t (kan være sat op til 90 km/t nogle steder) Motorveje: 130 km/t","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Faerdselsloven-og-fartgraenser","d":"borger.dk","q":"50 km/t i tættere bebygget område 80 km/t uden for tættere bebygget område 130 km/t på motorvej.","ok":true}]},"ftl_bil|Hvad er den generelle hastighedsgrænse for en personbil i tættere bebygget område (byzone), hvis der ikke er skiltet med en anden hastighed?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På andre veje end motorveje og motortrafikveje må køretøjers hastighed ikke overstige følgende grænser: 1) i tættere bebygget område: 50 km i timen, 2) uden for tættere b","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/fart/fartgraenser/","d":"sikkertrafik.dk","q":"Byzone: 50 km/t Landeveje: 80 km/t Motortrafikveje: 80 km/t (kan være sat op til 90 km/t nogle steder) Motorveje: 130 km/t","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Faerdselsloven-og-fartgraenser","d":"borger.dk","q":"50 km/t i tættere bebygget område 80 km/t uden for tættere bebygget område 130 km/t på motorvej.","ok":true}]},"ftl_bil|Hvad er den generelle hastighedsgrænse for en personbil uden for tættere bebygget område (fx på en almindelig landevej), hvis der ikke er skiltet med en anden hastighed?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På andre veje end motorveje og motortrafikveje må køretøjers hastighed ikke overstige følgende grænser: 1) i tættere bebygget område: 50 km i timen, 2) uden for tættere b","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/fart/fartgraenser/","d":"sikkertrafik.dk","q":"Byzone: 50 km/t Landeveje: 80 km/t Motortrafikveje: 80 km/t (kan være sat op til 90 km/t nogle steder) Motorveje: 130 km/t","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Faerdselsloven-og-fartgraenser","d":"borger.dk","q":"50 km/t i tættere bebygget område 80 km/t uden for tættere bebygget område 130 km/t på motorvej.","ok":true}]},"ftl_bil|En personbil (tilladt totalvægt højst 3.500 kg) kører på motorvej med en campingvogn uden særlig Tempo 100-godkendelse. Hvad er den højeste tilladte hastighed, medmindre der er skiltet lavere?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For biler med en tilladt totalvægt på ikke over 3.500 kg må hastigheden uanset § 42 ikke overstige 80 km i timen, hvis der er tilkoblet påhængsvogn","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/trailer/fartgraenser-med-trailer/","d":"sikkertrafik.dk","q":"Motorvej - Maks. 80 km/t (medmindre der skiltes lavere).","ok":true},{"u":"https://fdm.dk/guides/regler/fartgraenser-bil","d":"fdm.dk","q":"Det er muligt at få Tempo 100-godkendelse i Danmark, og med denne godkendelse må du køre 100 km/t. på motorvej.","ok":true}]},"ftl_bil|Hvad er promillegrænsen for en bilist, der har haft kørekort til almindelig bil (kategori B) i mindre end 3 år?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"alkoholkoncentrationen i blodet under eller efter kørslen overstiger 0,20 promille","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/spirituskorsel/0-2-promillegraense-for-nye-bilister/","d":"sikkertrafik.dk","q":"Den gælder de første 3 år, efter man har taget kørekort.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-17-aarige","d":"fstyr.dk","q":"De første tre år, efter du har fået kørekort til bil for første gang, gælder der en promillegrænse på 0,2.","ok":true}]},"ftl_bil|Hvad er den generelle promillegrænse for en bilist, der har haft kørekort til bil i mere end 3 år?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"overstiger 0,50 promille, eller at alkoholkoncentrationen i udåndingsluften under eller efter kørslen overstiger 0,25 mg pr. liter luft","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/spirituskorsel/promillegraenser/","d":"sikkertrafik.dk","q":"I Danmark er den generelle promillegrænse 0,5.","ok":true},{"u":"https://www.dr.dk/nyheder/indland/lav-promillegraense-nye-trafikanter-gaelder-kun-hvis-du-koerer-bil","d":"dr.dk","q":"Efter tre år stiger promillegrænsen til 0,5 som for øvrige bilister.","ok":true}]},"ftl_bil|En 17-årig har fået kørekort til almindelig bil. I hvilket tidsrum skal vedkommende have en ledsager med i bilen, indtil 18-årsdagen?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"betinget af at denne under kørsel i tidsrummet fra kl. 20 til kl. 5 er i følgeskab med en ledsager frem til det fyldte 18. år","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-17-aarige","d":"fstyr.dk","q":"Du skal have ledsager med mellem kl. 20.00 og 05.00.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-bil-som-17-aarig","d":"borger.dk","q":"Skal du køre med en ledsager i bilen mellem kl. 20.00-05.00, indtil du fylder 18 år.","ok":true}]},"ftl_bil|Hvor gammel skal en ledsager til en 17-årig bilfører mindst være?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2025/1151/dan/pdf","d":"retsinformation.dk","q":"skal under kørslen 1) være fyldt 24 år, 2) have haft førerret til kategori B (almindelig bil) i mindst 5 år","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-17-aarige","d":"fstyr.dk","q":"Være mindst 24 år. Have haft gyldigt dansk eller færøsk kørekort i mindst 5 år.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-bil-som-17-aarig","d":"borger.dk","q":"er mindst 24 år gammel.","ok":true}]},"ftl_bil|Hvor i bilen skal ledsageren sidde, når en 17-årig kører bil under ledsagerordningen?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"skal under kørslen sidde på forreste passagersæde","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-17-aarige","d":"fstyr.dk","q":"Sidde foran i bilen og kunne vise sit kørekort.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-bil-som-17-aarig","d":"borger.dk","q":"altid sidder på forreste passagersæde under kørslen.","ok":true}]},"ftl_bil|En 12-årig sidder på bagsædet i en personbil. Hvem har ansvaret for, at barnet bruger sikkerhedssele under kørslen?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Det påhviler føreren at påse, at passagerer, der endnu ikke er fyldt 15 år, anvender sikkerhedsseler","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Når børnene er under 15 år, er det førerens ansvar, at de bruger sikkerhedssele.","ok":true},{"u":"https://fdm.dk/guides/autostole/autostol-regler-lovgivning","d":"fdm.dk","q":"Bilens fører har ansvaret for, at passagerer under 15 år er spændt korrekt fast","ok":true}]},"ftl_bil|Børn skal efter loven sidde i godkendt sikkerhedsudstyr (fx autostol eller selepude) i bilen, indtil de er mindst hvor høje?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"skal børn med en legemshøjde på under 135 cm under kørslen anvende godkendt","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/born-i-bilen/hvad-siger-loven","d":"sikkertrafik.dk","q":"Børn skal sidde i autostol til de er mindst 135 cm høje.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Alle børn under 135 cm skal være spændt fast i godkendt sikkerhedsudstyr, der passer til alder, størrelse og vægt.","ok":true}]},"ftl_bil|Du holder stille i din bil for rødt lys. Må du på det tidspunkt bruge en håndholdt mobiltelefon, fx til at skrive en besked?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Førere af køretøjer må under kørsel ikke benytte sig af håndholdt teleudstyr og andre håndholdte","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/uopmaerksomhed/mobiltelefon-i-bilen-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Forbuddet mod at bruge mobil mv. håndholdt gælder også, når du fx holder for rødt eller holder i kø.","ok":true},{"u":"https://politi.dk/nordjyllands-politi/nyhedsliste/taxichauffoer-doemt-for-mobilbrug-ved-roedt-lys/2025/01/14","d":"politi.dk","q":"Det at holde stille for rødt lys anses for en naturlig del af kørslen, og derfor er det ifølge færdselslovens § 55a, stk. 1 ulovligt, selvom køretøjet ikke er i bevægelse","ok":true}]},"ftl_bil|Hvor tæt på et fodgængerfelt må du som hovedregel ikke standse eller parkere (målt foran feltet i kørselsretningen)?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"på fodgængerfelt eller ud for udkørsel fra cykelsti eller inden for en afstand af 5 m foran","ok":true},{"u":"https://fdm.dk/guides/regler/parkering-paa-offentligt-omraade","d":"fdm.dk","q":"På fodgængerfelt eller mindre end 5 m foran feltet","ok":true},{"u":"https://www.hvidovre.dk/borger/veje-og-trafik/parkering-i-hvidovre-kommune","d":"hvidovre.dk","q":"i fodgængerfelt eller nærmere end 5 meter foran fodgængerfeltet","ok":true}]},"ftl_bil|Hvor tæt på et vejkryds må du som hovedregel ikke standse eller parkere (målt fra den tværgående kørebanes nærmeste kant)?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"i vejkryds eller inden for en afstand af 10 m fra den tværgående kørebanes nærmeste kant","ok":true},{"u":"https://fdm.dk/guides/regler/parkering-paa-offentligt-omraade","d":"fdm.dk","q":"I vejkryds eller mindre end 10 m fra den nærmeste tværgående kørebane eller cykelstis nærmeste kant","ok":true},{"u":"https://www.hvidovre.dk/borger/veje-og-trafik/parkering-i-hvidovre-kommune","d":"hvidovre.dk","q":"i vejkryds eller nærmere end 10 meter fra vejkrydset","ok":true}]},"ftl_bil|Der er ingen gul afmærkning ved et busstoppested. Hvor langt fra stoppestedsskiltet må du ikke standse eller parkere – på hver side af skiltet?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Findes en sådan afmærkning ikke, gælder forbuddet inden for en afstand af 12 m på hver side af skiltet.","ok":true},{"u":"https://fdm.dk/guides/regler/parkering-paa-offentligt-omraade","d":"fdm.dk","q":"På hele den gul-afmærkede strækning ved et busstoppested og 12 m før og efter stoppestedsskiltet, hvis ikke der er gul kantstensafmærkning","ok":true},{"u":"https://www.hvidovre.dk/borger/veje-og-trafik/parkering-i-hvidovre-kommune","d":"hvidovre.dk","q":"ved busstoppested eller nærmere end 12 meter fra stoppestedskiltet","ok":true}]},"ftl_bil|Hvor længe er et nyt kørekort til almindelig bil (kategori B) som udgangspunkt gyldigt?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørekort udstedes med en gyldighedstid på 15 år.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/koerekort/forny-dit-koerekort","d":"borger.dk","q":"Har du førerret til gruppe 1-køretøjer har kategorierne som udgangspunkt en gyldighedstid på 15 år.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/fornyelse-og-erstatning/fornyelse-af-koerekort","d":"fstyr.dk","q":"Fornyelsen af et kørekort for gruppe 1 vil have en gyldighed på maksimalt 15 år.","ok":true}]},"ftl_bil|Hvilken regel står der i selve færdselsloven om afstanden til køretøjet foran?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Afstanden til foran kørende skal afpasses på en sådan måde, at der ikke er fare for påkørsel, hvis køretøjet foran standser, eller dets hastighed nedsættes.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/korekort/klip-i-korekortet/hvad-far-du-klip-for/","d":"sikkertrafik.dk","q":"Der er ikke en fast grænse for, hvor stor afstanden skal være.","ok":true},{"u":"https://fdm.dk/nyheder/nyt-om-trafik-og-biler/2022-11-koerer-du-ogsaa-taet-paa-bilen-foran","d":"fdm.dk","q":"Der er ikke noget lovkrav om, hvor stor afstand der skal være mellem biler.","ok":true}]},"ftl_bil|En voksen passager sidder på bagsædet i en personbil, hvor siddepladsen har sikkerhedssele. Hvad gælder?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Hvis en siddeplads i bil, på motorcykel eller knallert er forsynet med sikkerhedssele, skal denne under kørslen anvendes af den person, der benytter siddepladsen","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Det er lovpligtigt, at alle i bilen bruger sikkerhedssele.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/bilens-udstyr/sikkerhedssele-det-siger-loven","d":"sikkertrafik.dk","q":"Hvis du sidder på et sæde, hvor der er sikkerhedssele, skal du bruge den.","ok":true}]},"ftl_bil|Hvad gælder for antallet af personer i en personbil, hvor alle siddepladser har sikkerhedssele?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Antallet af passagerer, der befordres på forsædet i en bil, må ikke overstige antallet af passagersiddepladser, som er forsynet med sikkerhedsseler.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Der skal være sikkerhedsseler på alle siddepladser i bilen, og det er ulovligt at være flere i bilen, end der er sikkerhedsseler til.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/born-i-bilen/hvad-siger-loven","d":"sikkertrafik.dk","q":"Der må ikke være flere med i bilen, end der er seler til.","ok":true}]},"ftl_bil|I et kryds uden lyssignal, stoplinje eller vigepligtskilt har du et andet køretøj på din højre side. Hvem har vigepligt?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"har føreren af det køretøj, der har det andet køretøj på sin højre side, vigepligt (højrevigepligt)","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/faerdselsregler-for-bilister/hojrevigepligt","d":"sikkertrafik.dk","q":"Det betyder, at du skal holde tilbage for dem, der kommer kørende fra din højre side.","ok":true},{"u":"https://fdm.dk/alt-om-biler/koer-selv-ferie/regler-udlandet/faerdselsregler-tyskland","d":"fdm.dk","q":"I Danmark er der højrevigepligt, med mindre andet er vist ved skiltning eller afmærkning.","ok":true}]},"ftl_bil|Førersædet i en personbil er forsynet med sikkerhedssele. Skal føreren bruge den under kørslen?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Hvis en siddeplads i bil, på motorcykel eller knallert er forsynet med sikkerhedssele, skal denne under kørslen anvendes af den person, der benytter siddepladsen","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/bilens-udstyr/sikkerhedssele-det-siger-loven","d":"sikkertrafik.dk","q":"Hvis du sidder på et sæde, hvor der er sikkerhedssele, skal du bruge den.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Det er lovpligtigt, at alle i bilen bruger sikkerhedssele.","ok":true}]},"ftl_bil|Hvor tæt på en cykelsti, der krydser kørebanen, må du som hovedregel ikke standse eller parkere (på hver side)?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"5 m på hver side af udkørslen fra en cykelsti, som er tværgående i forhold til kørebanen","ok":true},{"u":"https://www.hvidovre.dk/borger/veje-og-trafik/parkering-i-hvidovre-kommune","d":"hvidovre.dk","q":"ud for cykelstiudkørsel eller nærmere end 5 meter foran cykelstiudkørslen","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Parkering","d":"borger.dk","q":"mindre end 5 meter fra en cykelsti, der krydser en","ok":true}]},"ftl_bil|Hvordan skal overhaling som hovedregel foregå?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Overhaling skal ske til venstre.","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/f-andre-trafikanter","d":"sikkertrafik.dk","q":"Hvis du skal overhale nogen, der kører langsomt, skal du som hovedregel køre venstre om, så de er på din højre side.","ok":true},{"u":"https://fdm.dk/nyheder/bilist/2017-05-overhaling-med-motorcykel","d":"fdm.dk","q":"Overhaling skal altid ske længst til venstre","ok":true}]},"ftl_bil|Må du standse eller parkere på en cykelsti?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Standsning eller parkering må ikke ske på cykelsti, gangsti eller fortov.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Parkering","d":"borger.dk","q":"Inden for tættere bebygget område – dvs. inden for byzone skiltene – må du hverken standse eller parkere helt eller delvist på: fortov, cykelsti, gangsti, midterrabat, he","ok":true},{"u":"https://fdm.dk/guides/regler/parkering-paa-offentligt-omraade","d":"fdm.dk","q":"På gangsti, cykelsti, midterrabat, skillerabat, helleanlæg, spærreflader og fortov","ok":true}]},"ftl_bil|Må et barn befordres i en bagudvendende barnestol på forsædet, hvis den forreste airbag er aktiv?":{"pool":"ftl_bil","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Børn må ikke befordres i bil i en bagudvendende barnestol på en passagersiddeplads med frontairbag, medmindre airbaggen er deaktiveret.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/Biler/Sikkerhed-i-bilen","d":"borger.dk","q":"Det er forbudt at placere et barn i en bagudvendende barnestol på forsædet, medmindre den forreste airbag er deaktiveret.","ok":true},{"u":"https://fdm.dk/guides/autostole/autostol-regler-lovgivning","d":"fdm.dk","q":"Det er ikke tilladt at placere en bagudvendt autostol ved en aktiv airbag.","ok":true}]},"cult|{\"id\":\"shiri\",\"t\":\"Shiritori\",\"origin\":\"Japan\",\"tradition\":[\"Shiritori er et japansk ordspil, hvor spillerne skal sige et ord, der begynder med det foregående ords sidste kana (skrifttegn).\",\"Navnet «shiritori» betyder bogstaveligt «at tage enden» eller «at tage bagenden».\",\"Et ord må ikke gentages.\",\"Man må ikke afslutte et ord med lyden ん (n), fordi ingen ord begynder med den.\",\"Man kan gøre spillet sværere med en tidsgrænse, fx 10 sekunder til hver spiller.\"],\"app\":\"Sådan spiller I det i appen: Appen vælger et tilfældigt startbogstav. Den, der er i tur, skriver et ord, der begynder med det forrige ords sidste bogstav. Ord må ikke gentages, og I har 15 sekunder pr. tur. Er ordet ugyldigt, eller kommer det for sent, er man ude. Den sidste, der er i live, vinder og får 3 point.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Shiritori","d":"wikipedia.org","q":"is a Japanese word game in which the players are required to say a word which begins with the final kana of the previous word.","ok":true},{"u":"https://en.wikipedia.org/wiki/Shiritori","d":"wikipedia.org","q":"\"Shiritori\" literally means \"taking the end\" or \"taking the rear\".","ok":true},{"u":"https://www.tofugu.com/japanese/shiritori/","d":"tofugu.com","q":"You can't repeat a word","ok":true},{"u":"https://www.tofugu.com/japanese/shiritori/","d":"tofugu.com","q":"You can't end a word with an ん sound, since no words start with it.","ok":true},{"u":"https://www.tofugu.com/japanese/shiritori/","d":"tofugu.com","q":"Using a timer, where each side only has 10 seconds to come up with their answer","ok":true}]},"cult|{\"id\":\"yut\",\"t\":\"Yut Nori\",\"origin\":\"Korea\",\"tradition\":[\"Yunnori er et traditionelt koreansk brætspil, som især spilles ved koreansk nytår.\",\"I stedet for terninger bruges fire pinde, som kastes.\",\"Kastene har navne: do, gae, geol, yut og mo, og de giver henholdsvis 1, 2, 3, 4 og 5 felter frem.\",\"Slår man yut eller mo, får man et ekstra kast i samme tur.\",\"Brættet er normalt lavet af syet stof og har i alt 29 stationer.\",\"Den første spiller eller det første hold, der kommer hele vejen rundt på brættet og tilbage til hjembasen, vinder.\"],\"app\":\"Sådan spiller I det i appen: Appen kaster de fire pinde for jer. Antal pinde med flad side op giver 1 = do (1 felt), 2 = gae (2), 3 = geol (3), 4 = yut (4 felter og nyt kast) og 0 = mo (5 felter og nyt kast). I løber en forenklet bane på 20 felter, og den første i mål vinder og får 3 point. Det rigtige bræt har flere felter og genveje.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"is a traditional board game played in Korea, especially during Korean New Year.","ok":true},{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"Instead of dice, yut-sticks are used","ok":true},{"u":"https://www.wfblibrary.org/blog/blog-post/yut-nori-korean-board-game","d":"wfblibrary.org","q":"To move your game piece around the board, you gently toss the 4 sticks and let them land on the table.","ok":true},{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"is worth one space advancement, a \"gae\" is worth two space advancement, a \"geol\" is worth 3 space advancement, \"yut\" is worth 4 space advancement, and \"mo\" is worth 5 spa","ok":true},{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"However, a player achieving a yut or mo earns an extra cast for the turn;","ok":true},{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"is normally made of stitched cloth","ok":true},{"u":"https://en.wikipedia.org/wiki/Yunnori","d":"wikipedia.org","q":"This brings the number of stations to twenty-nine in total.","ok":true},{"u":"https://www.wfblibrary.org/blog/blog-post/yut-nori-korean-board-game","d":"wfblibrary.org","q":"Traditionally the game board is made of cloth and is designed to have twenty-nine stations that the players move around.","ok":true},{"u":"https://www.wfblibrary.org/blog/blog-post/yut-nori-korean-board-game","d":"wfblibrary.org","q":"The object of the game is to be the first person or team to move around the game board and return to the home base.","ok":true}]},"cult|{\"id\":\"suit\",\"t\":\"Suit gajah–orang–semut\",\"origin\":\"Indonesien\",\"tradition\":[\"Suit gajah–orang–semut er et indonesisk børnespil for to, der ligner sten-saks-papir.\",\"Elefanten (gajah) slår mennesket (orang), mennesket slår myren (semut), og myren slår elefanten.\",\"Tommelfingeren står for elefanten, pegefingeren for mennesket og lillefingeren for myren.\",\"Viser begge spillere den samme finger, er det uafgjort, og man spiller igen.\",\"Børn bruger ofte spillet til at afgøre, hvem der skal gøre hvad.\"],\"app\":\"Sådan spiller I det i appen: To spillere vælger hver skjult elefant, menneske eller myre. Elefant slår menneske, menneske slår myre, og myre slår elefant. Vinderen af runden får 1 point.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://budaya-indonesia.org/Suit-gajah-orang-semut","d":"budaya-indonesia.org","q":"suit merupakan permainan anak kecil yang dilakukan oleh dua anak. ini seperti permainan suit: gunting, kertas, batu.","ok":true},{"u":"https://www.indoindians.com/9-indonesias-fun-traditional-games-to-explore","d":"indoindians.com","q":"It's Indonesia's fun twist on rock paper scissors.","ok":true},{"u":"https://budaya-indonesia.org/Suit-gajah-orang-semut","d":"budaya-indonesia.org","q":"gajah menang terhadap orang, orang menang terhadap semut, dan semut menang terhadap gajah.","ok":true},{"u":"https://www.indoindians.com/9-indonesias-fun-traditional-games-to-explore","d":"indoindians.com","q":"thumb = gajah (elephant) , index finger = orang (person), pinky = semut (ant).","ok":true},{"u":"https://www.indoindians.com/9-indonesias-fun-traditional-games-to-explore","d":"indoindians.com","q":"If both players show the same finger, it's a tie and you play again.","ok":true},{"u":"https://budaya-indonesia.org/Suit-gajah-orang-semut","d":"budaya-indonesia.org","q":"Biasanya, anak-anak melakukan suit ini jika ingin menentukan siapa yang akan melakukan apa","ok":true}]},"cult|{\"id\":\"lot\",\"t\":\"Lotería\",\"origin\":\"Mexico\",\"tradition\":[\"Lotería stammer fra Italien i 1400-tallet og kom til Ny-Spanien (Mexico) i 1769.\",\"Don Clemente Jacques begyndte at udgive spillet i 1887, og hans billeder er blevet ikoner i mexicansk kultur.\",\"Det klassiske spil består af 54 kort med illustrerede motiver.\",\"Spillet ligner bingo, men bruger billeder af mexicanske genstande og personer i stedet for tal og bogstaver.\",\"Kortene trækkes ét ad gangen, og spillere med billedet på deres bræt dækker det med en bønne eller anden markør; den første, der dækker fire felter på række, vinder.\",\"Kalderen siger typisk en improviseret kort, poetisk eller sjov vending om det kort, der trækkes.\"],\"app\":\"Sådan spiller I det i appen: Appen er kalder og trækker kort fra 52 af de klassiske kort (to kort med navne, som i dag opfattes som stødende, er udeladt). Hver spiller har et bræt på 4×4 kort. Den første med en hel række, kolonne eller diagonal af kaldte kort råber Lotería og får 3 point.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Loter%C3%ADa","d":"wikipedia.org","q":"The game originated in Italy in the 15th century and was brought to New Spain, in 1769.","ok":true},{"u":"https://en.wikipedia.org/wiki/Loter%C3%ADa","d":"wikipedia.org","q":"Don Clemente Jacques began publishing the game in 1887.","ok":true},{"u":"https://en.wikipedia.org/wiki/Loter%C3%ADa","d":"wikipedia.org","q":"The images Don Clemente used in his card designs have become iconic in Mexican culture","ok":true},{"u":"https://peoplesgdarchive.org/item/14009/la-loteria","d":"peoplesgdarchive.org","q":"a random illustrated image is drawn from a special set of 54 cards in Loteria.","ok":true},{"u":"https://peoplesgdarchive.org/item/14009/la-loteria","d":"peoplesgdarchive.org","q":"the announcer says an improvised short poetic or humorous analogy for the card they are announcing.","ok":true},{"u":"https://sites.google.com/csusb.edu/afrolatinizamos/loter%C3%ADa-game","d":"sites.google.com","q":"Lotería is a Mexican game of chance that is similar to bingo, but it uses images of Mexican objects and people rather than numbers and letters.","ok":true},{"u":"https://sites.google.com/csusb.edu/afrolatinizamos/loter%C3%ADa-game","d":"sites.google.com","q":"Cards are drawn from a deck one at a time, and any player with that image on their game board covers it with a token, bean, or other marker. The first person to cover fou","ok":true}]},"cult|{\"id\":\"shagai\",\"t\":\"Shagai\",\"origin\":\"Mongoliet\",\"tradition\":[\"Shagai er ankelknoglen (astragalus) fra et får eller en ged; knoglerne bruges til traditionelle spil og spådom i hele Centralasien.\",\"Når en knogle kastes, lander den normalt på en af fire sider: hest, kamel, får eller ged.\",\"Hest og kamel er de to buede (konvekse) sider og regnes for heldige, hesten mest; får og ged har fordybninger og regnes for uheldige.\",\"Man kan kaste fire shagai som terninger; den bedst mulige kombination hedder durvun berkh, én af hver side.\",\"I et kendt kastespil tager spillerne tur til at kaste fire knogler: fire forskellige sider giver 8 point, fire ens 4 point og to par 2 point.\",\"Hesteløb er et meget almindeligt knoglespil, som spilles af to eller flere: hver spiller flikker sin «hest» af sted forbi en række knogler, som udgør banen.\"],\"app\":\"Foreslået appmekanik: På tur trykker spilleren «Kast», og appen kaster fire knogler; hver knogle lander på hest, kamel, får eller ged (forenklet: lige stor chance for hver side). Point for kastet: fire forskellige sider (durvun berkh) = 8 point, fire ens = 4 point, to par = 2 point, alt andet = 0. Spillerne kaster på skift, og den første, der når 10 point, vinder. Hesteløb og de øvrige knoglespil er ikke med i denne version.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Shagai","d":"wikipedia.org","q":"refers to the astragalus of the ankle of a sheep or goat. The bones are collected and used for traditional games and fortune-telling throughout Central Asia","ok":true},{"u":"https://en.wikipedia.org/wiki/Shagai","d":"wikipedia.org","q":"In shagai dice, the rolled shagai generally land on one of four sides: horse, camel, sheep or goat.","ok":true},{"u":"https://www.rferl.org/a/I_See_Your_Sheep_And_Raise_You_A_Camel/1840910.html","d":"rferl.org","q":"Each side of the bone comes with its own topography and label -- camel, horse, goat, and sheep.","ok":true},{"u":"https://en.wikipedia.org/wiki/Shagai","d":"wikipedia.org","q":"the two convex sides, horse and camel, are considered lucky, with horse being the luckiest. The sides with concave indents, sheep and goat, are deemed unlucky","ok":true},{"u":"https://www.rferl.org/a/I_See_Your_Sheep_And_Raise_You_A_Camel/1840910.html","d":"rferl.org","q":"You can toss four shagai like dice to tell your fortune (the best possible combination being durvun berkh, or one of each).","ok":true},{"u":"https://en.wikipedia.org/wiki/Shagai","d":"wikipedia.org","q":"Players take turns tossing four pieces. All four landing on different sides scores eight points, four sames give four points, and two pairs give two points.","ok":true},{"u":"https://en.wikipedia.org/wiki/Shagai","d":"wikipedia.org","q":"A very common game, usually played with two, but also with more players. Each player flicks one piece (his \"horse\") in turn along a sequence of stationary pieces represen","ok":true}]},"cult|{\"id\":\"inuit\",\"t\":\"Inuit-vinterlege (arktiske idrætsgrene)\",\"origin\":\"Arktis (Alaska til Grønland)\",\"tradition\":[\"Arctic Sports er traditionelle lege, som Inuit fra Alaska til Grønland har dyrket i umindelige tider, og som udviklede balance, smidighed, styrke og smertetolerance.\",\"Knæspring (kneel jump): Man knæler med benene fladt mod gulvet og springer op og frem i én bevægelse og lander på begge fødder samtidig; vinderen er den, der springer længst og viser balance.\",\"Alaskansk højt spark (Alaskan high kick): Fra siddende tager man fat i den modsatte fod med en hånd og sparker til en ophængt bold; kun én hånd rører gulvet, og landingen skal være kontrolleret på sparkefoden.\",\"Enhåndsræk (one-hand reach): Man balancerer på begge hænder, løfter den ene hånd fra gulvet og rører en ophængt bold, og skal derefter sætte hånden i gulvet igen uden at andre kropsdele rører det.\",\"Armtræk (arm pull): På signal trækker to deltagere langsomt og jævnt i hinandens albue, mens den anden hånd støttes mod modstanderens ankel, og målet er at trække modstanderen over eller røre modstanderens hånd til brystet.\",\"Knoglehop (knuckle hop) og ørerul (ear pull) er smertespil: ved knoglehop er det kun knoer og tæer, der rører gulvet, og den, der kommer længst, vinder; ved ørerul trækker to deltagere i hver sin senesløjfe om ørerne.\"],\"app\":\"Foreslået appmekanik (stue-turnering): Appen trækker en disciplin og viser reglerne kort. Spillerne prøver den på skift på et blødt underlag med god plads, og de andre er dommere og kårer vinderen (3 point). Vi bruger knæspring (mål med skridt eller tape), alaskansk højt spark (mål: en let bold, ballon eller rullet sok, som en anden holder i stigende højde), enhåndsræk og armtræk. Knoglehop og ørerul er smertefulde og bruges ikke i stuen – de vises kun som information.\"}":{"pool":"cult","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"Arctic Sports generally refers to a set of traditional games that, since time immemorial, have been part of life for Inuit peoples across a vast area stretching from Alas","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"to develop individual physical abilities—from balance and flexibility, to strength and pain tolerance—that were crucial for collective survival in a challenging natural e","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"The athlete assumes a kneeling position, such that the legs (from knees to toes) lie flat against the floor, with the knees aligned behind a start line. The athlete then ","ok":true},{"u":"https://www.yasc.ca/arctic-sports","d":"yasc.ca","q":"winner is the person that jumps the farthest and shows balance","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"From a sitting position, the athlete uses one hand to grasp the opposite foot, while the other foot and hand remain on the floor. The athlete then thrusts the supporting ","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"The athlete must complete the kick with a controlled landing on the kicking foot.","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"initially using both arms to support and balance their entire body off the floor with one elbow tucked into the body, the athlete lifts one hand off the floor and reaches","ok":true},{"u":"https://www.awg2026.org/arctic-sports","d":"awg2026.org","q":"The athlete must then return their reaching hand to the floor, re-establishing balance on both hands without any other part of their body contacting the floor.","ok":true},{"u":"https://www.yasc.ca/arctic-sports","d":"yasc.ca","q":"On signal, competitors pull slowly and steadily at the elbow while bracing the opposite hand on the opponent's ankle.","ok":true},{"u":"https://www.yasc.ca/arctic-sports","d":"yasc.ca","q":"The goal is to pull the opponent over or touch the opponent's hand to the chest.","ok":true},{"u":"https://www.weio.org/games","d":"weio.org","q":"the only parts of the body touching the floor are knuckles and toes.","ok":true},{"u":"https://www.yasc.ca/arctic-sports","d":"yasc.ca","q":"The athlete who covers the greatest distance wins the round","ok":true},{"u":"https://www.weio.org/games","d":"weio.org","q":"there are two people sitting down facing each other with sinew looped around each other's ear","ok":true}]},"ftl_fod|Du går til fods langs en landevej, hvor der hverken er fortov, gangsti eller egnet rabat. Hvor skal du som udgangspunkt gå?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven","d":"sikkertrafik.dk","q":"Når du går langs en landevej eller andre veje uden fortov eller cykelsti, skal du gå i venstre side, mod trafikken.","ok":true},{"u":"https://www.denoffentlige.dk/lovgivning/der-er-flere-end-du-tror-kender-du-faerdselsreglerne-for-fodgaengere","d":"denoffentlige.dk","q":"skla du for eksempel altid gå i venstre side – altså mod trafikretningen","ok":true}]},"ftl_fod|Du trækker din cykel til fods ad en vej uden fortov og uden egnet rabat. Hvor skal du gå på kørebanen?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven","d":"sikkertrafik.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side.","ok":true},{"u":"https://www.denoffentlige.dk/lovgivning/der-er-flere-end-du-tror-kender-du-faerdselsreglerne-for-fodgaengere","d":"denoffentlige.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side.","ok":true}]},"ftl_fod|Hvad skal gående ifølge færdselsloven som hovedregel færdes på, når det findes?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet rabat.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven","d":"sikkertrafik.dk","q":"Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet rabat.","ok":true},{"u":"https://www.denoffentlige.dk/lovgivning/der-er-flere-end-du-tror-kender-du-faerdselsreglerne-for-fodgaengere","d":"denoffentlige.dk","q":"Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet rabat.","ok":true}]},"ftl_fod|Du står som gående ved et fodgængerfelt med signalanlæg. Hvornår må du gå ud på kørebanen?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På steder, hvor færdslen reguleres af politi eller ved signalanlæg, må kørebane og cykelsti kun betrædes, når signal, der gælder for den gående, viser grønt lys, eller nå","ok":true},{"u":"https://www.kk.dk/borger/parkering-trafik-og-veje/trafik-og-veje/trafiklysene-i-koebenhavn","d":"kk.dk","q":"GRØN figur betyder GÅ Dvs. at du skal se dig for og må derefter forsigtigt gå ud i fodgængerfeltet fra fortovet eller midterhellen.","ok":true},{"u":"https://holbaek.dk/om-kommunen/nyheder-og-presse/nyheder/2021/nov/krydsning-af-fodgaengerfelt","d":"holbaek.dk","q":"Gå ikke ud på fodgængerfeltet, før der er grønt for fodgængere","ok":true}]},"ftl_fod|Du er på vej over et signalreguleret fodgængerfelt, og fodgængersignalet skifter til rødt, før du er nået over. Hvad gør du?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående, der vil passere kørebane eller cykelsti, skal, når kørebanen eller cykelstien betrædes, udvise den forsigtighed, der er nødvendig under hensyn til afstanden til o","ok":true},{"u":"https://www.kk.dk/borger/parkering-trafik-og-veje/trafik-og-veje/trafiklysene-i-koebenhavn","d":"kk.dk","q":"hvis du er på vej over, når det bliver rødt, skal du blot fortsætte i roligt tempo ud til midterhellen eller over til næste fortov","ok":true},{"u":"https://holbaek.dk/om-kommunen/nyheder-og-presse/nyheder/2021/nov/krydsning-af-fodgaengerfelt","d":"holbaek.dk","q":"Hvis der bliver rødt, imens du er ved at krydse fodgængerfeltet, skal du fortsætte i dit normale tempo, og færdiggøre krydsningen over fodgængerfeltet","ok":true}]},"ftl_fod|Hvordan anses en person, der færdes på rulleskøjter eller skateboard (uden motor), i færdselsloven?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Som gående anses også den, der løber på ski, skøj- ter, rulleskøjter, skateboards eller lignende, og den, der fører barnevogn eller legevogn.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/pa-lobehjul-rulleskojter-og-skateboard","d":"sikkertrafik.dk","q":"Når du kører på løbehjul, rulleskøjter, eller skateboard (ikke el) skal du følge samme regler som fodgængere.","ok":true},{"u":"https://www.folketingstidende.dk/samling/20171/lovforslag/L28/20171_L28_fremsaettelsestale.pdf","d":"folketingstidende.dk","q":"Samtidig fastsætter lovforslaget, at skateboardførere skal betragtes som gående.","ok":true}]},"ftl_fod|Standsning og parkering er forbudt på et fodgængerfelt og inden for en bestemt afstand foran feltet. Hvor stor er afstanden?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"på fodgængerfelt eller ud for udkørsel fra cykelsti eller inden for en afstand af 5 m foran fodgængerfel- tet eller udkørslen fra en cykelsti, som løber langs kørebanen","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Standsning eller parkering må ikke ske på fodgængerfelt eller inden for en afstand af 5 m foran fodgængerfeltet.","ok":true},{"u":"https://dku.dk/alment-stof","d":"dku.dk","q":"På fodgængerfelt, eller inden for en afstand af 5 m. inden feltet","ok":true}]},"ftl_fod|Hvornår må en bilist, der nærmer sig et fodgængerfelt, ikke overhale eller køre forbi et andet køretøj?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som nærmer sig et fodgængerfelt, må ikke foretage overhaling eller forbikørsel af et andet køretøj, så- fremt dette køretøj hindrer fuldt udsyn over fodgængerfel","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Kørende, som nærmer sig et fodgængerfelt, må ikke foretage overhaling eller forbikørsel af et andet køretøj, såfremt dette køretøj hindrer fuldt udsyn over fodgængerfelte","ok":true},{"u":"https://dku.dk/alment-stof","d":"dku.dk","q":"Foran eller på fodgængerfelt, medmindre man har fuldt udsyn over feltet","ok":true}]},"ftl_fod|En bilist nærmer sig et fodgængerfelt uden signalanlæg, og en gående er på vej ud i feltet. Hvad skal bilisten gøre?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://dku.dk/alment-stof","d":"dku.dk","q":"Kørende har pligt til at holde tilbage for gående der befinder sig i, eller er på vej ud i et fodgængerfelt.","ok":true}]},"ftl_fod|En bilist har grønt lys ved et signalreguleret fodgængerfelt, men en gående er stadig på vej over kørebanen i feltet. Hvad gælder?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Ved fodgængerfelt på steder, hvor færdslen regule- res af politi eller ved signalanlæg, skal den kørende, selv om han i øvrigt ifølge signalet eller politiets tegngivning","ok":true},{"u":"https://e-teori.dk/f%C3%A6rdselsregler/vigepligt","d":"e-teori.dk","q":"Ved fodgængerfelt på steder, hvor trafikken reguleres af politi eller signalanlæg, skal føreren, selvom han eller hun kan passere fodgængerfeltet i henhold til signalet e","ok":true},{"u":"https://www.teoriklar.dk/546/vigepligt","d":"teoriklar.dk","q":"Ved et signalreguleret fodgængerfelt skal du holde tilbage for gående, der befinder sig i feltet.","ok":true}]},"ftl_fod|En bilist skal køre ud fra en ejendoms udkørsel og over fortovet. Hvad gælder over for gående på fortovet?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som kører over fortov eller gangsti, eller i øvrigt fører køretøj ind på kørebanen fra udkørsel fra ejen- dom ved vejen, skal holde tilbage for gående.","ok":true},{"u":"https://e-teori.dk/f%C3%A6rdselsregler/vigepligt","d":"e-teori.dk","q":"Førere, der kører over fortov eller gangsti, eller som fører et køretøj ind på kørebanen fra en udkørsel fra ejendom ved vejen, skal holde tilbage for gående.","ok":true},{"u":"https://www.teoriklar.dk/546/vigepligt","d":"teoriklar.dk","q":"Kører du over fortov eller gangsti eller ud fra en ejendom ved vejen, skal du holde tilbage for gående.","ok":true}]},"ftl_fod|Hvad skal en bilist, der har lov til at køre i en gågade, udvise over for gående?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Ved kørsel på gågade skal de kørende udvise særlig agtpågivenhed og hensynsfuldhed over for gående.","ok":true},{"u":"https://www.teoriklar.dk/546/vigepligt","d":"teoriklar.dk","q":"På gågade skal du udvise særlig agtpågivenhed og hensynsfuldhed over for gående.","ok":true},{"u":"https://e-teori.dk/f%C3%A6rdselsregler/vigepligt","d":"e-teori.dk","q":"Når der køres på gågade, skal de kørende udvise særlig opmærksomhed og hensyn til de gående.","ok":true}]},"ftl_fod|En bilist møder eller kører forbi en gående på en vej uden fortov. Hvad skal bilisten give den gående?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som møder eller kører forbi gående, skal give den gående tid til at vige til side samt i øvrigt give den gående fornøden plads på vejen.","ok":true},{"u":"https://e-teori.dk/f%C3%A6rdselsregler/vigepligt","d":"e-teori.dk","q":"Førere, der møder eller kører forbi gående, skal give den gående tid til at vige til side og give den gående tilstrækkelig plads på vejen.","ok":true},{"u":"https://www.teoriklar.dk/546/vigepligt","d":"teoriklar.dk","q":"Når du møder eller kører forbi gående, skal du give dem tid og plads til at færdes sikkert.","ok":true}]},"ftl_fod|Hvad forstås i færdselsloven ved et fodgængerfelt?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Fodgængerfelt: den del af vejen, som er bestemt for gående ved passage over kørebane eller cykelsti, og som er særligt afmærket.","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Ved et fodgængerfelt forstås ifølge den danske færdselslov den del af vejen, som er bestemt for gående ved passage over kørebane eller cykelsti, og som er særlig afmærket","ok":true},{"u":"https://vejnettet.dk/sites/default/files/fodgaengerfelter.pdf","d":"vejnettet.dk","q":"Det angiver den del af vejen, som er bestemt for gående ved passage over kørebane eller cykelsti.","ok":true}]},"ftl_fod|Du kører på en cykelsti og nærmer dig et busstoppested ved cykelstiens kant, hvor passagererne stiger af og på uden et særligt indrettet areal. Hvad skal du gøre?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Ved busstoppested eller letbanestoppested, belig- gende ved kanten af cykelsti, hvor passagererne ikke opta- ges fra eller afsættes på et areal, der er særligt indrettet ","ok":true},{"u":"https://e-teori.dk/f%C3%A6rdselsregler/vigepligt","d":"e-teori.dk","q":"skal de kørende på cykelstien holde tilbage og, om nødvendigt, standse for passagerer, der stiger af eller på","ok":true},{"u":"https://www.teoriklar.dk/546/vigepligt","d":"teoriklar.dk","q":"Ved bus- eller letbanestoppested ved kanten af en cykelsti skal cyklister og knallertkørere på cykelstien holde tilbage og om nødvendigt standse for passagerer, der stige","ok":true}]},"ftl_fod|En invalid, der selv fører en kørestol med almindelig ganghastighed, anses i færdselsloven som...":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Invalid, der selv fører kørestol, må, hvis der køres med almindelig ganghastighed, benytte fortov, gangsti eller rabat samt fodgængerfelt og anses i så fald som gående.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/motordrevne-koerestole","d":"fstyr.dk","q":"Bliver kørestolen ført af den handicappede ved almindelig ganghastighed, bliver kørestolen anset som en gående.","ok":true},{"u":"https://www.borger.dk/handicap/Hjaelp-i-hverdagen/Transport-for-personer-med-handicap","d":"borger.dk","q":"Som almindelig kørestolsbruger betragtes du i færdselsloven som gående.","ok":true}]},"ftl_fod|En bilist nærmer sig et fodgængerfelt, der ikke er reguleret af signalanlæg eller politi. Hvad skal bilisten gøre for at undgå fare eller ulempe for gående i feltet?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/f-andre-trafikanter/","d":"sikkertrafik.dk","q":"Når du nærmer dig et fodgængerfelt, skal du køre så langsomt, at du kan standse op, hvis der er fodgængere, der er på vej ud.","ok":true}]},"ftl_fod|Hvor skal en gående som hovedregel færdes, hvis der findes fortov, gangsti eller egnet rabat?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet rabat.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven/","d":"sikkertrafik.dk","q":"§10. Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet r","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/10","d":"jurabibliotek.dk","q":"Gående skal benytte fortov, gangsti eller rabat, dog ikke midterrabat. Cykelsti eller kørebane må kun benyttes, såfremt der ikke findes fortov, gangsti eller egnet rabat.","ok":true}]},"ftl_fod|Hvis en gående er nødt til at gå på kørebanen, hvor skal vedkommende som hovedregel gå?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den gående ka","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Stk. 2. Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den g","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/10","d":"jurabibliotek.dk","q":"Stk 2. Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den gå","ok":true}]},"ftl_fod|Du går til fods på en vej uden fortov og trækker din cykel. Hvor skal du som udgangspunkt gå på kørebanen?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den gående ka","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/fodgaengere-hvad-siger-loven/","d":"sikkertrafik.dk","q":"Stk. 2. Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den g","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/10","d":"jurabibliotek.dk","q":"Stk 2. Gående, som benytter kørebanen, skal gå yderst i venstre side i færdselsretningen eller, hvis vedkommende trækker cykel eller knallert, yderst i højre side. Den gå","ok":true}]},"ftl_fod|Ved passage over kørebanen skal fodgængerfelt benyttes, hvis et sådant findes i nærheden. Hvad gælder, hvis der findes fodgængerbro eller -tunnel i nærheden?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Ved passage over kørebane eller cykelsti skal fodgængerfelt benyttes, såfremt et sådant findes i nærheden. Findes fodgængerbro eller -tunnel i nærheden, skal broen eller ","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Ved passage over kørebane eller cykelsti, skal gående benytte fodgængerfeltet, såfremt et sådant findes i nærheden.","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/10","d":"jurabibliotek.dk","q":"Stk 5. Ved passage over kørebane eller cykelsti skal fodgængerfelt benyttes, såfremt et sådant findes i nærheden. Findes fodgængerbro eller -tunnel i nærheden, skal broen","ok":true}]},"ftl_fod|Hvor færdslen reguleres af signalanlæg, må gående kun betræde kørebanen eller cykelstien, når...?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På steder, hvor færdslen reguleres af politi eller ved signalanlæg, må kørebane og cykelsti kun betrædes, når signal, der gælder for den gående, viser grønt lys, eller nå","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/10","d":"jurabibliotek.dk","q":"Stk 7. På steder, hvor færdslen reguleres af politi eller ved signalanlæg, må kørebane og cykelsti kun betrædes, når signal, der gælder for den gående, viser grønt lys, e","ok":true},{"u":"https://politi.dk/-/media/mediefiler/landsdaekkende-dokumenter/service-og-tilladelser/boeder/bed-om-et-retsmoede/vejledende-boedetakster-ved-overtraedelse-af-faerdselsloven.pdf","d":"politi.dk","q":"FL § 10, stk. 7 Lyssignal ikke respekteret","ok":true}]},"ftl_fod|Hvem anses også som gående ifølge færdselsloven?":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Som gående anses også den, der løber på ski, skøjter, rulleskøjter, skateboards eller lignende, og den, der fører barnevogn eller legevogn. Den, der skubber kørestol, træ","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/til-fods/faerdselsregler-for-fodgaengere/pa-lobehjul-rulleskojter-og-skateboard","d":"sikkertrafik.dk","q":"11. Som gående anses også den, der løber på ski, skøjter, rulleskøjter, skateboards eller lignende, og den, der fører barnevogn eller legevogn. Den, der skubber kørestol,","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/11","d":"jurabibliotek.dk","q":"Som gående anses også den, der løber på ski, skøjter, rulleskøjter, skateboards eller lignende, og den, der fører barnevogn eller legevogn. Den, der skubber kørestol, træ","ok":true}]},"ftl_fod|Kørende, som nærmer sig et fodgængerfelt, må ikke overhale eller forbikøre et andet køretøj, hvis...":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som nærmer sig et fodgængerfelt, må ikke foretage overhaling eller forbikørsel af et andet køretøj, såfremt dette køretøj hindrer fuldt udsyn over fodgængerfelte","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/korekort/klip-i-korekortet/hvad-far-du-klip-for/","d":"sikkertrafik.dk","q":"Når du nærmer dig et fodgængerfelt, må du ikke overhale eller køre forbi et andet køretøj, hvis det forhindrer fuldt udsyn over fodgængerfeltet","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Kørende, som nærmer sig et fodgængerfelt, må ikke foretage overhaling eller forbikørsel af et andet køretøj, såfremt dette køretøj hindrer fuldt udsyn over fodgængerfelte","ok":true}]},"ftl_fod|Ved et busstoppested beliggende ved kanten af en cykelsti, hvor passagererne ikke optages fra eller afsættes på et særligt areal, skal de kørende på cykelstien...":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Ved busstoppested eller letbanestoppested, beliggende ved kanten af cykelsti, hvor passagererne ikke optages fra eller afsættes på et areal, der er særligt indrettet for ","ok":true},{"u":"https://www.cyklistforbundet.dk/alt-om-cykling/lov-og-regler/naar-bussen-holder","d":"cyklistforbundet.dk","q":"Ved busstoppested, beliggende ved kanten af cykelsti, hvor passagererne ikke optages fra eller afsættes på et areal, der er særligt indrettet for dem, skal de kørende på ","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/27","d":"jurabibliotek.dk","q":"Stk 4. Ved busstoppested eller letbanestoppested, beliggende ved kanten af cykelsti, hvor passagererne ikke optages fra eller afsættes på et areal, der er særligt indrett","ok":true}]},"ftl_fod|En invalid, der selv fører kørestol med almindelig ganghastighed, må benytte...":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Invalid, der selv fører kørestol, må, hvis der køres med almindelig ganghastighed, benytte fortov, gangsti eller rabat samt fodgængerfelt og anses i så fald som gående.","ok":true},{"u":"https://www.borger.dk/handicap/Hjaelp-i-hverdagen/Transport-for-personer-med-handicap","d":"borger.dk","q":"Som almindelig kørestolsbruger betragtes du i færdselsloven som gående.","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/13","d":"jurabibliotek.dk","q":"Invalid, der selv fører kørestol, må, hvis der køres med almindelig ganghastighed, benytte fortov, gangsti eller rabat samt fodgængerfelt og anses i så fald som gående.","ok":true}]},"ftl_fod|Kørende, som nærmer sig et ureguleret fodgængerfelt, skal...":{"pool":"ftl_fod","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://www.dr.dk/nyheder/indland/ikke-i-sikkerhed-i-fodgaengerfelter","d":"dr.dk","q":"Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder sig i fel","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/27","d":"jurabibliotek.dk","q":"Stk 7. Kørende, som nærmer sig et fodgængerfelt, der ikke er reguleret, skal afpasse hastigheden således, at der ikke opstår fare eller ulempe for gående, som befinder si","ok":true}]},"ftl_andre|Hvad er den højeste hastighed, en lille knallert lovligt må køre, uanset hvad der er skiltet?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For lille knallert må hastigheden uanset § 42 aldrig overstige 30 km i timen.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/knallerter/lille-knallert/faerdselsregler-for-knallert-30","d":"sikkertrafik.dk","q":"Du må max køre 30 km/t","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-knallert","d":"borger.dk","q":"Du må maksimalt køre 30 km/t på lille knallert.","ok":true},{"u":"https://www.fstyr.dk/privat/syn/spoergsmaal-og-svar","d":"fstyr.dk","q":"En knallert må ikke køre hurtigere end 45 km/t (stor knallert) henholdsvis 30 km/t (lille knallert).","ok":true}]},"ftl_andre|Hvad er den højeste hastighed, en stor knallert lovligt må køre?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For stor knallert må hastigheden uanset § 42 aldrig overstige 45 km i timen.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/knallerter/stor-knallert/faerdselsregler-for-knallert-45","d":"sikkertrafik.dk","q":"Du må max køre 45 km/t","ok":true},{"u":"https://www.kk.dk/borger/borgerservice/koerekort/tag-et-koerekort/tag-koerekort-til-knallert","d":"kk.dk","q":"Stor knallert kan køre 45 km/t, og du skal være 18 år for at køre på den","ok":true},{"u":"https://www.fstyr.dk/privat/syn/spoergsmaal-og-svar","d":"fstyr.dk","q":"En knallert må ikke køre hurtigere end 45 km/t (stor knallert) henholdsvis 30 km/t (lille knallert).","ok":true}]},"ftl_andre|Hvor gammel skal du mindst være for at få udstedt kørekort til lille knallert, når du er under 18 år og tager undervisning og prøver?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørekort til lille knallert kan udstedes til en person, der er fyldt 15 år, og som har modtaget undervisning i færdselsreglerne og kørsel med lille knallert og bestået en","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-knallert","d":"fstyr.dk","q":"Du skal være fyldt 15 år for at få udstedt kørekort til lille knallert.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/knallerter/lille-knallert/faerdselsregler-for-knallert-30","d":"sikkertrafik.dk","q":"Du skal være mindst 15 år og have kørekort","ok":true},{"u":"https://www.esbjerg.dk/personlige-forhold/pas-og-koerekort/koerekort/de-forskellige-kategorier","d":"esbjerg.dk","q":"Du kan få udstedt kørekort til lille knallert, når du er 15 år.","ok":true}]},"ftl_andre|Hvor gammel skal du mindst være for at få kørekort til stor knallert (kategori AM)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/718/pdf","d":"retsinformation.dk","q":"Kørekort til kategori AM kan udstedes til en person, der er fyldt 18 år.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/knallerter/stor-knallert/faerdselsregler-for-knallert-45","d":"sikkertrafik.dk","q":"Du skal være mindst 18 år","ok":true},{"u":"https://www.kk.dk/borger/borgerservice/koerekort/tag-et-koerekort/tag-koerekort-til-knallert","d":"kk.dk","q":"Stor knallert kan køre 45 km/t, og du skal være 18 år for at køre på den","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/koerekortkategorier","d":"fstyr.dk","q":"Stor knallert AM 18 år","ok":true}]},"ftl_andre|Hvor store genstande må du højst medføre på en knallert?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"På knallert må ikke medføres genstande, der er mere end 2 m lange eller 70 cm brede.","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/b-knallertens-udstyr","d":"sikkertrafik.dk","q":"Bagage må max være 2 meter lang og/eller 70 cm bred.","ok":true},{"u":"https://www.fstyr.dk/privat/syn/spoergsmaal-og-svar","d":"fstyr.dk","q":"På knallert må ikke medføres genstande, der over 2 m lange, eller over 70 cm brede.","ok":true}]},"ftl_andre|Hvor hurtigt må en lastbil med en tilladt totalvægt over 3.500 kg højst køre på motorvej?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For andre biler, hvis tilladte totalvægt overstiger 3.500 kg (lastbiler), og for vogntog bestående af en lastbil eller en bus, hvis tilladte totalvægt overstiger 3.500 kg","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/fart/fartgraenser/","d":"sikkertrafik.dk","q":"Lastbil, bus (over 3.500 kg) samt køretøj med anhænger Byzone: 50 km/t Landeveje/motortrafikveje: 80 km/t Motorvej: 80 km/t","ok":true},{"u":"https://www.lastbilteori.dk/553/hastighed","d":"lastbilteori.dk","q":"En lastbil med en tilladt totalvægt over 3.500 kg må aldrig køre hurtigere end 80 km/t, heller ikke på motorvej.","ok":true},{"u":"https://lzk.dk/ordbog/motorvej","d":"lzk.dk","q":"Lastbiler og busser (over 3.500 kg) må aldrig køre mere end 80 km/t","ok":true}]},"ftl_andre|Hvor gammelt skal et barn mindst være for at måtte være passager på en almindelig tohjulet motorcykel (med barnesæde og hjelm, hvis barnet er under 135 cm)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Børn med en legemshøjde på under 135 cm må ikke befordres på tohjulet motorcykel, medmindre barnet er fyldt 5 år og anvender et barnesæde eller andet sikkerhedsudstyr, de","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/motorcykel/faerdselsregler-og-sikkerhed/born-pa-motorcykel","d":"sikkertrafik.dk","q":"Børn under 5 år må ikke transporteres på en almindelig tohjulet motorcykel.","ok":true},{"u":"https://www.mctc.dk/guides/regler/boern-paa-mc","d":"mctc.dk","q":"Hvis et barn er under fem år, må det ikke transporteres på tohjulet motorcykel.","ok":true}]},"ftl_andre|Hvad skal andre trafikanter gøre, når et udrykningskøretøj nærmer sig med de særlige lyd- eller lyssignaler tændt?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"skal andre trafikanter i god tid holde vejen åben for køretøjet. Kørende skal om nødvendigt standse.","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/f-andre-trafikanter","d":"sikkertrafik.dk","q":"Giv plads for udrykningskøretøjer. Træk til højre, eller stop helt op.","ok":true},{"u":"https://lex.dk/udrykning","d":"lex.dk","q":"Ved udrykningskørsel har øvrige trafikanter pligt til at gøre plads til udrykningskøretøjerne","ok":true},{"u":"https://www.denoffentlige.dk/lovgivning/faerdselsloven-er-ikke-til-at-tage-fejl-af-mange-bilister-venter-for-laenge-med-at-danne-redningsvej","d":"denoffentlige.dk","q":"i god tid holde vejen åben for køretøjet","ok":true}]},"ftl_andre|Hvor gammel skal du som udgangspunkt være for at få kørekort til stor motorcykel (kategori A)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/718/pdf","d":"retsinformation.dk","q":"Kørekort til kategori A kan udstedes til en person, der er fyldt 24 år, jf. dog stk. 2-5","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/motorcykel/faerdselsregler-og-sikkerhed/korekort-til-motorcykel/","d":"sikkertrafik.dk","q":"Kørekort til stor motorcykel kan som udgangspunkt erhverves, når du fylder 24 år.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/koerekortkategorier","d":"fstyr.dk","q":"Stor motorcykel A 24 år","ok":true}]},"ftl_andre|Hvor gammel skal du mindst være for at få kørekort til lille motorcykel (kategori A1)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/718/pdf","d":"retsinformation.dk","q":"Kørekort til kategori A1 kan udstedes til en person, der er fyldt 18 år.","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/motorcykel/faerdselsregler-og-sikkerhed/korekort-til-motorcykel/","d":"sikkertrafik.dk","q":"Hvis du er 18 år og ønsker at tage motorcykelkørekort, kan du tage A1-kørekort til lille motorcykel.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/koerekortkategorier","d":"fstyr.dk","q":"Lille motorcykel A1 18 år","ok":true}]},"ftl_andre|Hvor gammel skal du som udgangspunkt være for at få kørekort til mellemstor motorcykel (kategori A2)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/718/pdf","d":"retsinformation.dk","q":"Kørekort til kategori A2 kan udstedes til en person, der er fyldt 20 år, jf. dog stk. 2 og 3","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/motorcykel/faerdselsregler-og-sikkerhed/korekort-til-motorcykel/","d":"sikkertrafik.dk","q":"Du kan som udgangspunkt tage A2-kørekort, når du er fyldt 20 år.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/koerekortkategorier","d":"fstyr.dk","q":"Mellem motorcykel A2 20 år","ok":true}]},"ftl_andre|Hvor gammel skal du mindst være for at få kørekort til traktor og motorredskab (kategori TM)?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørekortet kan udstedes til personer, der er fyldt 16 år.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-traktor","d":"fstyr.dk","q":"Du skal være 16 år for at få kørekort til traktor og motorredskab.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-traktor","q":"Du skal være 16 år for at tage kørekort til traktor/motorredskab, kategori TM.","ok":true},{"u":"https://www.esbjerg.dk/personlige-forhold/pas-og-koerekort/koerekort/de-forskellige-kategorier","d":"esbjerg.dk","q":"Når du fylder 16 år, kan du få kørekort til traktor/motorredskab.","ok":true}]},"ftl_andre|Hvad kræver færdselsloven af føreren af en knallert med hensyn til hjelm under kørslen?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Føreren af motorcykel, bil på tre hjul, bil på fire hjul, hvis den firehjulede bils masse i køreklar stand ikke overstiger henholdsvis 450 kg til personbefordring og 600 ","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/b-knallertens-udstyr","d":"sikkertrafik.dk","q":"Du skal køre med godkendt styrthjelm. Hjelmen skal være spændt fast, så den ikke kan falde af.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-knallert","d":"borger.dk","q":"Husk hjelmen.","ok":true}]},"ftl_andre|Hvilken prøve skal du som udgangspunkt bestå for at få kørekort til lille knallert, når du er fyldt 18 år og ikke har andet kørekort?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Kørekort til lille knallert kan tillige udstedes til en person, der er fyldt 18 år, og som har bestået en teoriprøve.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-knallert","d":"borger.dk","q":"Tager du kørekort til lille knallert, når du er 18 år eller mere, er det eneste krav, at du skal bestå en teoriprøve hos Færdselsstyrelsen.","ok":true},{"u":"https://www.fstyr.dk/privat/koerekort/dit-foerste-koerekort/koerekort-til-knallert","d":"fstyr.dk","q":"Hvis du er fyldt 18 år efter den 19. januar 2013, skal du bestå en teoriprøve for at få kørekort til lille knallert.","ok":true}]},"ftl_andre|Hvor mange personer må der befordres på en almindelig tohjulet knallert?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://www.retsinformation.dk/api/pdf/254826","d":"retsinformation.dk","q":"På tohjulet knallert må ikke befordres andre personer end føreren.","ok":true},{"u":"https://www.sikkertrafik.dk/knallert/a-risiko-konsekvens","d":"sikkertrafik.dk","q":"Der må kun være én person på en knallert. Du må altså ikke have en passager bagpå.","ok":true},{"u":"https://www.borger.dk/transport-trafik-rejser/Biler-og-koerekort/koerekort/typer-af-koerekort/koerekort-til-knallert","d":"borger.dk","q":"Der må kun være én person på knallerten ad gangen.","ok":true}]},"ftl_andre|Hvordan skal en passager på et motorcykels bagsæde sidde?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"En passager på en motorcykels bagsæde skal sidde med et ben på hver side af motorcyklen.","ok":true},{"u":"https://www.fstyr.dk/Media/638942175034714187/Forpr%C3%B8ve%20til%20k%C3%B8rel%C3%A6reruddannelsen%20-%20Kategori%20A%20-%20september%20%202025.pdf","d":"fstyr.dk","q":"Passager på bagsædet skal sidde med et ben på hver side af motorcyklen.","ok":true},{"u":"https://politi.dk/-/media/mediefiler/landsdaekkende-dokumenter/service-og-tilladelser/boeder/bed-om-et-retsmoede/vejledende-boedetakster-ved-overtraedelse-af-faerdselsloven.pdf","d":"politi.dk","q":"Passager ikke et ben på hver side af motorcykel","ok":true}]},"ftl_andre|Hvor gammel skal en passager mindst være for at måtte befordres på en trehjulet knallert uden sikkerhedssele?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Passagerer under 5 år må ikke befordres på tre-\nhjulet knallert, medmindre passagersiddepladsen er forsynet med sikkerhedssele.","ok":true},{"u":"https://www.fstyr.dk/privat/krav-til-koeretoejer/spoergsmaal-og-svar","d":"fstyr.dk","q":"Derudover må passagerer under 5 år ikke befordres på trehjulet knallert, medmindre passagersiddepladsen er forsynet med sikkerhedssele.","ok":true},{"u":"https://carper.dk/love-regler/","d":"carper.dk","q":"§51 stk. 7 passagerer under 5 år må ikke befordres på trehjulet knallert, medmindre passagersiddepladsen er forsynet med sikkerhedssele.","ok":true}]},"ftl_andre|Hvor hurtigt må en traktor, der ikke er registreret i Køretøjsregistret, højst køre?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-14","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For biler og motorcykler, hvortil der er tilkoblet et ikke registreringspligtigt påhængsredskab, og for traktorer og motorredskaber må hastigheden uanset § 42 ikke overst","ok":true},{"u":"https://www.fstyr.dk/nyheder/2025/jun/fra-1-juli-2025-lempes-reglerne-for-tempo-40-koersel-for-traktorer-og-motorredskaber","d":"fstyr.dk","q":"Traktorer og motorredskaber, som er registreret i Køretøjsregistret, er omfattet af hastighedsgrænsen på 40 km i timen.","ok":true},{"u":"https://www.landbrugsinfo.dk/-/media/landbrugsinfo/public/a/b/c/love_regler_traktorer_landbrugsmaskiner_2025.pdf","d":"landbrugsinfo.dk","q":"Traktorer og motorredskaber må køre 40 km/t., hvis de har nummerplade og er registre-\r\nret i Køretøjsregistret. Køretøjer uden num-\r\nmerplade må køre 30 km/t.","ok":true}]},"ftl_andre|Hvor hurtigt må en bus, der opfylder de særlige betingelser for Tempo 100-kørsel, højst køre på motorvej?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For busser, der opfylder betingelserne fastsat efter stk. 10, må hastigheden på motorvej dog ikke overstige 100 km i timen.","ok":true},{"u":"https://www.fstyr.dk/erhverv/syn-og-kontrol/tempo-godkendelser","d":"fstyr.dk","q":"Busser, der opfylder betingelserne i bekendtgørelsen, må køre med op til 100 km i timen på motorveje.","ok":true},{"u":"https://fdm.dk/guides/regler/fartgraenser-bil","d":"fdm.dk","q":"Det er muligt at få Tempo 100-godkendelse i Danmark, og med denne godkendelse må du køre 100 km/t. på motorvej.","ok":true}]},"ftl_andre|Må man føre en hest, hvis man er så påvirket af spiritus, at man ikke kan føre den på betryggende måde?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Cykel, hestekøretøj eller hest må ikke føres eller forsøges ført af nogen, der af de grunde, der er nævnt i stk. 2, eller som følge af påvirkning af spiritus befinder sig","ok":true},{"u":"https://www.sikkertrafik.dk/rad-og-viden/bil/spirituskorsel/promillegraenser/","d":"sikkertrafik.dk","q":"Cykel, hestekøretøj eller hest må ikke føres eller forsøges ført af nogen, der af de grunde, der er nævnt i stk. 2, eller som følge af påvirkning af spiritus befinder sig","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/54","d":"jurabibliotek.dk","q":"Cykel, hestekøretøj eller hest må ikke føres eller forsøges ført af nogen, der af de grunde, der er nævnt i stk. 2","ok":true}]},"ftl_andre|Hvor hurtigt må en traktor, der er registreret i Køretøjsregistret, højst køre?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"For traktorer og motorredskaber, som er registreret i Køretøjsregistret, må hastigheden ikke overstige 40 km i timen.","ok":true},{"u":"https://www.fstyr.dk/nyheder/2025/jun/fra-1-juli-2025-lempes-reglerne-for-tempo-40-koersel-for-traktorer-og-motorredskaber","d":"fstyr.dk","q":"Traktorer og motorredskaber, som er registreret i Køretøjsregistret, er omfattet af hastighedsgrænsen på 40 km i timen.","ok":true},{"u":"https://www.landbrugsinfo.dk/-/media/landbrugsinfo/public/a/b/c/love_regler_traktorer_landbrugsmaskiner_2025.pdf","d":"landbrugsinfo.dk","q":"Traktorer og motorredskaber må køre 40 km/t., hvis de har nummerplade og er registreret i Køretøjsregistret.","ok":true}]},"ftl_andre|Hvor mange ekstra personer må der medbringes i en motorcykels sidevogn ud over det, den er beregnet til?":{"pool":"ftl_andre","status":"bekræftet","date":"2026-11-15","daily":true,"sources":[{"u":"https://www.retsinformation.dk/eli/lta/2026/118/dan/pdf","d":"retsinformation.dk","q":"Dog må der derudover i sidevogn medbringes et barn under 10 år.","ok":true},{"u":"https://www.jurabibliotek.dk/faerdselsloven/paragraf/52","d":"jurabibliotek.dk","q":"Dog må der derudover i sidevogn medbringes et barn under 10 år.","ok":true},{"u":"https://ungtrafik.dk/wp-content/uploads/2022/04/Faerdselsloven.pdf","d":"ungtrafik.dk","q":"På motorcykel og i sidevogn hertil må ikke befordres ﬂere personer, end den er beregnet til. Dog må der derudover i sidevogn medbringes et barn under 10 år.","ok":true}]},"zip|Hvilken by hører postnummer 8370 til?":{"pool":"zip","status":"bekræftet","date":"2026-11-08","daily":true,"sources":[{"u":"https://download.geonames.org/export/zip/DK.zip","d":"geonames.org","q":"8370 Hadsten","ok":true},{"u":"https://da.wikipedia.org/wiki/Postnumre_i_Danmark","d":"wikipedia.org","q":"8370
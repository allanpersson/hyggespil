ue}]},"kodd|{\"o\":[\"Kugle\",\"Trekant\",\"Kvadrat\",\"Cirkel\"],\"a\":0,\"age\":7,\"e\":\"Kuglen er tredimensionel – de andre er flade figurer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Sphere","d":"wikipedia.org","q":"a sphere is the set of points that are all at the same distance","ok":true},{"u":"https://simple.wikipedia.org/wiki/Triangle","d":"simple.wikipedia.org","q":"a triangle is a shape or a part of two dimensional space","ok":true}]},"kodd|{\"o\":[\"Broccoli\",\"Æble\",\"Pære\",\"Banan\"],\"a\":0,\"age\":7,\"e\":\"Broccoli er en grøntsag – de andre er frugter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://simple.wikipedia.org/wiki/Broccoli","d":"simple.wikipedia.org","q":"it is a vegetable similar to cauliflower","ok":true},{"u":"https://en.wikipedia.org/wiki/Apple","d":"wikipedia.org","q":"An apple is the round edible fruit of an apple tree","ok":true}]},"kodd|{\"o\":[\"Reje\",\"Musling\",\"Snegl\",\"Blæksprutte\"],\"a\":0,\"age\":7,\"e\":\"Rejen er et krebsdyr – de andre er bløddyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Shrimp","d":"wikipedia.org","q":"decapod crustaceans","ok":true},{"u":"https://animaldiversity.org/accounts/Mytilus_edulis/","d":"animaldiversity.org","q":"Class Bivalvia","ok":true}]},"kodd|{\"o\":[\"Klaver\",\"Violin\",\"Cello\",\"Kontrabas\"],\"a\":0,\"age\":8,\"e\":\"Klaveret er ikke et strygeinstrument.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Piano","d":"wikipedia.org","q":"a piano is a keyboard instrument that produces sound","ok":true},{"u":"https://simple.wikipedia.org/wiki/Violin","d":"simple.wikipedia.org","q":"the violin is a string instrument which has four strings","ok":true}]},"kodd|{\"o\":[\"Danmark\",\"Europa\",\"Asien\",\"Afrika\"],\"a\":0,\"age\":8,\"e\":\"Danmark er et land – de andre er verdensdele.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Denmark","d":"wikipedia.org","q":"is a Nordic country","ok":true},{"u":"https://simple.wikipedia.org/wiki/Continent","d":"simple.wikipedia.org","q":"a continent is a large area of the land","ok":true}]},"kodd|{\"o\":[\"Salt\",\"Ilt\",\"Brint\",\"Guld\"],\"a\":0,\"age\":8,\"e\":\"Salt er en forbindelse – de andre er grundstoffer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Salt","d":"wikipedia.org","q":"Salt is a mineral composed primarily of sodium chloride","ok":true},{"u":"https://simple.wikipedia.org/wiki/Oxygen","d":"simple.wikipedia.org","q":"Oxygen is a chemical element","ok":true}]},"kodd|{\"o\":[\"Komet\",\"Mars\",\"Venus\",\"Jupiter\"],\"a\":0,\"age\":8,\"e\":\"Kometen er ikke en planet – de andre er planeter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Comet","d":"wikipedia.org","q":"A comet is an icy, small Solar System body","ok":true},{"u":"https://simple.wikipedia.org/wiki/Planet","d":"simple.wikipedia.org","q":"a planet is a large object such as venus","ok":true}]},"kodd|{\"o\":[\"Rødbede\",\"Æble\",\"Pære\",\"Kirsebær\"],\"a\":0,\"age\":8,\"e\":\"Rødbeden er en rodfrugt – de andre er frugter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://simple.wikipedia.org/wiki/Beetroot","d":"simple.wikipedia.org","q":"red beetroot a root vegetable eaten by humans","ok":true},{"u":"https://en.wikipedia.org/wiki/Apple","d":"wikipedia.org","q":"An apple is the round edible fruit of an apple tree","ok":true}]},"kodd|{\"o\":[\"Æg\",\"Yoghurt\",\"Ost\",\"Fløde\"],\"a\":0,\"age\":8,\"e\":\"Ægget er ikke et mejeriprodukt – de andre er.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Egg","d":"wikipedia.org","q":"An egg is an organic vessel","ok":true},{"u":"https://simple.wikipedia.org/wiki/Yogurt","d":"simple.wikipedia.org","q":"is a milk product made by bacterial fermentation","ok":true}]},"kodd|{\"o\":[\"Jordbær\",\"Banan\",\"Tomat\",\"Drue\"],\"a\":0,\"age\":11,\"e\":\"Jordbær er botanisk set en falsk frugt, mens banan, tomat og drue er ægte bær.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Strawberry","d":"wikipedia.org","q":"Botanically, the strawberry is not a berry, but an aggregate accessory fruit.","ok":true},{"u":"https://denstoredanske.lex.dk/jordb%C3%A6r","d":"denstoredanske.lex.dk","q":"Ved opsvulmning af frugtbunden dannes en falsk frugt, som bærer mange småfrugter","ok":true},{"u":"https://en.wikipedia.org/wiki/Berry","q":"Botanical berries not commonly known as berries include bananas, tomatoes, grapes","ok":true}]},"kodd|{\"o\":[\"Peanut\",\"Hasselnød\",\"Valnød\",\"Kastanje\"],\"a\":0,\"age\":11,\"e\":\"Peanut er en bælgfrugt fra ærteblomstfamilien – de andre er ægte nødder.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Peanut","d":"wikipedia.org","q":"is a legume crop grown mainly for its edible seeds, contained in underground pods.","ok":true},{"u":"https://denstoredanske.lex.dk/jordn%C3%B8d","d":"denstoredanske.lex.dk","q":"Frugten er en uopspringende bælg med 2-3 meget olierige frø.","ok":true}]},"kodd|{\"o\":[\"Lunge\",\"Mave\",\"Tyndarm\",\"Spiserør\"],\"a\":0,\"age\":9,\"e\":\"Lungen bruges til at trække vejret – de andre er dele af fordøjelseskanalen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/lunge","d":"denstoredanske.lex.dk","q":"Lungerne er organet for vejrtrækning (respiration).","ok":true},{"u":"https://en.wikipedia.org/wiki/Human_digestive_system","d":"wikipedia.org","q":"Most of the digestion of food takes place in the small intestine.","ok":true},{"u":"https://denstoredanske.lex.dk/ford%C3%B8jelse","d":"denstoredanske.lex.dk","q":"Fordøjelsen indebærer alle de ændringer, som maden gennemgår, når den passerer fordøjelseskanalen fra mundhulen til endetarmen.","ok":true}]},"kodd|{\"o\":[\"Salzburg\",\"Berlin\",\"München\",\"Hamburg\"],\"a\":0,\"age\":10,\"e\":\"Salzburg ligger i Østrig – de andre byer ligger i Tyskland.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Salzburg","d":"denstoredanske.lex.dk","q":"Salzburg er hovedstad i den østrigske delstat Salzburg beliggende langs floden Salzach ved grænsen til Tyskland","ok":true},{"u":"https://en.wikipedia.org/wiki/Salzburg","d":"wikipedia.org","q":"Today, along with Vienna and the Tyrol, Salzburg is one of Austria's most popular tourist destinations.","ok":true}]},"kodd|{\"o\":[\"Nice\",\"Rom\",\"Venedig\",\"Milano\"],\"a\":0,\"age\":10,\"e\":\"Nice ligger i Frankrig – de andre byer ligger i Italien.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Nice","d":"wikipedia.org","q":"is a city and commune, and the prefecture of the department of Alpes-Maritimes, and the administrative region of Provence-Alpes-Côte d'Azur, France.","ok":true},{"u":"https://denstoredanske.lex.dk/Nice","d":"denstoredanske.lex.dk","q":"I 1860, efter Italiens samling, blev Nice en del af Frankrig.","ok":true}]},"kodd|{\"o\":[\"Island\",\"Kreta\",\"Sicilien\",\"Cypern\"],\"a\":0,\"age\":9,\"e\":\"Island ligger i Nordatlanten – de andre øer ligger i Middelhavet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Iceland","d":"wikipedia.org","q":"Iceland is a Nordic island country between the Arctic Ocean and the North Atlantic Ocean, located on the Mid-Atlantic Ridge between Europe and North America.","ok":true},{"u":"https://denstoredanske.lex.dk/Island","d":"denstoredanske.lex.dk","q":"Island er en ø og selvstændig republik i Nordatlanten.","ok":true}]},"kodd|{\"o\":[\"Bøg\",\"Fyr\",\"Gran\",\"Lærk\"],\"a\":0,\"age\":9,\"e\":\"Bøg er et løvtræ – de andre er nåletræer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Beech","d":"wikipedia.org","q":"Beech (genus Fagus) is a genus of deciduous trees in the family Fagaceae","ok":true},{"u":"https://denstoredanske.lex.dk/b%C3%B8g","d":"denstoredanske.lex.dk","q":"Bøg er dansk skovbrugs vigtigste løvtræart.","ok":true}]},"kodd|{\"o\":[\"Solsort\",\"Musvåge\",\"Tårnfalk\",\"Havørn\"],\"a\":0,\"age\":9,\"e\":\"Solsort er en sangfugl (trost) – de andre er rovfugle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Common_blackbird","d":"wikipedia.org","q":"The common blackbird (Turdus merula) is a species of true thrush.","ok":true},{"u":"https://denstoredanske.lex.dk/solsort","d":"denstoredanske.lex.dk","q":"Solsortens sang er melodisk og meget varieret og består af bløde fløjtetoner.","ok":true}]},"kodd|{\"o\":[\"Paella\",\"Pizza\",\"Pasta\",\"Risotto\"],\"a\":0,\"age\":9,\"e\":\"Paella er en spansk risret – de andre er italienske retter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/paella","d":"denstoredanske.lex.dk","q":"Paella er en traditionel spansk risret, der stammer fra egnen omkring Valencia, hvor der dyrkes ris.","ok":true},{"u":"https://en.wikipedia.org/wiki/Paella","d":"wikipedia.org","q":"Other popular local variations of paella are cooked throughout the Mediterranean area, the rest of Spain, and internationally.","ok":true}]},"kodd|{\"o\":[\"Tomat\",\"Basilikum\",\"Pinjekerner\",\"Hvidløg\"],\"a\":0,\"age\":10,\"e\":\"Klassisk pesto laves af basilikum, hvidløg og pinjekerner – ikke tomat.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/pesto","d":"denstoredanske.lex.dk","q":"Den stammer oprindeligt fra Ligurien og er lavet af frisk basilikum, hvidløg og pinjekerner stødt i en morter.","ok":true},{"u":"https://en.wikipedia.org/wiki/Pesto","d":"wikipedia.org","q":"First, garlic and pine nuts are placed in the mortar and reduced to a cream, and then the washed and dried basil leaves are added with coarse salt and ground to a creamy ","ok":true}]},"kodd|{\"o\":[\"Kilogram\",\"Meter\",\"Kilometer\",\"Mil\"],\"a\":0,\"age\":9,\"e\":\"Kilogram måler masse (vægt), mens de andre måler længde.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Kilogram","d":"wikipedia.org","q":"is the base unit of mass in the International System of Units (SI), equal to one thousand grams.","ok":true},{"u":"https://denstoredanske.lex.dk/kilogram","d":"denstoredanske.lex.dk","q":"Kilogram er en af de syv grundenheder i SI-systemet og er defineret som massen af den internationale kilogramprototype","ok":true}]},"kodd|{\"o\":[\"Mos\",\"Champignon\",\"Rørhat\",\"Fluesvamp\"],\"a\":0,\"age\":9,\"e\":\"Mos er en plante – de andre er svampe.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Moss","d":"wikipedia.org","q":"Mosses are small, non-vascular flowerless plants in the taxonomic division Bryophyta","ok":true},{"u":"https://denstoredanske.lex.dk/mosser","d":"denstoredanske.lex.dk","q":"Mosser er en gruppe af sporeplanter, der sammen med levermosserne udgør plantegruppen Bryophyta","ok":true}]},"kodd|{\"o\":[\"Feta\",\"Mozzarella\",\"Parmesan\",\"Gorgonzola\"],\"a\":0,\"age\":11,\"e\":\"Feta er en græsk ost – de andre er italienske oste.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Feta","d":"wikipedia.org","q":"only those cheeses produced in a traditional way in particular areas of Greece, which are made from sheep milk, or from a mixture of sheep milk and up to 30% of goat milk","ok":true},{"u":"https://denstoredanske.lex.dk/feta","d":"denstoredanske.lex.dk","q":"Feta er en saltet friskost fra Balkanområdet, der oprindeligt var baseret på fåremælk.","ok":true}]},"kodd|{\"o\":[\"Gris\",\"Ko\",\"Får\",\"Ged\"],\"a\":0,\"age\":10,\"e\":\"Grisen har én mave – de andre er drøvtyggere med flere mavekamre.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/gris","d":"denstoredanske.lex.dk","q":"Gris, svin, enkeltmavet, parrettået hovdyr af pattedyrenes klasse og hvirveldyrenes række.","ok":true},{"u":"https://denstoredanske.lex.dk/dr%C3%B8vtygger","d":"denstoredanske.lex.dk","q":"Drøvtyggere er pattedyr, der gylper maveindhold op og tygger det igen.","ok":true},{"u":"https://en.wikipedia.org/wiki/Ruminant","d":"wikipedia.org","q":"Ruminants are herbivorous grazing or browsing artiodactyls belonging to the suborder Ruminantia","ok":true}]},"kodd|{\"o\":[\"Blodtype C\",\"Blodtype A\",\"Blodtype B\",\"Blodtype AB\"],\"a\":0,\"age\":11,\"e\":\"Der findes blodtyperne A, B, AB og 0 – ikke C.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/blodtype","d":"denstoredanske.lex.dk","q":"Alle mennesker har én af fire AB0-typer: A, B, AB eller 0","ok":true},{"u":"https://en.wikipedia.org/wiki/Blood_type","d":"wikipedia.org","q":"they determine someone's blood type (A, B, AB, and O, with + or − denoting RhD status) for suitability in blood transfusion.","ok":true}]},"kodd|{\"o\":[\"Lissabon\",\"Madrid\",\"Barcelona\",\"Valencia\"],\"a\":0,\"age\":10,\"e\":\"Lissabon er Portugals hovedstad – de andre byer ligger i Spanien.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Lissabon","d":"denstoredanske.lex.dk","q":"Lissabon er Portugals hovedstad, beliggende i Midtportugal på nordsiden af floden Tejo","ok":true},{"u":"https://en.wikipedia.org/wiki/Lisbon","d":"wikipedia.org","q":"In 1147, Afonso Henriques conquered the city and in 1255, it became Portugal's capital, replacing Coimbra.","ok":true}]},"kodd|{\"o\":[\"Toronto\",\"New York\",\"Los Angeles\",\"Chicago\"],\"a\":0,\"age\":10,\"e\":\"Toronto ligger i Canada – de andre byer ligger i USA.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Toronto","d":"denstoredanske.lex.dk","q":"Toronto er Canadas største by og hovedstaden i provinsen Ontario","ok":true},{"u":"https://en.wikipedia.org/wiki/Toronto","d":"wikipedia.org","q":"is the most populous city in Canada and the capital city of the Canadian province of Ontario.","ok":true}]},"kodd|{\"o\":[\"Dublin\",\"London\",\"Manchester\",\"Edinburgh\"],\"a\":0,\"age\":10,\"e\":\"Dublin ligger i Irland – de andre byer ligger i Storbritannien.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Dublin","d":"denstoredanske.lex.dk","q":"Dublin er Irlands hovedstad og landets eneste storby","ok":true},{"u":"https://en.wikipedia.org/wiki/Dublin","d":"wikipedia.org","q":"Following the partition of Ireland in 1922, it became the capital of the Irish Free State (1922–1937) and is now the capital of Ireland.","ok":true}]},"kodd|{\"o\":[\"Gobi\",\"Sahara\",\"Kalahari\",\"Namib\"],\"a\":0,\"age\":10,\"e\":\"Gobi ligger i Asien – de andre ørkener ligger i Afrika.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/%C3%B8rken","d":"denstoredanske.lex.dk","q":"Langs den nordlige vendekreds findes store ørkenområder som Gobi i Kina, dele af det sydvestlige USA og Mexico, Sahara i Nordafrika","ok":true},{"u":"https://en.wikipedia.org/wiki/Gobi_Desert","d":"wikipedia.org","q":"is a large, cold desert and grassland region in southern Mongolia and North China.","ok":true}]},"kodd|{\"o\":[\"Italien\",\"Schweiz\",\"Østrig\",\"Ungarn\"],\"a\":0,\"age\":9,\"e\":\"Italien har kyst – de andre lande er indlandsstater uden adgang til havet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Landlocked_country","d":"wikipedia.org","q":"Some landlocked countries in Europe are affluent, such as Andorra, Austria, Liechtenstein, Luxembourg, San Marino, Switzerland, and Vatican City.","ok":true},{"u":"https://denstoredanske.lex.dk/Ungarn","d":"denstoredanske.lex.dk","q":"Da Ungarn er en indlandsstat, har landet ingen flåde.","ok":true},{"u":"https://denstoredanske.lex.dk/Italien","d":"denstoredanske.lex.dk","q":"Det samme gælder kysterne fra Ligurien i nordvest til Calabrien.","ok":true}]},"kodd|{\"o\":[\"Mont Blanc\",\"Everest\",\"K2\",\"Fuji\"],\"a\":0,\"age\":10,\"e\":\"Mont Blanc ligger i Alperne i Europa – de andre bjerge ligger i Asien.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Mont_Blanc","d":"denstoredanske.lex.dk","q":"Mont Blanc er et bjergmassiv i Vestalperne på grænsen mellem Frankrig og Italien.","ok":true},{"u":"https://en.wikipedia.org/wiki/Mont_Blanc","d":"wikipedia.org","q":"Being the highest part of the Alps, Mont Blanc and surrounding mountains can create their own weather patterns.","ok":true}]},"kodd|{\"o\":[\"Sverige\",\"Danmark\",\"Polen\",\"Frankrig\"],\"a\":0,\"age\":10,\"e\":\"Sverige grænser ikke til Tyskland – det gør de tre andre lande.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Tyskland","d":"denstoredanske.lex.dk","q":"Tyskland støder mod nord op til Nordsøen, Danmark og Østersøen, mod øst har det grænser til Polen og Tjekkiet, mod sydøst til Østrig, mod syd til Schweiz, og mod vest til","ok":true},{"u":"https://en.wikipedia.org/wiki/Germany","d":"wikipedia.org","q":"Germany borders Denmark to the north; Poland and the Czech Republic to the east; Austria and Switzerland to the south; and France, Luxembourg, Belgium, and the Netherland","ok":true}]},"kodd|{\"o\":[\"Akropolis\",\"Colosseum\",\"Circus Maximus\",\"Forum Romanum\"],\"a\":0,\"age\":11,\"e\":\"Akropolis ligger i Athen i Grækenland – de andre er romerske bygninger i Rom.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Acropolis","d":"wikipedia.org","q":"The most famous example is the Athenian Acropolis, which is a collection of structures featuring a citadel on the highest part of land in ancient (and modern-day) Athens,","ok":true},{"u":"https://denstoredanske.lex.dk/Athen","d":"denstoredanske.lex.dk","q":"Bybilledet domineres af den antikke bys kalkstenshøje, først og fremmest Akropolis (156 m)","ok":true}]},"kodd|{\"o\":[\"Finland\",\"Danmark\",\"Norge\",\"Sverige\"],\"a\":0,\"age\":11,\"e\":\"Finland hører til Norden, men ikke til Skandinavien – det gør de tre andre lande.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/Skandinavien","d":"denstoredanske.lex.dk","q":"Skandinavien er landene Norge, Sverige og Danmark.","ok":true},{"u":"https://denstoredanske.lex.dk/Skandinavien","d":"denstoredanske.lex.dk","q":"Norden omfatter de skandinaviske lande samt Finland og Island","ok":true},{"u":"https://en.wikipedia.org/wiki/Scandinavia","d":"wikipedia.org","q":"Continental Scandinavia or mainland Scandinavia is ordinarily used locally for Denmark, Norway and Sweden as a subset of the Nordic countries","ok":true}]},"kodd|{\"o\":[\"Banan\",\"Fersken\",\"Kirsebær\",\"Blomme\"],\"a\":0,\"age\":9,\"e\":\"Banan er botanisk set et bær – de andre er stenfrugter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Banana","d":"wikipedia.org","q":"A banana is an elongated, edible fruit that is botanically a berry","ok":true},{"u":"https://denstoredanske.lex.dk/banan","d":"denstoredanske.lex.dk","q":"Frugten er et bær med læderagtig ydre væg og en blød indre masse med store, sorte frø.","ok":true},{"u":"https://en.wikipedia.org/wiki/Drupe","d":"wikipedia.org","q":"all members of the genus Prunus, including the almond, apricot, cherry, damson, peach, nectarine, and plum.","ok":true}]},"kodd|{\"o\":[\"Dampmaskine\",\"Kompas\",\"Papir\",\"Krudt\"],\"a\":0,\"age\":11,\"e\":\"Dampmaskinen blev opfundet i England – de tre andre opfindelser stammer fra Kina.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://denstoredanske.lex.dk/dampmaskine","d":"denstoredanske.lex.dk","q":"Den første stempeldampmaskine blev bygget af englænderen Thomas Newcomen i 1712.","ok":true},{"u":"https://en.wikipedia.org/wiki/Four_Great_Inventions","d":"wikipedia.org","q":"They are the compass, gunpowder, papermaking and printing.","ok":true}]},"kodd|{\"o\":[\"Tåge\",\"Regn\",\"Sne\",\"Hagl\"],\"a\":0,\"age\":10,\"e\":\"Tåge er ikke nedbør – de andre falder ned fra skyerne.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Precipitation","d":"wikipedia.org","q":"Thus, fog and mist are not precipitation; their water vapor does not condense sufficiently to precipitate, so fog and mist do not fall.","ok":true},{"u":"https://denstoredanske.lex.dk/nedb%C3%B8r","d":"denstoredanske.lex.dk","q":"Nedbørstyper Den meste nedbør falder som regn, der er vanddråber med en positiv temperatur.","ok":true},{"u":"https://denstoredanske.lex.dk/nedb%C3%B8r","d":"denstoredanske.lex.dk","q":"Sne er iskrystaller med karakteristiske sekstallige krystalformer.","ok":true}]},"kodd|{\"o\":[\"Kobber\",\"Jern\",\"Nikkel\",\"Kobolt\"],\"a\":0,\"age\":11,\"e\":\"Kobber tiltrækkes ikke af en magnet – de tre andre metaller er ferromagnetiske.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Ferromagnetism","d":"wikipedia.org","q":"Relatively few materials are ferromagnetic; the common ones are the metals iron, cobalt, nickel and most of their alloys","ok":true},{"u":"https://denstoredanske.lex.dk/magnetisme","d":"denstoredanske.lex.dk","q":"For jern, kobolt, nikkel og gadolinium er denne tendens særlig udpræget og optræder ved normal omgivelsestemperatur.","ok":true}]},"kodd|{\"o\":[\"Pangolin\",\"Albatros\",\"Kakadu\",\"Ibis\"],\"a\":0,\"age\":9,\"e\":\"Pangolinen er et pattedyr – de andre tre er fugle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Pangolin","d":"wikipedia.org","q":"are mammals of the order Pholidota","ok":true},{"u":"https://lex.dk/skældyr","d":"lex.dk","q":"Skældyrene er en lille gruppe af pattedyr fra Afrika og Asien.","ok":true}]},"kodd|{\"o\":[\"Okapi\",\"Bi\",\"Myre\",\"Græshoppe\"],\"a\":0,\"age\":9,\"e\":\"Okapien er et pattedyr – de andre tre er insekter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Okapi","d":"wikipedia.org","q":"is an artiodactyl mammal that is endemic to the northeast Democratic Republic of the Congo.","ok":true},{"u":"https://animaldiversity.org/accounts/Okapia_johnstoni/","d":"animaldiversity.org","q":"Class Mammalia mammals Order Artiodactyla even-toed ungulates","ok":true}]},"kodd|{\"o\":[\"Komodo-drage\",\"Emu\",\"Kolibri\",\"Trane\"],\"a\":0,\"age\":10,\"e\":\"Komodo-dragen er en krybdyr (en stor øgle) – de andre tre er fugle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Komodo_dragon","d":"wikipedia.org","q":"is a large reptile of the monitor lizard family Varanidae that is endemic to the Indonesian islands of Komodo","ok":true},{"u":"https://animaldiversity.org/accounts/Varanus_komodoensis/","d":"animaldiversity.org","q":"Komodo dragons are the largest lizards, reaching 165 kg and greater than three meters in length.","ok":true}]},"kodd|{\"o\":[\"Axolotl\",\"Øgle\",\"Leguan\",\"Kobra\"],\"a\":0,\"age\":10,\"e\":\"Axolotlen er en padde (halepadde) – de andre tre er krybdyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Axolotl","d":"wikipedia.org","q":"is a species of mole salamander","ok":true},{"u":"https://lex.dk/axolotl","d":"lex.dk","q":"Axolotlen (Ambystoma mexicanum) er en halepadde, der bliver kønsmoden som larve.","ok":true}]},"kodd|{\"o\":[\"Søstjerne\",\"Torsk\",\"Sild\",\"Laks\"],\"a\":0,\"age\":9,\"e\":\"Søstjernen er ikke en fisk, men et pigdyr (echinoderm) i stjerneform.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Starfish","d":"wikipedia.org","q":"Starfish or sea stars are a class of echinoderms generally shaped like a star polygon","ok":true},{"u":"https://oceanservice.noaa.gov/facts/starfish.html","d":"oceanservice.noaa.gov","q":"Sea stars, commonly called, \"starfish,\" are not fish","ok":true}]},"kodd|{\"o\":[\"Stork\",\"Falk\",\"Høg\",\"Ørn\"],\"a\":0,\"age\":10,\"e\":\"Storken er en vadefugl – de andre tre er rovfugle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Stork","d":"wikipedia.org","q":"Storks are large, long-legged, long-necked wading birds with long, stout bills.","ok":true},{"u":"https://animaldiversity.org/accounts/Ciconia_ciconia/","d":"animaldiversity.org","q":"White storks are large, wading birds.","ok":true},{"u":"https://animaldiversity.org/accounts/Haliaeetus_leucocephalus/","d":"animaldiversity.org","q":"Order Falconiformes diurnal birds of prey Family Accipitridae eagles, hawks, and kites","ok":true}]},"kodd|{\"o\":[\"Vakuum\",\"Fast\",\"Væske\",\"Gas\"],\"a\":0,\"age\":11,\"e\":\"Et vakuum er slet intet stof – de andre tre er stoffets tilstande.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Vacuum","d":"wikipedia.org","q":"space devoid of matter","ok":true},{"u":"https://lex.dk/vakuum","d":"lex.dk","q":"Et vakuum er et rumfang, der ikke indeholder stof, og hvor trykket derfor er nul.","ok":true}]},"kodd|{\"o\":[\"Lysår\",\"Time\",\"Minut\",\"Dag\"],\"a\":0,\"age\":11,\"e\":\"Et lysår er en længde (afstand), ikke et tidsrum – trods navnet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Light-year","d":"wikipedia.org","q":"the term is a unit of distance, not a unit of time","ok":true},{"u":"https://lex.dk/lysår","d":"lex.dk","q":"Lysår er en enhed for længde svarende til den strækning, lyset bevæger sig i det tomme rum","ok":true}]},"kodd|{\"o\":[\"Charon\",\"Merkur\",\"Venus\",\"Mars\"],\"a\":0,\"age\":10,\"e\":\"Charon er en måne (Plutos måne) – de andre tre er planeter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Charon_(moon)","d":"wikipedia.org","q":"is the largest of the five known natural satellites of the dwarf planet Pluto","ok":true},{"u":"https://science.nasa.gov/pluto/","d":"science.nasa.gov","q":"Pluto's largest moon, Charon, is about half the size of Pluto","ok":true}]},"kodd|{\"o\":[\"Vesta\",\"Jupiter\",\"Saturn\",\"Uranus\"],\"a\":0,\"age\":10,\"e\":\"Vesta er en lille klippeasteroide – de andre tre er planeter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/4_Vesta","d":"wikipedia.org","q":"is one of the objects in the asteroid belt, with a mean diameter of 523 kilometres","ok":true},{"u":"https://science.nasa.gov/solar-system/asteroids/4-vesta/","d":"science.nasa.gov","q":"Vesta is the second most massive body in the main asteroid belt","ok":true}]},"kodd|{\"o\":[\"ISS\",\"Merkur\",\"Venus\",\"Jupiter\"],\"a\":0,\"age\":10,\"e\":\"ISS er en rumstation, hvor astronauter bor og arbejder – de andre tre er planeter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/International_Space_Station","d":"wikipedia.org","q":"The International Space Station (ISS) is a space station in low Earth orbit","ok":true},{"u":"https://www.nasa.gov/international-space-station/","d":"nasa.gov","q":"the International Space Station is featured in this image photographed by an STS-130 crew member","ok":true}]},"kodd|{\"o\":[\"Kaspiske Hav\",\"Persiske Golf\",\"Sort Hav\",\"Adriatiske Hav\"],\"a\":0,\"age\":11,\"e\":\"Det Kaspiske Hav er en sø – verdens største sø, ikke et hav!\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Caspian_Sea","d":"wikipedia.org","q":"The Caspian Sea is the world's largest inland body of water, also described as the world's largest lake","ok":true},{"u":"https://lex.dk/Det_Kaspiske_Hav","d":"lex.dk","q":"Det Kaspiske Hav er en saltsø på grænsen mellem Europa og Asien. Den er verdens største sø","ok":true},{"u":"https://lex.dk/Sortehavet","d":"lex.dk","q":"stort havområde mellem SØ-Europa og Asien med et bihav, Det Azovske Hav","ok":true}]},"kodd|{\"o\":[\"Krakow\",\"Prag\",\"Wien\",\"Budapest\"],\"a\":0,\"age\":10,\"e\":\"Prag, Wien og Budapest er hovedstæder – Kraków er Polens næststørste by, men hovedstaden er Warszawa.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Kraków","d":"wikipedia.org","q":"is the second-largest and one of the oldest cities in Poland","ok":true},{"u":"https://lex.dk/Warszawa","d":"lex.dk","q":"Warszawa er Polens hovedstad og hovedstad i regionen Mazowieckie.","ok":true}]},"kodd|{\"o\":[\"Liechtenstein\",\"Paris\",\"Madrid\",\"Rom\"],\"a\":0,\"age\":9,\"e\":\"Liechtenstein er et land (et lille fyrstedømme i Alperne) – de andre tre er byer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Liechtenstein","d":"wikipedia.org","q":"is a doubly landlocked country in the Central European Alps","ok":true},{"u":"https://lex.dk/Liechtenstein","d":"lex.dk","q":"Liechtenstein er et fyrstendømme i Alperne mellem Schweiz og Østrig","ok":true}]},"kodd|{\"o\":[\"Tunge\",\"Kranium\",\"Ribben\",\"Lårben\"],\"a\":0,\"age\":9,\"e\":\"Tungen er en muskel – de andre tre er knogler.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Tongue","d":"wikipedia.org","q":"The tongue is a muscular organ in the mouth of a typical tetrapod.","ok":true},{"u":"https://lex.dk/knogle","d":"lex.dk","q":"Menneskets skelet inddeles i hovedets, halsens og kroppens skelet (det axiale skelet) samt ekstremiteternes skelet","ok":true}]},"kodd|{\"o\":[\"Matcha\",\"Espresso\",\"Cappuccino\",\"Latte\"],\"a\":0,\"age\":10,\"e\":\"Matcha er pulveriseret grøn te – de andre tre er kaffedrikke.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Matcha","d":"wikipedia.org","q":"is a finely ground powder of green tea specially processed from shade-grown tea leaves","ok":true},{"u":"https://lex.dk/kaffe","d":"lex.dk","q":"Ristede og formalede kaffebønner overhældt med kogende vand giver en aromatisk drik, der bl.a. indeholder koffein.","ok":true}]},"kodd|{\"o\":[\"Viskelær\",\"Blyant\",\"Kuglepen\",\"Tusch\"],\"a\":0,\"age\":9,\"e\":\"Blyant, kuglepen og tusch bruges til at skrive – en viskelær bruges til at slette.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Eraser","d":"wikipedia.org","q":"is an article of stationery that is used for removing marks from paper or skin","ok":true},{"u":"https://lex.dk/blyant","d":"lex.dk","q":"Blyant, skriveredskab bestående af en hærdet ler-grafit-stift støttet af et træhylster","ok":true}]},"kodd|{\"o\":[\"Højttaler\",\"Mikroskop\",\"Teleskop\",\"Kamera\"],\"a\":0,\"age\":10,\"e\":\"Mikroskop, teleskop og kamera bruges til at se – en højttaler bruges til at høre.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Loudspeaker","d":"wikipedia.org","q":"The speaker driver is an electroacoustic transducer that converts an electrical audio signal into a corresponding sound.","ok":true},{"u":"https://lex.dk/højttaler","d":"lex.dk","q":"En højttaler er en elektroakustisk omformer, der omsætter elektriske svingninger til lydbølger.","ok":true}]},"kodd|{\"o\":[\"Kompas\",\"Globus\",\"Kort\",\"Atlas\"],\"a\":0,\"age\":10,\"e\":\"Et kompas viser retningen (nord) – globus, kort og atlas viser jorden.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Compass","d":"wikipedia.org","q":"A compass is a device that shows the cardinal directions used for navigation and geographic orientation.","ok":true},{"u":"https://lex.dk/kompas","d":"lex.dk","q":"Kompas, instrument til bestemmelse af nordretningen og dermed alle andre retninger på jordoverfladen.","ok":true}]},"kodd|{\"o\":[\"Haglbyge\",\"Tornado\",\"Hurrikan\",\"Tyfon\"],\"a\":0,\"age\":10,\"e\":\"Tornado, orkan og tyfon er hvirvlende storme – en haglbyge er bare en byge af hagl.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Hail","d":"wikipedia.org","q":"Hail is a form of solid atmospheric precipitation.","ok":true},{"u":"https://www.nhc.noaa.gov/aboutgloss.shtml","d":"nhc.noaa.gov","q":"Hurricane / Typhoon: A tropical cyclone in which the maximum sustained surface wind (using the U.S. 1-minute average) is 64 kt (74 mph or 119 km/hr) or more.","ok":true}]},"kodd|{\"o\":[\"Brom\",\"Jern\",\"Kobber\",\"Guld\"],\"a\":0,\"age\":11,\"e\":\"Brom er et halogen – altså ikke et metal. Jern, kobber og guld er metaller.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bromine","d":"wikipedia.org","q":"Bromine is the third halogen, being a nonmetal in group 17 of the periodic table.","ok":true},{"u":"https://lex.dk/kobber","d":"lex.dk","q":"Kobber er et forholdsvis blødt, rødt metal.","ok":true}]},"kodd|{\"o\":[\"Lærke\",\"Bøg\",\"Gran\",\"Ege\"],\"a\":0,\"age\":9,\"e\":\"Lærken er en fugl – de andre tre er træer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Lark","d":"wikipedia.org","q":"Larks are passerine birds of the family Alaudidae.","ok":true},{"u":"https://lex.dk/bøg","d":"lex.dk","q":"Bøg er en slægt af middelstore til store, hovedsagelig løvfældende skovtræer i bøgefamilien.","ok":true}]},"kodd|{\"o\":[\"Ellipse\",\"Cirkel\",\"Trekant\",\"Firkant\"],\"a\":0,\"age\":11,\"e\":\"En ellipse har ingen lige sider – de andre tre er figurer med lige kanter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Ellipse","d":"wikipedia.org","q":"an ellipse is a plane curve surrounding two focal points, such that for all points on the curve, the sum of both distances to the two focal points is a constant","ok":true},{"u":"https://mathworld.wolfram.com/Ellipse.html","d":"mathworld.wolfram.com","q":"An ellipse is a curve that is the locus of all points in the plane","ok":true}]},"kodd|{\"o\":[\"Roning\",\"Fodbold\",\"Håndbold\",\"Tennis\"],\"a\":0,\"age\":9,\"e\":\"Fodbold, håndbold og tennis spilles med en bold – roning foregår i en robåd.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Rowing","d":"wikipedia.org","q":"Rowing is the act of propelling a human-powered watercraft using the sweeping motions of oars","ok":true},{"u":"https://lex.dk/roning","d":"lex.dk","q":"Roning er motion og konkurrencer i robåde.","ok":true}]},"kodd|{\"o\":[\"Kilimanjaro\",\"Everest\",\"K2\",\"Mont Blanc\"],\"a\":0,\"age\":11,\"e\":\"Kilimanjaro er en udslukket vulkan – de andre tre er bjerge, men ikke vulkaner.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Kilimanjaro","d":"wikipedia.org","q":"is a large dormant stratovolcano in Tanzania","ok":true},{"u":"https://lex.dk/Kilimanjaro","d":"lex.dk","q":"Det består af tre udslukte vulkaner","ok":true}]},"kodd|{\"o\":[\"Negle\",\"Kranium\",\"Ribben\",\"Lårben\"],\"a\":0,\"age\":10,\"e\":\"Neglen er lavet af keratin – den er ikke en knogle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Nail_(anatomy)","d":"wikipedia.org","q":"Fingernails and toenails are made of a tough rigid protein called alpha-keratin","ok":true},{"u":"https://lex.dk/knogle","d":"lex.dk","q":"I alt består skelettet af cirka 206 enkeltknogler: Kraniet består af 29 knogler","ok":true}]},"kodd|{\"o\":[\"Hår\",\"Øje\",\"Næse\",\"Øre\"],\"a\":0,\"age\":10,\"e\":\"Øjet, næsen og øret er sanser – hår er et protein fra huden, ikke et sanseorgan.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Hair","d":"wikipedia.org","q":"Hair is a protein filament that grows from follicles found in the dermis.","ok":true},{"u":"https://lex.dk/sanser","d":"lex.dk","q":"I almindelig sprogbrug knyttes begrebet sanser dog mere snævert til de højerestående flercellede dyr med specielle sanseorganer","ok":true}]},"kodd|{\"o\":[\"Gulerod\",\"Tandbørste\",\"Sæbe\",\"Håndklæde\"],\"a\":0,\"age\":3,\"e\":\"Guleroden er mad – de andre hører i badeværelset.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/gulerod","d":"lex.dk","q":"Gulerod er en slægt i skærmplantefamilien med ca. 20 arter","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=gulerod","d":"ordnet.dk","q":"orange pælerod fra dyrkede sorter af planten gulerod, brugt som grøntsag","ok":true}]},"kodd|{\"o\":[\"Hue\",\"Gryde\",\"Pande\",\"Tallerken\"],\"a\":0,\"age\":3,\"e\":\"Huen er tøj – de andre er køkkengrej.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=hue","d":"ordnet.dk","q":"hovedbeklædning uden skygge og med blød eller let afstivet puld","ok":true},{"u":"https://da.wikipedia.org/wiki/Hue","d":"wikipedia.org","q":"En hovedbeklædning er en beklædningsgenstand, der bæres på hovedet.","ok":true}]},"kodd|{\"o\":[\"Gryde\",\"Pude\",\"Dyne\",\"Seng\"],\"a\":0,\"age\":3,\"e\":\"Gryden er køkkengrej – de andre hører i sengen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/gryde","d":"lex.dk","q":"En gryde er en madlavningsbeholder til brug for tilberedning over en varmekilde.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=gryde","d":"ordnet.dk","q":"åben, ofte cylindrisk beholder af metal, som regel med to hanke og evt. med låg, til tilberedning af mad","ok":true}]},"kodd|{\"o\":[\"Knæ\",\"Tænder\",\"Tunge\",\"Læber\"],\"a\":0,\"age\":3,\"e\":\"Knæet sidder på benet – de andre er i munden.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=knæ","d":"ordnet.dk","q":"den bøjelige overgang mellem lår og underben","ok":true},{"u":"https://da.wikipedia.org/wiki/Kn%C3%A6","d":"wikipedia.org","q":"Et knæ er et led, der forbinder de to dele af benet.","ok":true}]},"kodd|{\"o\":[\"Tå\",\"Øje\",\"Næse\",\"Mund\"],\"a\":0,\"age\":3,\"e\":\"Tåen sidder på foden – de andre sidder i hovedet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=tå","d":"ordnet.dk","q":"hver af de fem bevægelige dele der sidder for enden af foden","ok":true},{"u":"https://da.wikipedia.org/wiki/T%C3%A5","d":"wikipedia.org","q":"er en legemsdel","ok":true}]},"kodd|{\"o\":[\"Får\",\"Cykel\",\"Bus\",\"Tog\"],\"a\":0,\"age\":3,\"e\":\"Fåret er et dyr – de andre er køretøjer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=får","d":"ordnet.dk","q":"mellemstor drøvtygger med meget kraftig, oftest hvidlig uldpels","ok":true},{"u":"https://lex.dk/får","d":"lex.dk","q":"De egentlige får er en slægt af hovdyr, som omfatter seks vilde arter samt tamfåret.","ok":true}]},"kodd|{\"o\":[\"Badedragt\",\"Slæde\",\"Snebold\",\"Skøjter\"],\"a\":0,\"age\":4,\"e\":\"Badedragten hører til sommer – de andre til sne.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=badedragt","d":"ordnet.dk","q":"tætsiddende dragt som dækker både over- og underkrop, og som især kvinder har på når de bader","ok":true},{"u":"https://lex.dk/badedragt","d":"lex.dk","q":"En badedragt er almindelig strandbeklædning til begge køn","ok":true}]},"kodd|{\"o\":[\"Køleskab\",\"Rutsjebane\",\"Sandkasse\",\"Gyngestativ\"],\"a\":0,\"age\":4,\"e\":\"Køleskabet hører i køkkenet – de andre på legepladsen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=køleskab","d":"ordnet.dk","q":"særligt skab som bruges til opbevaring af madvarer, og som er udstyret med et køleaggregat","ok":true},{"u":"https://lex.dk/køleskab","d":"lex.dk","q":"Køleskab, isoleret skab med kunstig køling til opbevaring af først og fremmest letfordærvelige levnedsmidler.","ok":true}]},"kodd|{\"o\":[\"Vanter\",\"Kniv\",\"Gaffel\",\"Ske\"],\"a\":0,\"age\":4,\"e\":\"Vanter er tøj – de andre er bestik.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=vante","d":"ordnet.dk","q":"beklædningsgenstand til hånden med et separat rum til tommelfingeren","ok":true},{"u":"https://da.wikipedia.org/wiki/Handske","d":"wikipedia.org","q":"Vanter eller luffer ligner handsker, men vanter og luffer har typisk ét rum til tommelfingeren og ét rum til de øvrige fingre.","ok":true}]},"kodd|{\"o\":[\"Tandbørste\",\"Lagkage\",\"Ballon\",\"Flag\"],\"a\":0,\"age\":4,\"e\":\"Tandbørsten hører i badeværelset – ikke til fødselsdag.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/tandbørste","d":"lex.dk","q":"En tandbørste er et redskab, der anvendes til at børste tænder med.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=tandbørste","d":"ordnet.dk","q":"lille langskaftet børste til rensning af tænder og tandkød","ok":true}]},"kodd|{\"o\":[\"Støvsuger\",\"Bold\",\"Dukke\",\"Terning\"],\"a\":0,\"age\":5,\"e\":\"Støvsugeren er et apparat – de andre er legetøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/støvsuger","d":"lex.dk","q":"Støvsuger, maskine til opsamling af støv og andre småpartikler fra møbler, tæpper og gulve i hjemmet og på arbejdspladser.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=støvsuger","d":"ordnet.dk","q":"elektrisk apparat til opsugning af støv og snavs","ok":true}]},"kodd|{\"o\":[\"Pude\",\"Tromme\",\"Fløjte\",\"Klokke\"],\"a\":0,\"age\":4,\"e\":\"Puden er blød og lydløs – de andre laver musik.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=pude","d":"ordnet.dk","q":"mindre pose af især stof som er stoppet med dun, skumgummi, kunststof eller andet blødt materiale, og som bruges til at hvile hovedet på","ok":true},{"u":"https://da.wikipedia.org/wiki/Pude","d":"wikipedia.org","q":"Støttepuder er ofte hovedpuder i en seng, men kan også være sofapuder, rygpuder og puder til brug på stole og bænke.","ok":true}]},"kodd|{\"o\":[\"Bold\",\"Træ\",\"Blomst\",\"Græs\"],\"a\":0,\"age\":5,\"e\":\"Bolden er til leg – de andre er planter, der gror.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/bold","d":"lex.dk","q":"Bold, i årtusinder brugt over hele verden til leg, spil og idræt.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=bold","d":"ordnet.dk","q":"rund, sædvanligvis luftfyldt og elastisk genstand der bruges til at kaste, sparke eller trille med i leg eller sport","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=plante","d":"ordnet.dk","q":"levende organisme der ikke har nogen særlig evne til at bevæge sig","ok":true}]},"kodd|{\"o\":[\"Skøjter\",\"Badebukser\",\"Solcreme\",\"Håndklæde\"],\"a\":0,\"age\":4,\"e\":\"Skøjterne hører til isen – de andre til stranden.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=skøjte","d":"ordnet.dk","q":"kortskaftet støvle med metalklinge som man spænder på hver fod så man kan glide på is","ok":true},{"u":"https://da.wikipedia.org/wiki/Sk%C3%B8jter","d":"wikipedia.org","q":"En skøjte er en støvle med en metal mede nedenunder, der gør det muligt hurtigt at bevæge sig over is.","ok":true}]},"kodd|{\"o\":[\"Cykel\",\"Ble\",\"Sut\",\"Klapvogn\"],\"a\":0,\"age\":4,\"e\":\"Cyklen er et køretøj – de andre er babyting.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/cykel","d":"lex.dk","q":"En cykel er et sædvanligvis tohjulet køretøj fremdrevet ved pedalkraft.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=cykel","d":"ordnet.dk","q":"tohjulet køretøj som man driver frem ved at dreje to pedaler rundt med fødderne","ok":true}]},"kodd|{\"o\":[\"Ske\",\"Hue\",\"Vanter\",\"Halstørklæde\"],\"a\":0,\"age\":4,\"e\":\"Skeen er bestik – de andre er vintertøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/ske","d":"lex.dk","q":"En ske er et spiseredskab.","ok":true},{"u":"https://da.wikipedia.org/wiki/Ske","d":"wikipedia.org","q":"Skeen er et meget gammelt spiseredskab, som blev udviklet allerede i stenalderen","ok":true}]},"kodd|{\"o\":[\"Lagkage\",\"Kniv\",\"Gaffel\",\"Tallerken\"],\"a\":0,\"age\":4,\"e\":\"Lagkagen er mad – de andre er bestik og service.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/lagkage","d":"lex.dk","q":"En lagkage er en stor, rund kage bestående af lag af sukkerbrødsdej lagt sammen med frugtmos, creme, flødeskum o.l.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=lagkage","d":"ordnet.dk","q":"stor, cirkelrund kage bestående af 2-3 kagebunde der er lagt i lag med forskellig slags fyld","ok":true}]},"kodd|{\"o\":[\"Suppe\",\"Sko\",\"Støvle\",\"Sandal\"],\"a\":0,\"age\":3,\"e\":\"Suppen er mad – de andre er fodtøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/suppe","d":"lex.dk","q":"Suppe er betegnelsen for en række vandbaserede retter, der spises med ske.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=suppe","d":"ordnet.dk","q":"madret bestående af vand kogt sammen med grøntsager, urter og kød eller kraftben","ok":true}]},"kodd|{\"o\":[\"Gaffel\",\"Hue\",\"Hat\",\"Hjelm\"],\"a\":0,\"age\":4,\"e\":\"Gaflen er bestik – de andre har man på hovedet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=gaffel","d":"ordnet.dk","q":"spiseredskab med 2-4 parallelle, let bøjede grene på et skaft","ok":true},{"u":"https://da.wikipedia.org/wiki/Gaffel","d":"wikipedia.org","q":"Gaffel (bestik) - et redskab til at spise med, som regel med fire let krummende ben.","ok":true}]},"kodd|{\"o\":[\"Håndklæde\",\"Bog\",\"Blyant\",\"Viskelær\"],\"a\":0,\"age\":5,\"e\":\"Håndklædet hører i badeværelset – de andre i skoletasken.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=håndklæde","d":"ordnet.dk","q":"stort rektangulært stykke stof, ofte af frotté, til at tørre sig i","ok":true},{"u":"https://da.wikipedia.org/wiki/H%C3%A5ndkl%C3%A6de","d":"wikipedia.org","q":"Et håndklæde er et stykke tykt absorberende stof eller papir, der bruges til at tørre en selv eller andre ting med.","ok":true}]},"kodd|{\"o\":[\"Sæbe\",\"Kniv\",\"Gaffel\",\"Ske\"],\"a\":0,\"age\":3,\"e\":\"Sæben er til at vaske med – de andre er bestik.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/sæbe","d":"lex.dk","q":"Sæbe, metalsalte af fede syrer; i mere snæver forstand natrium- og kaliumsalte, der anvendes til rengøring og vask.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=sæbe","d":"ordnet.dk","q":"fast eller flydende produkt der sammen med vand bruges til vask eller rengøring","ok":true}]},"kodd|{\"o\":[\"Kniv\",\"Pude\",\"Dyne\",\"Bamse\"],\"a\":0,\"age\":4,\"e\":\"Kniven er et redskab – de andre er bløde ting i sengen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/kniv","d":"lex.dk","q":"Kniv, Kniven anses for et af menneskehedens enkleste redskaber","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=kniv","d":"ordnet.dk","q":"redskab til at skære eller stikke med","ok":true}]},"kodd|{\"o\":[\"Ild\",\"Regn\",\"Vand\",\"Hav\"],\"a\":0,\"age\":4,\"e\":\"Ilden er varm – de andre er våde.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/ild","d":"lex.dk","q":"Ild, forbrænding, som foregår under afgivelse af energi som varme og lys.","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=ild","d":"ordnet.dk","q":"flamme(r) som opstår ved forbrænding af et stof ved høj temperatur","ok":true}]},"kodd|{\"o\":[\"Fjer\",\"Elefant\",\"Bil\",\"Sten\"],\"a\":0,\"age\":5,\"e\":\"Fjeren vejer næsten intet – de andre er tunge.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/fjer","d":"lex.dk","q":"Fjer, karakteristiske dannelser af keratin (horn) i fugles hud","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=fjer","d":"ordnet.dk","q":"de små, lette udvækster som dækker en fugls krop","ok":true}]},"kodd|{\"o\":[\"Tandpasta\",\"Brød\",\"Ost\",\"Smør\"],\"a\":0,\"age\":3,\"e\":\"Tandpasta er til tænderne – de andre er mad.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/tandpasta","d":"lex.dk","q":"Tandpasta er et hygiejneprodukt, der anvendes sammen med en tandbørste til at rense tænderne","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=tandpasta","d":"ordnet.dk","q":"tyktflydende, blød masse til at komme på en tandbørste og gnubbe mod tænderne","ok":true}]},"kodd|{\"o\":[\"Sandal\",\"Flyverdragt\",\"Hue\",\"Vanter\"],\"a\":0,\"age\":4,\"e\":\"Sandalen er sommerfodtøj – de andre er vintertøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/sandal","d":"lex.dk","q":"Sandaler, fodtøj formet omkring en sål påsyet remme, der bindes eller spændes om fod og evt. ankel","ok":true},{"u":"https://ordnet.dk/ddo/ordbog?query=sandal","d":"ordnet.dk","q":"let fodbeklædning som består af en sål (med eller uden hæl) og en overdel der udgøres af et åbent læderstykke eller af remme","ok":true}]},"kodd|{\"o\":[\"Ble\",\"Hammer\",\"Skruetrækker\",\"Sav\"],\"a\":0,\"age\":4,\"e\":\"Bleen er babyudstyr – de andre er værktøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://ordnet.dk/ddo/ordbog?query=ble","d":"ordnet.dk","q":"stykke tykt papirmateriale eller ufarvet bomuldsstof til at fæstne om numsen","ok":true},{"u":"https://da.wikipedia.org/wiki/Ble","d":"wikipedia.org","q":"En ble er et hygiejneprodukt, der bruges til at absorbere urin og opsamle afføring.","ok":true}]},"kodd|{\"o\":[\"Narhval\",\"Æg\",\"Mælk\",\"Brød\"],\"a\":0,\"age\":5,\"e\":\"Narhvalen er en hval – altså et pattedyr, ikke en fisk. Det lange horn på snuden er en stor tand.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Narhval","d":"wikipedia.org","q":"Narhvalhanner har en enkelt lang snoet stødtand","ok":true},{"u":"https://da.wikipedia.org/wiki/Narhval","d":"wikipedia.org","q":"I middelalderen blev narhvalens stødtand solgt som enhjørningehorn i Europa.","ok":true},{"u":"https://lex.dk/narhval","d":"lex.dk","q":"Narhvalen er en op til 5 m lang og 1,6 tons tung tandhval i familien hvidhvaler","ok":true}]},"kodd|{\"o\":[\"Kamel\",\"Abrikos\",\"Ananas\",\"Kirsebær\"],\"a\":0,\"age\":4,\"e\":\"Kamelen er et dyr – de andre tre er frugter. Kamelerne lever i ørkenen, som de er utroligt godt tilpasset.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Dromedar","d":"wikipedia.org","q":"Dromedaren levede oprindeligt vildt i Sahara og på den Arabiske Halvø","ok":true},{"u":"https://lex.dk/kameler","d":"lex.dk","q":"De adskiller sig fra andre hovdyr ved at have én eller to fedtholdige pukler på ryggen; puklerne er blot en af mange tilpasninger, der gør kamelerne til nogle af verdens ","ok":true}]},"kodd|{\"o\":[\"Hvalross\",\"Cykel\",\"Knallert\",\"Balanceboard\"],\"a\":0,\"age\":5,\"e\":\"Hvalrossen er ikke en fisk – den er et pattedyr, der lever i det kolde Ishav.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Hvalros","d":"wikipedia.org","q":"er et havpattedyr , der tilhører underordenen Pinnipedia (sæler) og lever i spredte områder omkring Nordpolen i Ishavet","ok":true},{"u":"https://lex.dk/hvalros","d":"lex.dk","q":"Hvalros er en art af sæler , som udgør en egen familie, Odobenidae","ok":true}]},"kodd|{\"o\":[\"Isbjørn\",\"Traktor\",\"Bus\",\"Tog\"],\"a\":0,\"age\":3,\"e\":\"Isbjørnen er et dyr – de andre tre er køretøjer. Isbjørnens pels ser hvid ud, men hårene er gennemsigtige – huden under er sort.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Isbjørn","d":"wikipedia.org","q":"Selvom isbjørnens pels ser ud til at være hvid, er hårene gennemsigtige og selve huden er mørk – næsten sort, så den optager varmen ekstra godt.","ok":true},{"u":"https://lex.dk/isbjørn","d":"lex.dk","q":"Med sin hvide pels og en lang række andre egenskaber er den tilpasset vinteren på den arktiske havis, hvor den jager sæler .","ok":true}]},"kodd|{\"o\":[\"Kænguru\",\"Gulerod\",\"Løg\",\"Peber\"],\"a\":0,\"age\":5,\"e\":\"Kænguruen er et dyr – de andre tre er grøntsager. Kænguruen hopper fremad på meget lange og kraftfulde bagben.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kænguru","d":"wikipedia.org","q":"De hører til blandt de mest velkendte pungdyr og er typiske repræsentanter for Australiens fauna, men findes også på Ny Guinea .","ok":true},{"u":"https://lex.dk/kænguruer","d":"lex.dk","q":"Kænguruer er en familie af karakteristiske pungdyr , som bevæger sig hoppende på meget lange og kraftfulde bagben.","ok":true}]},"kodd|{\"o\":[\"Krokodille\",\"Hane\",\"Høns\",\"Kylling\"],\"a\":0,\"age\":5,\"e\":\"Krokodillen er et krybdyr – de andre tre er fugle.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Krokodille","d":"wikipedia.org","q":"Krokodiller (Crocodilia) er en orden af oftest store, halvakvatiske krybdyr","ok":true},{"u":"https://lex.dk/krokodiller","d":"lex.dk","q":"Krokodiller er en orden af krybdyr , der omfatter de egentlige krokodiller (Crocodylidae), alligatorer og kaimaner (Alligatoridae) samt gavialen (Gavialidae).","ok":true}]},"kodd|{\"o\":[\"Øgle\",\"Seng\",\"Dør\",\"Vindue\"],\"a\":0,\"age\":5,\"e\":\"Øglen er et krybdyr – de andre tre er ting i et hus.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Øgle","d":"wikipedia.org","q":"Gruppen som normalt klassificeres som underordnen Lacertilia består af alle krybdyr i overordnen Lepidosauria","ok":true},{"u":"https://lex.dk/øgle","d":"lex.dk","q":"Øgle er en underorden af krybdyr","ok":true}]},"kodd|{\"o\":[\"Humlebi\",\"Mus\",\"Kanin\",\"Marsvin\"],\"a\":0,\"age\":5,\"e\":\"Humlebien er et insekt – de andre tre er pattedyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Humlebi","d":"wikipedia.org","q":"En humlebi er en af over 250 arter i slægten Bombus , der tilhører familien Apidae , en af bi -familierne i ordenen årevingede insekter .","ok":true},{"u":"https://animaldiversity.org/accounts/Bombus/","d":"animaldiversity.org","q":"Class Insecta insects Order Hymenoptera Family Apidae","ok":true}]},"kodd|{\"o\":[\"Fluesvamp\",\"Rød\",\"Blå\",\"Lilla\"],\"a\":0,\"age\":5,\"e\":\"Fluesvampen er en svamp – ikke en plante. Nogle fluesvampe er giftige.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Fluesvamp","d":"wikipedia.org","q":"De hører til gruppen af større hatsvampe og har følgende typiske fællestræk","ok":true},{"u":"https://da.wikipedia.org/wiki/Fluesvamp","d":"wikipedia.org","q":"Specielt har to arter et stort indhold af amatoksiner , nemlig Grøn fluesvamp og Snehvid fluesvamp","ok":true},{"u":"https://simple.wikipedia.org/wiki/Amanita_muscaria","d":"simple.wikipedia.org","q":"The quintessential toadstool , it is a large white- gilled , white-spotted, usually deep red mushroom, one of the most recognizable and widely encountered in popular cult","ok":true}]},"kodd|{\"o\":[\"Alpaka\",\"Løbe\",\"Hoppe\",\"Kravle\"],\"a\":0,\"age\":4,\"e\":\"Alpakaen er et dyr – de andre tre er ting, man kan gøre.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Alpaka","d":"wikipedia.org","q":"Alpakaen ( Vicugna pacos ) er et domesticeret sydamerikansk pattedyr i familien Camelidae .","ok":true},{"u":"https://www.nationalgeographic.com/animals/mammals/facts/alpaca","d":"nationalgeographic.com","q":"They are ungulates, a group of large hooved mammals that also include sheep and giraffes","ok":true}]},"kodd|{\"o\":[\"Krage\",\"Chokolade\",\"Kage\",\"Is\"],\"a\":0,\"age\":4,\"e\":\"Kragen er en fugl – de andre tre er søde sager.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Gråkrage","d":"wikipedia.org","q":"er en cirka 47 centimeter stor krage fugl der yngler i det nordvestlige og centrale europa og i mellemøsten","ok":true},{"u":"https://lex.dk/krage","d":"lex.dk","q":"Navnet krage er i Danmark betegnelsen for to arter af kragefugle","ok":true}]},"kodd|{\"o\":[\"Hvidløg\",\"Sort\",\"Hvid\",\"Gul\"],\"a\":0,\"age\":4,\"e\":\"Hvidløget er en løgplante – de andre tre er farver.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Hvidløg","d":"wikipedia.org","q":"Planten er en af de ældste kendte kulturplanter og har længe været benyttet inden for folkemedicinen.","ok":true},{"u":"https://lex.dk/hvidløg","d":"lex.dk","q":"Hvidløg er en kraftigt duftende, løgdannende grøntsag med porrelignende vækst.","ok":true}]},"kodd|{\"o\":[\"Løg\",\"Rugbrød\",\"Franskbrød\",\"Bolle\"],\"a\":0,\"age\":5,\"e\":\"Løget er en grøntsag – de andre tre er brød. Skar du i et løg, giver det tårer i øjnene.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Løg","d":"wikipedia.org","q":"Dette stof er irriterende for hud og slimhinder og giver tårer i øjnene.","ok":true},{"u":"https://lex.dk/kepaløg","d":"lex.dk","q":"Kepaløg er en art i narcisfamilien ; den almindeligst anvendte art i madlavning.","ok":true}]},"kodd|{\"o\":[\"Pizza\",\"Batteri\",\"Dinosaur\",\"Dobbeltsøj\"],\"a\":0,\"age\":3,\"e\":\"Pizza er mad – de andre tre er legetøj. Pizzaen kom til verden i Napoli i Italien.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Pizza","d":"wikipedia.org","q":"Til gengæld menes Napoli at være stedet, hvor den første pizza margherita blev lavet","ok":true},{"u":"https://lex.dk/pizza","d":"lex.dk","q":"Udrullet meldej har oprindelser i oldtiden i Middelhavsområdet, men fik i form af pizza et gennembrud i Napoli i 1800-tallet.","ok":true}]},"kodd|{\"o\":[\"Honning\",\"Bold\",\"Terning\",\"Kort\"],\"a\":0,\"age\":3,\"e\":\"Honning er mad – de andre tre er legetøj. Bierne laver honningen, og den holder sig længe.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Honning","d":"wikipedia.org","q":"Det har været kendt siden oldtiden , at honning virker antiseptisk , og allerede ægypterne brugte honning til sårbehandling .","ok":true},{"u":"https://lex.dk/honning","d":"lex.dk","q":"Når bierne vender hjem med den indsamlede nektar i deres honningmave, gennemløber nektaren en proces, som gør den langtidsholdbar.","ok":true}]},"kodd|{\"o\":[\"Regnbue\",\"Sol\",\"Måne\",\"Stjerne\"],\"a\":0,\"age\":5,\"e\":\"Regnbuen er et lysfænomen – de andre tre er ting på himlen. Den dannes, når lyset fra Solen brydes i vanddråber.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Regnbue","d":"wikipedia.org","q":"En regnbue er et optisk fænomen; en \"lyseffekt\", som skabes på himlen, når lys fra Solen rammer små vanddråber i luften","ok":true},{"u":"https://lex.dk/regnbue","d":"lex.dk","q":"Regnbuer forekommer, når sollyset tilbagekastes og brydes i vanddråber, idet hver dråbe virker som et prisme.","ok":true}]},"kodd|{\"o\":[\"Kaktus\",\"Sol\",\"Regn\",\"Vind\"],\"a\":0,\"age\":4,\"e\":\"Kaktussen er en plante – de andre tre er vejret. Kaktussen gemmer vand i de tykke stængler.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kaktus","d":"wikipedia.org","q":"Kaktus-familien ( Cactaceae ) består af 111 slægter og ca. 1500 arter, som er sukkulenter og velkendte fra ørkenbiotoper .","ok":true},{"u":"https://lex.dk/kaktus","d":"lex.dk","q":"En lang række tilpasninger til tørkeprægede voksesteder kan iagttages, fx tyk kutikula , der nedsætter fordampningen, vandvæv i stængler, manglende blade","ok":true}]},"kodd|{\"o\":[\"Pære\",\"Bil\",\"Bus\",\"Båd\"],\"a\":0,\"age\":3,\"e\":\"Pæren er en frugt – de andre tre er køretøjer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Pære","d":"wikipedia.org","q":"Frugten er rund-pæreformet og indeholder stenceller i frugtkødet.","ok":true},{"u":"https://lex.dk/pære","d":"lex.dk","q":"Frugterne kan være næsten kugleformede til pæreformede","ok":true}]},"kodd|{\"o\":[\"Panda\",\"Ærter\",\"Bønner\",\"Linser\"],\"a\":0,\"age\":5,\"e\":\"Pandaen er en bjørn – de andre tre er grøntsager. 98 % af pandans kost er bambus.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Panda","d":"wikipedia.org","q":"Pandaen lever næsten udelukkende af bambus , æg og enkelte insekter/rotter indgår dog også i kosten.","ok":true},{"u":"https://lex.dk/pandaer","d":"lex.dk","q":"Omkring 98% af kosten hos både stor panda og rød panda udgøres af bambus.","ok":true}]},"kodd|{\"o\":[\"Østers\",\"Bamse\",\"Dukke\",\"Klod\"],\"a\":0,\"age\":5,\"e\":\"Østersen er et bløddyr – en musling – de andre tre er legetøj.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Østers","d":"wikipedia.org","q":"er en 8-15 centimeter stor, marin musling","ok":true},{"u":"https://lex.dk/østers","d":"lex.dk","q":"Østers er en overfamilie omfattende to familier af marine og brakvandslevende muslinger","ok":true}]},"kodd|{\"o\":[\"Øre\",\"Kande\",\"Kop\",\"Tallerken\"],\"a\":0,\"age\":3,\"e\":\"Øret hører lyde – de andre tre er køkkenting. Inde i øret sidder tre små knogler: hammeren, ambolten og stigbøjlen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Mellemøret","d":"wikipedia.org","q":"Mellemøret er et luftfyldt rum, hvor de tre øreknogler sidder – hammeren , ambolten og stigbøjlen .","ok":true},{"u":"https://lex.dk/hørelse","d":"lex.dk","q":"Sansningen af lyd foregår i ører eller høreorganer , mens analysen fortrinsvis finder sted i hjernen.","ok":true}]},"kodd|{\"o\":[\"Finger\",\"Hat\",\"Sok\",\"Handske\"],\"a\":0,\"age\":3,\"e\":\"Fingeren er en del af hånden – de andre tre er ting, man tager på.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Finger","d":"wikipedia.org","q":"En finger er et af de fem bevægelige lemmer, som sidder yderst på hånden hos mennesker","ok":true},{"u":"https://lex.dk/hånd","d":"lex.dk","q":"Som arbejdsredskab er den karakteriseret ved, at tommelfingeren kan føres mod de andre fingre","ok":true}]},"kodd|{\"o\":[\"Tand\",\"Agurk\",\"Radise\",\"Asparges\"],\"a\":0,\"age\":5,\"e\":\"Tanden er en del af munden – de andre tre er grøntsager. Mennesket har 32 blivende tænder.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Tand","d":"wikipedia.org","q":"Mennesket har 20 mælketænder og 32 blivende tænder .","ok":true},{"u":"https://lex.dk/tænder","d":"lex.dk","q":"Tænder er hårdt mineraliserede tyggelegemer, der sidder fast i kæberne .","ok":true}]},"kodd|{\"o\":[\"Ryg\",\"Brun\",\"Orange\",\"Grå\"],\"a\":0,\"age\":4,\"e\":\"Ryggen er kroppens bagside – de andre tre er farver. Ryggen består af en række ryghvirvler.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ryghvirvel","d":"wikipedia.org","q":"En ryghvirvel eller vertebra er en irregulær knogle i rygsøjlen .","ok":true},{"u":"https://lex.dk/ryg","d":"lex.dk","q":"Ryggen er kroppens bagside; nedadtil afgrænset mod sædet af hoftebenskammen.","ok":true}]},"kodd|{\"o\":[\"Frosk\",\"Lakrids\",\"Karamel\",\"Skumborn\"],\"a\":0,\"age\":5,\"e\":\"Frosken er en padde – de andre tre er slik. Frosken bevæger sig ved at hoppe med lange bagben.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Frø_(padde)","d":"wikipedia.org","q":"Springpadder bevæger sig ved at hoppe eller svømme ved hjælp af lange baglemmer med svømmehud mellem tæerne.","ok":true},{"u":"https://animaldiversity.org/accounts/Rana_temporaria/","d":"animaldiversity.org","q":"farther north than any other amphibian in the region","ok":true}]},"kodd|{\"o\":[\"Snabel\",\"Torden\",\"Sne\",\"Regn\"],\"a\":0,\"age\":4,\"e\":\"Snabelen er en del af kroppen – elefantens snabel – de andre tre er vejret.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Snabel","d":"wikipedia.org","q":"er et langt værktøj som sidder i nærheden af eller i munden","ok":true},{"u":"https://lex.dk/snabel","d":"lex.dk","q":"Elefanternes snabel dannes af den stærkt forlængede næse og overlæbe.","ok":true}]},"kodd|{\"o\":[\"Blyant\",\"Fire\",\"Fem\",\"Seks\"],\"a\":0,\"age\":4,\"e\":\"Blyanten er en ting – de andre tre er tal. Stiften i en blyant er lavet af grafit.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Blyant","d":"wikipedia.org","q":"I dag består stiften af en blanding af pulveriseret grafit og ler .","ok":true},{"u":"https://lex.dk/blyant","d":"lex.dk","q":"Blyant, skriveredskab bestående af en hærdet ler-grafit-stift støttet af et træhylster eller et metalhylster","ok":true}]},"kodd|{\"o\":[\"Bambus\",\"Egetræ\",\"Fyr\",\"Birk\"],\"a\":0,\"age\":6,\"e\":\"Bambus er et græs – de andre er træer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Bambus","d":"wikipedia.org","q":"Bambus (Bambusoideae) er en samlebetegnelse for forveddede græsser fra subtropiske og tropiske egne og dermed teknisk set græs.","ok":true},{"u":"https://lex.dk/bambus","d":"lex.dk","q":"der danner en egen underfamilie af græsfamilien","ok":true}]},"kodd|{\"o\":[\"Merkur\",\"Venus\",\"Mars\",\"Jorden\"],\"a\":0,\"age\":8,\"e\":\"Merkur er den mindste planet i solsystemet – de andre er større.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Merkur_(planet)","d":"wikipedia.org","q":"Det er den mindste planet i Solsystemet, med en ækvatorradius på 2.439,7 km.","ok":true},{"u":"https://science.nasa.gov/mercury/facts/","d":"science.nasa.gov","q":"Mercury is the smallest planet in our solar system and nearest to the Sun.","ok":true}]},"kodd|{\"o\":[\"Neptun\",\"Jupiter\",\"Saturn\",\"Uranus\"],\"a\":0,\"age\":8,\"e\":\"Neptun er den planet, der ligger længest væk fra solen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Neptun_(planet)","d":"wikipedia.org","q":"Neptun er den ottende planet i vores solsystem og den af planeterne, der befinder sig længst væk fra solen.","ok":true},{"u":"https://science.nasa.gov/neptune/facts/","d":"science.nasa.gov","q":"Neptune is the eighth and most distant planet in our solar system.","ok":true}]},"kodd|{\"o\":[\"Blæksprutte\",\"Reje\",\"Krabbe\",\"Hummer\"],\"a\":0,\"age\":7,\"e\":\"Blæksprutten er et bløddyr – de andre er krebsdyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Bl%C3%A6ksprutte","d":"wikipedia.org","q":"Blæksprutter ( Cephalopoda ) er en gruppe af marine bløddyr .","ok":true},{"u":"https://animaldiversity.org/accounts/Octopus_bimaculoides/","d":"animaldiversity.org","q":"Mollusca (clams, snails, squids, and relatives) Class Cephalopoda Order Octopoda","ok":true}]},"kodd|{\"o\":[\"Luft\",\"Oxygen\",\"Nitrogen\",\"Kuldioxid\"],\"a\":0,\"age\":8,\"e\":\"Luft er en blanding af mange gasarter – de andre er hver især ét stof.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Luft","d":"wikipedia.org","q":"Luft er en samling af gasser, partikler og dampe som udgør Jordens atmosfære .","ok":true},{"u":"https://science.nasa.gov/earth/facts/","d":"science.nasa.gov","q":"Near the surface, Earth has an atmosphere that consists of 78% nitrogen, 21% oxygen, and 1% other gases such as argon, carbon dioxide, and neon.","ok":true}]},"kodd|{\"o\":[\"Rust\",\"Jern\",\"Kobber\",\"Guld\"],\"a\":0,\"age\":7,\"e\":\"Rust er ikke et metal – den er jern, der er blevet oxideret.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Rust","d":"wikipedia.org","q":"Rust er en fællesbetegnelse for kemiske forbindelser af jern (Fe) og ilt (O).","ok":true},{"u":"https://lex.dk/rust","d":"lex.dk","q":"Rust, samlebetegnelse for korrosionsprodukter, som dannes ved almindelige temperaturer på jern og jernlegeringer i vand, jord eller fugtige omgivelser.","ok":true}]},"kodd|{\"o\":[\"Kuldioxid\",\"Jern\",\"Guld\",\"Kobber\"],\"a\":0,\"age\":8,\"e\":\"Kuldioxid er en forbindelse af kulstof og ilt – jern, guld og kobber er rene grundstoffer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kuldioxid","d":"wikipedia.org","q":"Det kemiske stof kuldioxid , CO 2 (også carbondioxid ( Kemisk Ordbog ) eller, på ældre dansk i henhold til Ørsteds dansksprogede nomenklatur, kultveilte ) er et molekyle ","ok":true},{"u":"https://openstax.org/books/chemistry-2e/pages/1-2-phases-and-classification-of-matter","d":"openstax.org","q":"Pure substances may be divided into two classes: elements and compounds.","ok":true},{"u":"https://openstax.org/books/chemistry-2e/pages/1-2-phases-and-classification-of-matter","d":"openstax.org","q":"Iron, silver, gold, aluminum, sulfur, oxygen, and copper are familiar examples of the more than 100 known elements","ok":true}]},"kodd|{\"o\":[\"Kolibri\",\"Ørn\",\"Svane\",\"Flamingo\"],\"a\":0,\"age\":7,\"e\":\"Kolibrien er verdens mindste fugl – de andre er store.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kolibri","d":"wikipedia.org","q":"Verdens mindste fugl er bikolibrien , der blot vejer 2 gram, hannen helt ned til 1,6 gram, og er 5-6 cm lang.","ok":true},{"u":"https://animaldiversity.org/accounts/Mellisuga_helenae/","d":"animaldiversity.org","q":"Bee hummingbirds are the smallest birds in the world.","ok":true}]},"kodd|{\"o\":[\"Papir\",\"Metal\",\"Plastik\",\"Glas\"],\"a\":0,\"age\":6,\"e\":\"Papir laves af træ – de andre laves ikke af planter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Papir","d":"wikipedia.org","q":"Først og fremmest benyttes der fibre fra træ (95% af produktionen), men også forskellige græsarter , bomuld og hør benyttes.","ok":true},{"u":"https://lex.dk/papir","d":"lex.dk","q":"Det fremstilles af træ eller andet plantemateriale, som først findeles til fibre.","ok":true}]},"kodd|{\"o\":[\"Kanel\",\"Muskat\",\"Kardemomme\",\"Vanilje\"],\"a\":0,\"age\":7,\"e\":\"Kanel er det eneste krydderi, der er bark fra et træ.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kanel","d":"wikipedia.org","q":"Kanel ( Cinnamomum verum , synonym : Cinnamomum zeylandicum ) er et 10 til 15 meter højt, stedsegrønt træ og et krydderi , der kommer fra træets inderste bark .","ok":true},{"u":"https://plants.ces.ncsu.edu/plants/cinnamomum-verum/","d":"plants.ces.ncsu.edu","q":"The inner bark is edible dried and ground and used as a spice for both savory and sweet cooking.","ok":true}]},"kodd|{\"o\":[\"Chili\",\"Oregano\",\"Basilikum\",\"Rosmarin\"],\"a\":0,\"age\":7,\"e\":\"Chili er stærk – de andre er milde urter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Chili","d":"wikipedia.org","q":"De indeholder stoffet capsaicin , som er det stof, der gør chilier stærke.","ok":true},{"u":"https://lex.dk/chili","d":"lex.dk","q":"Chilisaften er meget stærk, og saft på fx tynd hud eller i øjnene kan være en smertefuld oplevelse.","ok":true}]},"kodd|{\"o\":[\"Blomst\",\"Træ\",\"Busk\",\"Græs\"],\"a\":0,\"age\":6,\"e\":\"En blomst er kun en del af planten – de andre er hele planter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Blomst","d":"wikipedia.org","q":"Blomsten hos en plante er − i den bredeste definition − et uforgrenet skud med begrænset vækst, hvis blade indirekte eller direkte har betydning for den kønnede formering","ok":true},{"u":"https://lex.dk/blomst","d":"lex.dk","q":"Blomsten er hos planter det skud, som er specialiseret til at tjene forplantningen.","ok":true},{"u":"https://openstax.org/books/biology-2e/pages/32-introduction","d":"openstax.org","q":"Flowers are often the showiest or most strongly scented part of plants.","ok":true}]},"kodd|{\"o\":[\"Gær\",\"Mel\",\"Vand\",\"Salt\"],\"a\":0,\"age\":7,\"e\":\"Gær er en levende svamp – de andre er ikke levende.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/G%C3%A6r","d":"wikipedia.org","q":"Gærsvampe er eukaryote mikroorganismer klassificeret i riget Fungi med omkring 1.500 beskrevne arter .","ok":true},{"u":"https://openstax.org/books/biology-2e/pages/24-introduction","d":"openstax.org","q":"Edible mushrooms, yeasts, black mold, and the producer of the antibiotic penicillin, Penicillium notatum , are all members of the kingdom Fungi, which belongs to the doma","ok":true}]},"kodd|{\"o\":[\"Torden\",\"Lyn\",\"Regn\",\"Sne\"],\"a\":0,\"age\":6,\"e\":\"Torden er en lyd, man hører – de andre er ting, man kan se.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Torden","d":"wikipedia.org","q":"Torden , tordenskrald eller tordenbrag er en lyd forårsaget af lyn .","ok":true},{"u":"https://lex.dk/tordenvejr","d":"lex.dk","q":"Opvarmningen medfører en eksplosiv udvidelse af luften og dannelse af en tilhørende trykbølge; torden er lyden fra denne trykbølge.","ok":true}]},"kodd|{\"o\":[\"Meteor\",\"Komet\",\"Asteroid\",\"Meteorit\"],\"a\":0,\"age\":8,\"e\":\"En meteor er et lysspor – de andre er klipper i rummet.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Meteor","d":"wikipedia.org","q":"En meteor (også kaldet et stjerneskud [ kilde mangler ] eller en aerolit ) kan ses, når en meteoroid \"brænder\" og nedbremses i Jordens atmosfære .","ok":true},{"u":"https://science.nasa.gov/solar-system/meteors-meteorites/","d":"science.nasa.gov","q":"Meteors and meteorites are often called “shooting stars” — bright lights streaking across the sky.","ok":true}]},"kodd|{\"o\":[\"Sukkerroer\",\"Gulerod\",\"Rødbede\",\"Kartoffel\"],\"a\":0,\"age\":7,\"e\":\"Sukkerroer dyrkes for at udvinde sukker af roden – de andre er grøntsager.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Sukkerroer","d":"wikipedia.org","q":"Sukkerroer dyrkes for at udvinde sukker af roden.","ok":true},{"u":"https://lex.dk/sukkerroe","d":"lex.dk","q":"Nyopgravet sukkerroe med roetop, der kan bruges til foder, og den sukkerholdige rod, der bruges i produktion af sukker.","ok":true}]},"kodd|{\"o\":[\"Dinosaur\",\"Krokodille\",\"Tudse\",\"Øgle\"],\"a\":0,\"age\":7,\"e\":\"Dinosaurerne uddøde for millioner af år siden – de andre lever i dag.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Dinosaurer","d":"wikipedia.org","q":"En position de holdt til slutningen af kridttiden , hvor de uddøde bortset fra den linje af små rovdinosaurer , der allerede havde udviklet sig til fuglene .","ok":true},{"u":"https://openstax.org/books/biology-2e/pages/29-introduction","d":"openstax.org","q":"they were the dominant terrestrial animals for 150 million years, until most of them died out in a mass extinction near the end of the Cretaceous period","ok":true}]},"kodd|{\"o\":[\"Vin\",\"Whisky\",\"Vodka\",\"Rom\"],\"a\":0,\"age\":8,\"e\":\"Vin er gæret – whisky, vodka og rom er destilleret.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Vin","d":"wikipedia.org","q":"Vin er en alkoholisk drik fremstillet af fermenteret druesaft .","ok":true},{"u":"https://lex.dk/destillation","d":"lex.dk","q":"Tegningen viser anlæg til destillation af aqua vitae (brændevin).","ok":true},{"u":"https://lex.dk/destillation","d":"lex.dk","q":"Fremstilling af alkohol kendes fra ca. 1100-t., men først fra midten af 1400-t. blev brændevin fremstillet til nydelsesbrug.","ok":true}]},"kodd|{\"o\":[\"Fugl\",\"Mus\",\"Fisk\",\"Frosk\"],\"a\":0,\"age\":6,\"e\":\"Fuglen kan flyve – mus, fisk og frø kan ikke.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Fugl","d":"wikipedia.org","q":"De fleste fugle kan flyve og er ligesom pattedyr varmblodede .","ok":true},{"u":"https://openstax.org/books/biology-2e/pages/29-5-birds","d":"openstax.org","q":"Feathers not only provide insulation, but also allow for flight, producing the lift and thrust necessary for flying birds to become and stay airborne.","ok":true}]},"kodd|{\"o\":[\"Kirsebær\",\"Bær\",\"Nød\",\"Stenfrugt\"],\"a\":0,\"age\":8,\"e\":\"Kirsebær er én bestemt frugt – bær, nød og stenfrugt er grupper af frugter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Frugt","d":"wikipedia.org","q":"Frugter kan som tommelfingerregel inddeles i nogle hovedgrupper, på grundlag af kødethed og antallet af frø","ok":true},{"u":"https://lex.dk/frugt","d":"lex.dk","q":"Uopspringende frugter omfatter hovedgrupperne bær , stenfrugter og nødder , inddelt efter egenskaber ved frugtskallens væglag.","ok":true}]},"kodd|{\"o\":[\"Juice\",\"Vin\",\"Øl\",\"Cider\"],\"a\":0,\"age\":6,\"e\":\"Juice er presset af frugter – vin, øl og cider er gærede.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Juice","d":"wikipedia.org","q":"Juice er en drik fra planter , som for det meste presses af frugter .","ok":true},{"u":"https://lex.dk/alkohol","d":"lex.dk","q":"Alkohol produceres i naturen af visse bakterier og af gær, hvor alkohol er et stofskifteprodukt fra den iltfrie ( anaerobe ) nedbrydning af sukkerarter ( kulhydrater ).","ok":true}]},"kodd|{\"o\":[\"Orangutang\",\"Chimpansé\",\"Gorilla\",\"Babun\"],\"a\":0,\"age\":7,\"e\":\"Orangutangen lever i Asien – chimpansen, gorillaen og babunen lever i Afrika.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Orangutang","d":"wikipedia.org","q":"Orangutanger lever i regnskove på Borneo og Sumatra .","ok":true},{"u":"https://animaldiversity.org/accounts/Pan_troglodytes/","d":"animaldiversity.org","q":"Chimpanzees ( Pan troglodytes ) inhabit the tropical forests of central Africa.","ok":true},{"u":"https://animaldiversity.org/accounts/Gorilla_gorilla/","d":"animaldiversity.org","q":"Africa's tropical secondary forests, where the open canopy allows much light to reach the forest floor, provide the best habitat for western gorillas.","ok":true}]},"kodd|{\"o\":[\"Hestekræfter\",\"Watt\",\"Kilowatt\",\"Newton\"],\"a\":0,\"age\":8,\"e\":\"Hestekræfter er en ældre enhed for effekt – i Danmark blev den afløst af watt (1 hk = 735,5 W).\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Hestekr%C3%A6fter","d":"wikipedia.org","q":"En hestekraft (forkortet hk ) er navnet på forskellige enheder til angivelse af mål for fysisk effekt .","ok":true},{"u":"https://da.wikipedia.org/wiki/Hestekr%C3%A6fter","d":"wikipedia.org","q":"Som måleenhed blev hestekraft i Danmark i 1907 afløst af den afledte SI-enhed watt (W), hvorom det gælder: 1 hk = 735,5 W.","ok":true},{"u":"https://lex.dk/hestekraft","d":"lex.dk","q":"Hestekraft, forkortet hk , er en ældre måleenhed for effekt; 1 hk = 736 W","ok":true}]},"kodd|{\"o\":[\"Blod\",\"Sved\",\"Tårer\",\"Spyt\"],\"a\":0,\"age\":7,\"e\":\"Blod løber rundt i kroppen – sved, tårer og spyt kommer ud af kroppen.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Blod","d":"wikipedia.org","q":"Blod er flydende væv [ 1 ] , der fylder blodkarsystemet og flyder gennem kroppen .","ok":true},{"u":"https://da.wikipedia.org/wiki/Blod","d":"wikipedia.org","q":"Blodkarsystemet består af hjertet , der pumper blodet gennem pulsårer (arterier), hårkarnet (kapillærer) og blodårer (vener).","ok":true},{"u":"https://lex.dk/blod","d":"lex.dk","q":"Blodet pumpes af hjertet via pulsårerne (arterierne) ud til vævene , hvorfra det returneres til hjertet via blodårerne (venerne).","ok":true}]},"kodd|{\"o\":[\"Svampe\",\"Blomster\",\"Træer\",\"Gras\"],\"a\":0,\"age\":7,\"e\":\"Svampe er et eget rige – blomster, træer og gras er planter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Svampe","d":"wikipedia.org","q":"nu er samlet i et selvstændigt rige , svamperiget, der har vist sig at være mere beslægtet med dyreriget end med planteriget .","ok":true},{"u":"https://openstax.org/books/biology-2e/pages/24-introduction","d":"openstax.org","q":"The kingdom Fungi includes an enormous variety of living organisms.","ok":true}]},"kodd|{\"o\":[\"Vandmand\",\"Musling\",\"Snegl\",\"Blæksprutte\"],\"a\":0,\"age\":7,\"e\":\"Vandmanden er et nældecelledyr – de andre er bløddyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Jellyfish","d":"wikipedia.org","q":"Jellyfish, also known as sea jellies or simply jellies, are the medusa-phase of certain gelatinous members of the subphylum Medusozoa, which is a major part of the phylum","ok":true},{"u":"https://en.wikipedia.org/wiki/Mollusca","d":"wikipedia.org","q":"They include snails, slugs and other gastropods; clams and other bivalves; squids and other cephalopods","ok":true},{"u":"https://lex.dk/vandmand","d":"lex.dk","q":"Når zooplanktonorganismerne rører fangsttrådene, der har nældeceller, bliver de lammet og fanget.","ok":true}]},"kodd|{\"o\":[\"Søpindsvin\",\"Krabbe\",\"Reje\",\"Hummer\"],\"a\":0,\"age\":8,\"e\":\"Søpindsvinet er en pighud – de andre er krebsdyr.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://lex.dk/søpindsvin","d":"lex.dk","q":"Søpindsvin er en klasse af pighuder med ca. 950 nulevende arter, hvoraf 9-10 arter findes i danske farvande.","ok":true},{"u":"https://en.wikipedia.org/wiki/Echinoderm","d":"wikipedia.org","q":"which includes starfish, brittle stars, sea urchins, sand dollars and sea cucumbers","ok":true},{"u":"https://en.wikipedia.org/wiki/Crustacean","d":"wikipedia.org","q":"Crustaceans are mainly aquatic, including decapods (shrimps, prawns, crabs, lobsters, and crayfish)","ok":true}]},"kodd|{\"o\":[\"Tusindben\",\"Myre\",\"Bi\",\"Bille\"],\"a\":0,\"age\":7,\"e\":\"Tusindbenet er en mangefod, ikke et insekt – de andre er insekter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://lex.dk/tusindben","d":"lex.dk","q":"Tusindben er fra få millimeter til knap 30 cm lange myriapoder, som udgør deres egen klasse inden for leddyrene.","ok":true},{"u":"https://en.wikipedia.org/wiki/Insect","d":"wikipedia.org","q":"Insects have an exoskeleton, a three-part body (head, thorax and abdomen), three pairs of jointed legs, compound eyes, and a pair of antennae.","ok":true}]},"kodd|{\"o\":[\"Bambus\",\"Egetræ\",\"Gran\",\"Birk\"],\"a\":0,\"age\":7,\"e\":\"Bambus er et græs – de andre er træer.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bamboo","d":"wikipedia.org","q":"Bamboos are a diverse group of mostly evergreen perennial flowering plants making up the subfamily Bambusoideae of the grass family Poaceae.","ok":true},{"u":"https://lex.dk/bambus","d":"lex.dk","q":"Bambus er en fællesbetegnelse for ca. 1.000 arter fordelt på 80 slægter, der danner en egen underfamilie af græsfamilien","ok":true}]},"kodd|{\"o\":[\"Rabarber\",\"Æble\",\"Pære\",\"Blomme\"],\"a\":0,\"age\":7,\"e\":\"Rabarber er en grøntsagsstilk – de andre er frugter.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Rhubarb","d":"wikipedia.org","q":"Rhubarb is a vegetable but is often put to the same culinary uses as fruits. The leaf stalks can be used raw while they have a crisp texture","ok":true},{"u":"https://lex.dk/rabarber","d":"lex.dk","q":"De spiselige bladstilke indeholder betydelige mængder af æblesyre, citronsyre og oxalsyre","ok":true}]},"kodd|{\"o\":[\"Karry\",\"Peber\",\"Kanel\",\"Vanilje\"],\"a\":0,\"age\":7,\"e\":\"Karry er en blanding af krydderier – de andre er enkelte krydderier.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Curry_powder","d":"wikipedia.org","q":"Curry powder is any of several spice mixes for curry, adapted from garam masala in Indian cuisine.","ok":true},{"u":"https://lex.dk/karry","d":"lex.dk","q":"Karry er et blandingskrydderi i form af pulver eller pasta.","ok":true}]},"kodd|{\"o\":[\"Rav\",\"Granit\",\"Flint\",\"Kalksten\"],\"a\":0,\"age\":7,\"e\":\"Rav er størknet harpiks fra træer – de andre er sten.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Amber","d":"wikipedia.org","q":"Amber is fossilized tree resin.","ok":true},{"u":"https://lex.dk/rav","d":"lex.dk","q":"Rav er hærdnet, fossil harpiks fra Tertiærtidens nåleskove.","ok":true}]},"kodd|{\"o\":[\"Læder\",\"Uld\",\"Silke\",\"Bomuld\"],\"a\":0,\"age\":8,\"e\":\"Læder er lavet af dyrehud – de andre er fibre.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Leather","d":"wikipedia.org","q":"Leather is a strong, flexible and durable material obtained from the tanning, or chemical treatment, of animal skins and hides to prevent decay.","ok":true},{"u":"https://en.wikipedia.org/wiki/Wool","d":"wikipedia.org","q":"Wool is the textile fiber obtained from sheep and other mammals","ok":true},{"u":"https://en.wikipedia.org/wiki/Silk","d":"wikipedia.org","q":"Silk is a natural protein fiber","ok":true},{"u":"https://lex.dk/læder","d":"lex.dk","q":"Den moderne proces til forarbejdning af rå huder til læder.","ok":true}]},"kodd|{\"o\":[\"Luxembourg\",\"Belgien\",\"Holland\",\"Danmark\"],\"a\":0,\"age\":8,\"e\":\"Luxembourg har ingen kyst – de andre har kyst.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Luxembourg","d":"wikipedia.org","q":"officially the Grand Duchy of Luxembourg, is a landlocked country in Western Europe.","ok":true},{"u":"https://lex.dk/Luxembourg","d":"lex.dk","q":"Luxembourg er et storhertugdømme beliggende mellem Belgien, Frankrig og Tyskland.","ok":true}]},"kodd|{\"o\":[\"Mexico\",\"Brasilien\",\"Argentina\",\"Chile\"],\"a\":0,\"age\":8,\"e\":\"Mexico ligger i Nordamerika – de andre ligger i Sydamerika.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Mexico","d":"wikipedia.org","q":"Country in North America","ok":true},{"u":"https://lex.dk/Mexico","d":"lex.dk","q":"Mexico er en forbundsrepublik i Nordamerika.","ok":true},{"u":"https://en.wikipedia.org/wiki/Brazil","d":"wikipedia.org","q":"Country in South America","ok":true},{"u":"https://en.wikipedia.org/wiki/Argentina","d":"wikipedia.org","q":"Country in South America","ok":true},{"u":"https://en.wikipedia.org/wiki/Chile","d":"wikipedia.org","q":"Country in South America","ok":true}]},"kodd|{\"o\":[\"Sargassohavet\",\"Atlanterhavet\",\"Stillehavet\",\"Indiske Ocean\"],\"a\":0,\"age\":8,\"e\":\"Sargassohavet har ingen kyst – de andre grænser op til land.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Sargasso_Sea","d":"wikipedia.org","q":"It is the only named sea without land boundaries.","ok":true},{"u":"https://oceanservice.noaa.gov/facts/sargassosea.html","d":"oceanservice.noaa.gov","q":"The Sargasso Sea, located entirely within the Atlantic Ocean, is the only sea without a land boundary.","ok":true}]},"kodd|{\"o\":[\"Muldvarp\",\"Mus\",\"Rotte\",\"Egern\"],\"a\":0,\"age\":7,\"e\":\"Muldvarpen er ikke en gnaver – de andre er gnavere.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Mole_(animal)","d":"wikipedia.org","q":"Moles are now classified with shrews and hedgehogs, in the more narrowly defined order Eulipotyphla.","ok":true},{"u":"https://en.wikipedia.org/wiki/Rodent","d":"wikipedia.org","q":"Well-known rodents include mice, rats, squirrels, prairie dogs, porcupines, beavers, guinea pigs, and hamsters.","ok":true},{"u":"https://animaldiversity.org/accounts/Talpidae/","d":"animaldiversity.org","q":"The family Talpidae consists of moles and desmans; currently, its approximately 42 species are grouped into 17 genera.","ok":true}]},"kodd|{\"o\":[\"Jordskok\",\"Pastinak\",\"Gulerod\",\"Rødbede\"],\"a\":0,\"age\":8,\"e\":\"Jordskokken er en knold – de andre er rødder. Den hører til solsikkeslægten.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://lex.dk/jordskok","d":"lex.dk","q":"Jordskok er en knoldgrøntsag i solsikkeslægten.","ok":true},{"u":"https://en.wikipedia.org/wiki/Jerusalem_artichoke","d":"wikipedia.org","q":"The tubers can be eaten raw, cooked, or pickled.","ok":true},{"u":"https://en.wikipedia.org/wiki/Parsnip","d":"wikipedia.org","q":"The parsnip is a root vegetable closely related to carrot and parsley","ok":true},{"u":"https://lex.dk/gulerod","d":"lex.dk","q":"Det er en- eller toårige urter med pælerod","ok":true},{"u":"https://en.wikipedia.org/wiki/Beetroot","d":"wikipedia.org","q":"Beetroot or beet is the taproot portion of a Beta vulgaris subsp. vulgaris plant","ok":true}]},"kodd|{\"o\":[\"Banan\",\"Citron\",\"Lime\",\"Grapefrugt\"],\"a\":0,\"age\":6,\"e\":\"Bananen er ikke en citrusfrugt – de andre er.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Citrus","d":"wikipedia.org","q":"Plants in the genus produce citrus fruits, such as citrons, mandarins, and pomelos. Many important citrus crops have been developed through extensive hybridization, inclu","ok":true},{"u":"https://lex.dk/citron","d":"lex.dk","q":"Citron, Citrus limon, er en art i Citrus-slægten.","ok":true},{"u":"https://en.wikipedia.org/wiki/Banana","d":"wikipedia.org","q":"A banana is an elongated, edible fruit that is botanically a berry produced by several kinds of large treelike herbaceous flowering plants in the genus Musa.","ok":true}]},"kodd|{\"o\":[\"Gletsjer\",\"Flod\",\"Sø\",\"Hav\"],\"a\":0,\"age\":8,\"e\":\"Gletsjeren er en isflod – de andre er vand.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Glacier","d":"wikipedia.org","q":"A glacier is a persistent body of natural ice, a form of rock, that is constantly moving under its own weight.","ok":true},{"u":"https://lex.dk/gletsjer","d":"lex.dk","q":"En gletsjer er en flerårig sne- og isaflejring, der bevæger sig ned ad skråninger som følge af sin egen masse.","ok":true}]},"kodd|{\"o\":[\"Mammut\",\"Tyrannosaurus\",\"Triceratops\",\"Stegosaurus\"],\"a\":0,\"age\":7,\"e\":\"Mammutten var et pattedyr, der levede helt frem til for ca. 4.000 år siden – de andre er dinosaurer, som uddøde for 66 millioner år siden.\"}":{"pool":"kodd","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Mammoth","d":"wikipedia.org","q":"They lived from the late Miocene epoch (from around 6.2 million years ago) into the Holocene until about 4,000 years ago","ok":true},{"u":"https://lex.dk/mammut","d":"lex.dk","q":"De ældste fund er ca. en million år gamle, og den var særlig talrig på Weichsel-istidens tørre, græsdækkede steppe i Nordamerika, Europa og Nordasien.","ok":true},{"u":"https://en.wikipedia.org/wiki/Dinosaur","d":"wikipedia.org","q":"The Cretaceous–Paleogene extinction event, which occurred approximately 66 million years ago at the end of the Cretaceous, caused the extinction of all dinosaur groups ex","ok":true}]},"kodd|{\"o\":[\"Saxofon\",\"Trompet\",\"Basun\",\"Tuba\"],\"a\":0,\"age\":8,\"e\":\
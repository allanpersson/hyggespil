":[{"u":"https://en.wikipedia.org/wiki/Starfish","d":"wikipedia.org","q":"Most can regenerate damaged parts or lost arms and they can shed arms as a means of defense.","ok":true},{"u":"https://lex.dk/s%C3%B8stjerner","d":"lex.dk","q":"De har en meget stor evne til at regenerere beskadigede kropsdele.","ok":true}]},"ktf|{\"s\":\"Popcorn laves af majs.\",\"t\":true,\"age\":4,\"e\":\"Popcorn er majskerner, der popper, når de bliver varmet op.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/popcorn","d":"lex.dk","q":"Popcorn er en snack, der består af majskerner","ok":true},{"u":"https://da.wikipedia.org/wiki/Popcorn","d":"wikipedia.org","q":"Popcorn er en snack , lavet af visse typer majs","ok":true}]},"ktf|{\"s\":\"Jordbær har frøene på ydersiden.\",\"t\":true,\"age\":5,\"e\":\"De små kerner sidder uden på det røde bær.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/jordb%C3%A6r","d":"lex.dk","q":"Ved opsvulmning af frugtbunden dannes en falsk frugt , som bærer mange småfrugter, der hver for sig er en nøddeagtig (tyndkødet) stenfrugt.","ok":true},{"u":"https://en.wikipedia.org/wiki/Strawberry","d":"wikipedia.org","q":"Each apparent 'seed' on the outside of the strawberry is actually an achene , a botanical fruit with a seed inside it.","ok":true}]},"ktf|{\"s\":\"Agurker består mest af vand.\",\"t\":true,\"age\":5,\"e\":\"Agurker er næsten helt fyldt med vand.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/agurk","d":"lex.dk","q":"Planten kræver meget vand og varme for at kunne udvikle de vandrige frugter, der består af 97% vand.","ok":true},{"u":"https://en.wikipedia.org/wiki/Cucumber","d":"wikipedia.org","q":"Cucumber fruits consist of 95% water","ok":true}]},"ktf|{\"s\":\"Gær er levende.\",\"t\":true,\"age\":5,\"e\":\"Gær er bittesmå svampe, som kan få dej til at hæve.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/g%C3%A6r","d":"lex.dk","q":"Gæren Saccharomyces cerevisiae er en af de bedst undersøgte levende organismer.","ok":true},{"u":"https://da.wikipedia.org/wiki/G%C3%A6r","d":"wikipedia.org","q":"Gærsvampe er eukaryote mikroorganismer klassificeret i riget Fungi","ok":true}]},"ktf|{\"s\":\"Årringene viser, hvor gammelt et træ er.\",\"t\":true,\"age\":5,\"e\":\"Der dannes en ny ring i træet hvert år.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/%C3%A5rring","d":"lex.dk","q":"Ved at tælle og måle årringene i et træ kan man bestemme træets alder.","ok":true},{"u":"https://en.wikipedia.org/wiki/Dendrochronology","d":"wikipedia.org","q":"one ring generally marks the passage of one year in the life of the tree","ok":true}]},"ktf|{\"s\":\"Bambus er et græs.\",\"t\":true,\"age\":5,\"e\":\"Bambus hører til græsfamilien.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/bambus","d":"lex.dk","q":"1.000 arter fordelt på 80 slægter, der danner en egen underfamilie af græsfamilien","ok":true},{"u":"https://en.wikipedia.org/wiki/Bamboo","d":"wikipedia.org","q":"Bamboos are a diverse group of mostly evergreen perennial flowering plants making up the subfamily Bambusoideae of the grass family Poaceae .","ok":true}]},"ktf|{\"s\":\"Bævere bygger dæmninger.\",\"t\":true,\"age\":4,\"e\":\"Bævere bygger dæmninger af grene og mudder.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/b%C3%A6vere","d":"lex.dk","q":"I vandløb og grøfter bygger de dæmninger af afbidte grene og stammer, der tætnes med dynd, som føres med vandstrømmen.","ok":true},{"u":"https://da.wikipedia.org/wiki/B%C3%A6ver","d":"wikipedia.org","q":"Bæveren er kendt for at bygge dæmninger, så vandet samler sig og danner en dam .","ok":true}]},"ktf|{\"s\":\"Kaniner spiser noget af deres egen bæ.\",\"t\":true,\"age\":5,\"e\":\"Kaniner spiser deres bløde bæ for at få næring igen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/kaniner","d":"lex.dk","q":"Kaniner har et særligt fordøjelsessystem, som gør, at de spiser noget af deres afføring ( koprofagi ).","ok":true},{"u":"https://en.wikipedia.org/wiki/Rabbit","d":"wikipedia.org","q":"rabbits ferment fiber in the cecum (part of the gastrointestinal tract) and then expel the contents as cecotropes , which are reingested (cecotrophy or refection).","ok":true}]},"ktf|{\"s\":\"Hamstere gemmer mad i kinderne.\",\"t\":true,\"age\":3,\"e\":\"Hamstere har kindposer, som de bærer maden hjem i.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/hamstere","d":"lex.dk","q":"De fleste har kindposer, som består af løse hudfolder, der strækker sig fra fortænderne langs ydersiden af underkæben til de bageste kindtænder.","ok":true},{"u":"https://da.wikipedia.org/wiki/Hamster","d":"wikipedia.org","q":"hamstere kindposer, som de bruger til at samle føde i og bære det hjem til deres bo","ok":true}]},"ktf|{\"s\":\"Ænder har svømmehud.\",\"t\":true,\"age\":3,\"e\":\"Svømmehuden mellem tæerne gør det nemmere at svømme.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/%C3%A6nder","d":"lex.dk","q":"Alle ænder er knyttet til vand, og tre af tæerne er forbundet med svømmehud.","ok":true},{"u":"https://da.wikipedia.org/wiki/And","d":"wikipedia.org","q":"Andens fødder er flade og tæerne adspredt med svømmehud imellem.","ok":true}]},"ktf|{\"s\":\"Mælketænder falder ud.\",\"t\":true,\"age\":4,\"e\":\"Mælketænderne bliver skiftet ud med blivende tænder.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/m%C3%A6lket%C3%A6nder","d":"lex.dk","q":"Sædvanligvis starter tandfældningen i seks- til otteårs-alderen; ofte er det fortænderne i underkæben, der tabes først.","ok":true},{"u":"https://da.wikipedia.org/wiki/M%C3%A6lketand","d":"wikipedia.org","q":"Deres første sæt tænder, mælketænderne, udskiftes på et tidspunkt med et sæt blivende tænder som ikke kan erstattes.","ok":true}]},"ktf|{\"s\":\"Alle mennesker har forskellige fingeraftryk.\",\"t\":true,\"age\":4,\"e\":\"Ingen har helt ens fingeraftryk.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/fingeraftryk","d":"lex.dk","q":"Herved dannes mønstertyperne og detaljerne, og de bliver forskellige fra finger til finger, ligesom de er individuelle fra person til person.","ok":true},{"u":"https://en.wikipedia.org/wiki/Fingerprint","d":"wikipedia.org","q":"no two finger or palm prints are ever exactly alike in every detail","ok":true}]},"ktf|{\"s\":\"Nogle myrer dyrker svamp i deres bo.\",\"t\":true,\"age\":5,\"e\":\"Myrerne passer svampen og bruger den som mad.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/myrer","d":"lex.dk","q":"hos de nord- og sydamerikanske bladskærermyrer ( Atta spp.), som i deres bo har kamre, hvor de dyrker svampe til larvefoder på gennemtyggede bladstykker.","ok":true},{"u":"https://en.wikipedia.org/wiki/Ant","d":"wikipedia.org","q":"Leafcutter ants ( Atta and Acromyrmex ) feed exclusively on a fungus that grows only within their colonies.","ok":true}]},"ktf|{\"s\":\"Alle fugle har fjer.\",\"t\":true,\"age\":3,\"e\":\"Fjer er noget, som alle fugle har.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/fugle","d":"lex.dk","q":"Fælles for alle fugle er fjerdragten, som både muliggør flyvningen og varmeisolerer","ok":true},{"u":"https://da.wikipedia.org/wiki/Fugle","d":"wikipedia.org","q":"Ingen andre dyr har fjer, hvilket alle fugle har.","ok":true}]},"ktf|{\"s\":\"Pindsvin ruller sig sammen, når de er bange.\",\"t\":true,\"age\":3,\"e\":\"Pindsvinet ruller sig sammen til en pigget kugle.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/pindsvin","d":"lex.dk","q":"kan et pindsvin trække piggene ned over hovedet og resten af kroppen og rulle sig sammen til en lukket kugle med pigge strittende i alle retninger.","ok":true},{"u":"https://da.wikipedia.org/wiki/Pindsvin","d":"wikipedia.org","q":"Pindsvinet kan stritte med sine pigge og rulle sig sammen i forsvarsposition, hvor hoved og lemmer skjules.","ok":true}]},"ktf|{\"s\":\"Tusindben har præcis tusind ben.\",\"t\":false,\"age\":5,\"e\":\"De fleste tusindben har færre ben, og én art har over 1.300.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/tusindben","d":"lex.dk","q":"Kun en enkelt art af tusindben har faktisk 1.000 ben — det er den gravende Eumillipes persephone fra Australien, hvor det længste kendte eksemplar havde hele 1.306 ben.","ok":true},{"u":"https://da.wikipedia.org/wiki/Tusindben","d":"wikipedia.org","q":"Selvom navnet siger \"tusind ben\" på dansk og det samme på flere andre sprog, var ingen art med 1.000 eller flere ben kendt indtil opdagelsen i 2021 af arten Eumillipes pe","ok":true}]},"ktf|{\"s\":\"Geder er gode til at klatre.\",\"t\":true,\"age\":4,\"e\":\"Geder klatrer på klipper og i træer.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/geder","d":"lex.dk","q":"De egentlige geder er en slægt af hovdyr , som er tilpasset et liv i bjerge og klippeområder og er blandt de dygtigste og mest vovemodige klatrere i pattedyrverdenen.","ok":true},{"u":"https://en.wikipedia.org/wiki/Goat","d":"wikipedia.org","q":"They are agile and able to climb and balance in precarious places.","ok":true}]},"ktf|{\"s\":\"Unge solsikker vender sig mod solen.\",\"t\":true,\"age\":5,\"e\":\"Mens solsikken er ung, følger den solen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/solsikke","d":"lex.dk","q":"Det danske navn hentyder til de store, nikkende kurve, der i nogen grad vender sig mod Solen.","ok":true},{"u":"https://en.wikipedia.org/wiki/Sunflower","d":"wikipedia.org","q":"Young sunflowers orient themselves in the direction of the sun.","ok":true}]},"ktf|{\"s\":\"Ost laves af mælk.\",\"t\":true,\"age\":3,\"e\":\"Ost bliver lavet af mælk fra ko, ged eller får.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/ost","d":"lex.dk","q":"Ost er et mælkeprodukt, der fremstilles ved konservering af mælk fra ko, ged eller får.","ok":true},{"u":"https://en.wikipedia.org/wiki/Cheese","d":"wikipedia.org","q":"Cheese is a type of dairy product produced in a range of flavors, textures , and forms by curdling of milk","ok":true}]},"ktf|{\"s\":\"Rosiner er tørrede druer.\",\"t\":true,\"age\":4,\"e\":\"Rosiner er druer, som er blevet tørret.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/rosin","d":"lex.dk","q":"Mørke rosiner er ubehandlede druer, tørret i solen eller på anden vis.","ok":true},{"u":"https://en.wikipedia.org/wiki/Raisin","d":"wikipedia.org","q":"A raisin is a dried grape .","ok":true}]},"ktf|{\"s\":\"Sukker kan laves af sukkerroer.\",\"t\":true,\"age\":5,\"e\":\"Sukkerroer er hvide rødder, som man kan lave sukker af.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/sukker","d":"lex.dk","q":"Den industrielle udvinding sker ud fra sukkerrør og sukkerroer","ok":true},{"u":"https://en.wikipedia.org/wiki/Sugar","d":"wikipedia.org","q":"Sucrose is especially concentrated in sugarcane and sugar beet , making them efficient for commercial extraction to make refined sugar.","ok":true}]},"ktf|{\"s\":\"Man får gåsehud, når man fryser.\",\"t\":true,\"age\":4,\"e\":\"Kulde får hårene på kroppen til at rejse sig.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/g%C3%A5sehud","d":"lex.dk","q":"Gåsehud er smånopret hud med strittende hår, der ses som en forbigående reaktion udløst af fx kulde, angst eller emotionelt.","ok":true},{"u":"https://en.wikipedia.org/wiki/Goose_bumps","d":"wikipedia.org","q":"Goose bumps can be experienced in the presence of flash-cold temperatures","ok":true}]},"ktf|{\"s\":\"En mariehøne er en bille.\",\"t\":true,\"age\":4,\"e\":\"Mariehøns hører til billerne.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/marieh%C3%B8ns","d":"lex.dk","q":"Mariehøns er en familie af små, oftest farvestrålende biller , som er udbredt over det meste af verden.","ok":true},{"u":"https://en.wikipedia.org/wiki/Coccinellidae","d":"wikipedia.org","q":"They are oval beetles with a domed back and flat underside.","ok":true}]},"ktf|{\"s\":\"Alle grise er lyserøde.\",\"t\":false,\"age\":3,\"e\":\"Grise findes i mange farver, også sort og brun.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/svin","d":"lex.dk","q":"Nutidens tamsvin er hvide (eller lyserøde), ensfarvede, bæltede eller brogede.","ok":true},{"u":"https://en.wikipedia.org/wiki/Pig","d":"wikipedia.org","q":"Around 600 breeds of pig have been created by farmers around the world, mainly in Europe and Asia, differing in coloration, shape, and size.","ok":true}]},"ktf|{\"s\":\"Kartofler vokser på underjordiske stængler.\",\"t\":true,\"age\":5,\"e\":\"Kartoflen er en knold, der sidder på en stængel under jorden.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/kartoffel","d":"lex.dk","q":"På underjordiske stængler sidder stivelsesholdige knolde, kartofler , som tjener planten til vegetativ formering","ok":true},{"u":"https://da.wikipedia.org/wiki/Kartoffel","d":"wikipedia.org","q":"Kartoffelplanten danner store, stivelsesholdige knolde på de underjordiske stængler .","ok":true}]},"ktf|{\"s\":\"Der er flere stjerner end sandkorn på en strand.\",\"t\":true,\"age\":4,\"e\":\"Der er så mange stjerner i universet, at der er flere af dem end sandkorn på alle Jordens strande.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Universe","d":"wikipedia.org","q":"more stars (and Earth-like planets) than all the grains of beach sand on planet Earth","ok":true},{"u":"https://science.nasa.gov/asset/hubble/hubble-sees-stars-as-numerous-as-grains-of-sand-in-nearby-galaxy/","d":"science.nasa.gov","q":"Myriads of stars embedded in the heart of the nearby galaxy NGC 300 can be singled out like grains of sand on a beach in this Hubble Space Telescope image.","ok":true}]},"ktf|{\"s\":\"Solens lys tager cirka 8 minutter at nå Jorden.\",\"t\":true,\"age\":5,\"e\":\"Når du kigger på solen, ser du den, som den var for otte minutter siden.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://science.nasa.gov/mission/hubble/science/science-behind-the-discoveries/time-travel-observing-cosmic-history/","d":"science.nasa.gov","q":"it takes roughly eight minutes for its light to reach us here on our planet, so when we look at the Sun (though directly is never recommended!) we see it exactly as it wa","ok":true},{"u":"https://en.wikipedia.org/wiki/Sun","d":"wikipedia.org","q":"At its average distance, light travels from the Sun's horizon to Earth's horizon in about 8 minutes and 20 seconds.","ok":true}]},"ktf|{\"s\":\"En regnbue er en hel cirkel – fra jorden ser man kun en bue.\",\"t\":true,\"age\":4,\"e\":\"Regnbuen er en cirkel, men jorden skygger for den halvdel, der ligger under horisonten.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Rainbow","d":"wikipedia.org","q":"Rainbows when viewed from the ground typically appear as an illuminated arc, but when flying, if there is enough mist they can be seen as full circles.","ok":true},{"u":"https://lex.dk/regnbue","d":"lex.dk","q":"En regnbue er et lysfænomen i atmosfæren, hvor det hvide sollys ved brydning og refleksion i vanddråber spaltes i spektralfarverne og fremtræder som en eller flere koncen","ok":true}]},"ktf|{\"s\":\"En magnet kan trække i sig alt, hvad som helst.\",\"t\":false,\"age\":4,\"e\":\"Magneter tiltrækker især jern – ikke papir, træ eller plastik.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Magnet","d":"wikipedia.org","q":"magnetfeltet er usynligt, men har den egenskab at det kan tiltrække Ferromagnetiske genstande og frastøde eller tiltrække andre magneter","ok":true},{"u":"https://lex.dk/magnet","d":"lex.dk","q":"Magnetfeltet omkring en permanent magnet kan visualiseres ved hjælp af jernfilspåner, der er små, aflange jernsplinter, som magnetiseres af feltet og retter sig ind i fel","ok":true}]},"ktf|{\"s\":\"Katte kan høre lyde, som mennesker ikke kan.\",\"t\":true,\"age\":4,\"e\":\"Katte kan høre ultralyd – den lyd, som mus bruger til at tale sammen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Kat","d":"wikipedia.org","q":"Katte kan høre lyde, der er både dybere og højere end hvad mennesker kan høre.","ok":true},{"u":"https://animaldiversity.org/accounts/Felis_catus/","d":"animaldiversity.org","q":"Their ears are sensitive enough to hear ten octaves, which is two more than a human can hear. Domestic cats can hear a broad range of frequencies, from 50 to 65 kilohertz","ok":true}]},"ktf|{\"s\":\"Fugle kan se farver, som mennesker ikke kan.\",\"t\":true,\"age\":5,\"e\":\"Mange fugle kan se ultraviolet lys – altså en slags farver, vi ikke kan se.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Fugl","d":"wikipedia.org","q":"Synet hos de fleste fugle omfatter et bredt farvespektrum, der strækker sig fra kortbølget ultraviolet lys til langbølget rødt lys.","ok":true},{"u":"https://lex.dk/fugle","d":"lex.dk","q":"I hvert fald visse fugle, fx kolibrier, kan se ultraviolet lys med bølgelængde ned til 325 nm (nedre grænse hos mennesket er ca. 400 nm).","ok":true}]},"ktf|{\"s\":\"Menneskets krop har omkring 600 muskler.\",\"t\":true,\"age\":4,\"e\":\"Vi har omkring 600 muskler, så vi kan løbe, bære og smile.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Muscular_system","d":"wikipedia.org","q":"There are more than 600 muscles in an adult male human body.","ok":true},{"u":"https://pmc.ncbi.nlm.nih.gov/articles/PMC4657151/","d":"pmc.ncbi.nlm.nih.gov","q":"The human body consists of around 600 muscles that contribute to approximately 40%-50% of the total body weight.","ok":true}]},"ktf|{\"s\":\"Tandens emalje er det hårdeste stof i kroppen.\",\"t\":true,\"age\":5,\"e\":\"Emaljen er hårdere end knogler – den skal kunne tåle tygning hele livet.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Tooth_enamel","d":"wikipedia.org","q":"Enamel is the hardest substance in the human body and contains the highest percentage of minerals (at 96%)","ok":true},{"u":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6151498/","d":"pmc.ncbi.nlm.nih.gov","q":"Dental enamel is the hardest substance in the human body and serves as the wear-resistant outer layer of the dental crown.","ok":true}]},"ktf|{\"s\":\"Dine tårer er salt.\",\"t\":true,\"age\":3,\"e\":\"Tårer er saltvand, som kroppen bruger til at holde øjnene rene.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Tåre","d":"wikipedia.org","q":"Tårevæsken består af saltvand, der indeholder en række enzymer og antistoffer, som har til formål at forhindre bakterier at trænge ind i øjet.","ok":true},{"u":"https://medlineplus.gov/tears.html","d":"medlineplus.gov","q":"You may only think of tears as those salty drops that fall from your eyes when you cry.","ok":true}]},"ktf|{\"s\":\"Når du er forkølet, ryster du for at blive varm.\",\"t\":true,\"age\":4,\"e\":\"Musklerne ryster, og så bliver der varmt – kroppen prøver på den måde at blive varm igen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Shivering","d":"wikipedia.org","q":"Skeletal muscles begin to shake in small movements, creating warmth by expending energy.","ok":true},{"u":"https://medlineplus.gov/ency/article/003091.htm","d":"medlineplus.gov","q":"Chills are caused by rapid muscle contraction and relaxation. They are the body's way of producing heat when it feels cold.","ok":true}]},"ktf|{\"s\":\"Snefnug dannes, når vanddamp i luften fryser til is.\",\"t\":true,\"age\":4,\"e\":\"Sne dannes i toppen af skyerne, hvor det er under 0 grader.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Snowflake","d":"wikipedia.org","q":"The droplet then grows by deposition of water molecules in the air (vapor) onto the ice crystal surface where they are collected.","ok":true},{"u":"https://lex.dk/sne","d":"lex.dk","q":"Sne er nedbør, som består af iskrystaller. Sne dannes i toppen af skyerne, hvor temperaturen er under 0 °C.","ok":true}]},"ktf|{\"s\":\"Regndråber dannes på små kerner af sand og støv i luften.\",\"t\":true,\"age\":4,\"e\":\"Når luften køles af, samler vanddampen sig i dråber omkring små støvkorn.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://lex.dk/regn","d":"lex.dk","q":"Regn er nedbør, som består af vanddråber, der kondenserer på små kerner af sand, salt, støv eller lignende.","ok":true},{"u":"https://da.wikipedia.org/wiki/Regn","d":"wikipedia.org","q":"Regn består af vanddråber, som er opstået ved kondensering af vanddamp i skyerne i troposfæren, og som når jordoverfladen.","ok":true}]},"ktf|{\"s\":\"Vandet i havet er salt.\",\"t\":true,\"age\":4,\"e\":\"Havet indeholder omkring 3,5 % salt – derfor kan man ikke drikke det.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Sea_water","d":"wikipedia.org","q":"On average, seawater in the world's oceans has a salinity of about 3.5% (35 g/L, 35 ppt, 600 mM).","ok":true},{"u":"https://lex.dk/hav","d":"lex.dk","q":"Da en af de mest karakteristiske egenskaber ved havvand er indholdet af salt, omfatter begrebet dog også nogle indsøer, fx Det Kaspiske Hav og Det Døde Hav.","ok":true}]},"ktf|{\"s\":\"På Månen kan du ikke høre lyde.\",\"t\":true,\"age\":5,\"e\":\"Der er næsten ingen luft på Månen, og lyd kan ikke rejse sig gennem vakuum.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://science.nasa.gov/moon/facts/","d":"science.nasa.gov","q":"The Moon has a very thin and tenuous atmosphere called an exosphere. It is not breathable.","ok":true},{"u":"https://en.wikipedia.org/wiki/Moon","d":"wikipedia.org","q":"The Moon has an atmosphere consisting of only an exosphere, which is so tenuous as to be nearly vacuum","ok":true},{"u":"https://en.wikipedia.org/wiki/Sound","d":"wikipedia.org","q":"Sound is a phenomenon in which pressure disturbances propagate through an elastic material medium.","ok":true}]},"ktf|{\"s\":\"På Mars er himlen rød om dagen.\",\"t\":true,\"age\":5,\"e\":\"Det er støvet i luften på Mars, der får himlen til at se rød ud.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://science.nasa.gov/mars/facts/","d":"science.nasa.gov","q":"To our eyes, the sky would be hazy and red because of suspended dust instead of the familiar blue tint we see on Earth.","ok":true},{"u":"https://da.wikipedia.org/wiki/Mars_(planet)","d":"wikipedia.org","q":"Mars kaldes også \"den røde planet\" på grund af sin karakteristiske farve.","ok":true}]},"ktf|{\"s\":\"Afrika er større end Grønland.\",\"t\":true,\"age\":5,\"e\":\"Afrika er cirka 30,3 millioner km², mens Grønland er cirka 2,5 millioner km².\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Afrika","d":"wikipedia.org","q":"Afrika er den næststørste verdensdel med et areal på 30,3 millioner km²; det er 20 % af landmasserne på Jorden.","ok":true},{"u":"https://lex.dk/Grønland","d":"lex.dk","q":"Areal 2.486.000 km²","ok":true}]},"ktf|{\"s\":\"Dit hjerte er omtrent så stort som din lukne hånd.\",\"t\":true,\"age\":4,\"e\":\"Hjertet er på størrelse med en knyttet hånd – og det pumper blod rundt i kroppen hele dagen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Hjerte","d":"wikipedia.org","q":"Menneskets hjerte er omtrent på størrelse med en knyttet hånd og ligger i brysthassen","ok":true},{"u":"https://www.nhlbi.nih.gov/health/heart","d":"nhlbi.nih.gov","q":"The heart is an organ about the size of your fist that pumps blood through your body.","ok":true}]},"ktf|{\"s\":\"En kamel kan lukke næseborene helt tæt mod sand.\",\"t\":true,\"age\":4,\"e\":\"Kamelens næsebor kan lukkes helt tæt, så sandstorme ikke kommer ind.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Camel","d":"wikipedia.org","q":"Long eyelashes and ear hairs, together with nostrils that can close, form a barrier against sand.","ok":true},{"u":"https://lex.dk/kameler","d":"lex.dk","q":"særlige muskler, der gør dem i stand til at lukke næseborene og læberne helt tæt","ok":true}]},"ktf|{\"s\":\"En ugle har som regel to ører, der sidder forskelligt.\",\"t\":true,\"age\":5,\"e\":\"Den ene øre sidder højere end det andet – så kan uglen finde musene i mørke.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ugle","d":"wikipedia.org","q":"Ofte er det ydre øre asymmetrisk udformet, hvilket gør uglerne bedre i stand til at lokalisere, hvorfra lyden kommer.","ok":true},{"u":"https://www.nationalgeographic.com/animals/birds/facts/owl","d":"nationalgeographic.com","q":"Owl ears are located under feathers on the sides of their head, with most species having asymmetrical positioning to help them better pinpoint a sound's source.","ok":true}]},"ktf|{\"s\":\"En blyant indeholder ikke bly.\",\"t\":true,\"age\":4,\"e\":\"Blyanten er lavet af grafit og ler – navnet er bare gammelt.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Blyant","d":"wikipedia.org","q":"I dag består stiften af en blanding af pulveriseret grafit og ler.","ok":true},{"u":"https://lex.dk/blyant","d":"lex.dk","q":"Blyant, skriveredskab bestående af en hærdet ler-grafit-stift støttet af et træhylster eller et metalhylster (skrueblyant).","ok":true}]},"ktf|{\"s\":\"En hest ser rødt som grønt.\",\"t\":true,\"age\":4,\"e\":\"Heste kan kun se to farver, så rødt ser de som en grønlig nuance.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Horse","d":"wikipedia.org","q":"Horses have excellent day and night vision, but they have two-color, or dichromatic vision; their color vision is somewhat like red-green color blindness in humans, where","ok":true},{"u":"https://pmc.ncbi.nlm.nih.gov/articles/PMC12392641/","d":"pmc.ncbi.nlm.nih.gov","q":"Horses are dichromatic and can perceive blue to green-yellow colors. Red is probably perceived as a dark green color","ok":true}]},"ktf|{\"s\":\"En voksen tiger lever som regel alene.\",\"t\":true,\"age\":5,\"e\":\"Tigeren jager alene og forsvarer sit eget område – kun tigerunger lever sammen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Tiger","d":"wikipedia.org","q":"Voksne tigre fører generelt et solitært liv.","ok":true},{"u":"https://lex.dk/tiger","d":"lex.dk","q":"Bortset fra hunner med unger lever de alene.","ok":true}]},"ktf|{\"s\":\"Smør laves af fløde.\",\"t\":true,\"age\":4,\"e\":\"Fløden rystes i en kærne, så mælkefedtet samles i smør.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Smør","d":"wikipedia.org","q":"Smør bliver fremstillet ved at kærne frisk eller fermenteret fløde eller mælk.","ok":true},{"u":"https://lex.dk/smør","d":"lex.dk","q":"Smør fremstilles ved, at fløde skilles fra mælk, hvorefter fløden bliver pasteuriseret og syrnet.","ok":true}]},"ktf|{\"s\":\"Delfiner kalder hinanden ved navn.\",\"t\":true,\"age\":5,\"e\":\"Hver delfin har sin egen fløjtetone – næsten som et navn.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Dolphin","d":"wikipedia.org","q":"Bottlenose dolphins have been found to have signature whistles, a whistle that is unique to a specific individual. These whistles are used in order for dolphins to commun","ok":true},{"u":"https://animaldiversity.org/accounts/Tursiops_truncatus/","d":"animaldiversity.org","q":"Each dolphin is believed to possess its own signature whistle and, once it is developed, it is retained for the duration of the dolphin's life.","ok":true}]},"ktf|{\"s\":\"En komet har en hale, der altid peger væk fra solen.\",\"t\":true,\"age\":5,\"e\":\"Solvinden pusher kometens hale med sig, så den altid vender bort fra solen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Komet","d":"wikipedia.org","q":"Ionhalen vender altid bort fra solen uanset kometens bevægelsesretning.","ok":true},{"u":"https://lex.dk/komet","d":"lex.dk","q":"kometens hale, der peger væk fra Solen, er tydelig","ok":true}]},"ktf|{\"s\":\"En ræv lever hovedsageligt af mus.\",\"t\":true,\"age\":4,\"e\":\"Mus er rævens vigtigste føde – den kan også tage fugleæg og ådsler.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Ræv","d":"wikipedia.org","q":"Ræven lever hovedsageligt af smågnavere som markmus, men kan også tage mindre dyr som biller samt fugleæg og ådsler.","ok":true},{"u":"https://www.nationalgeographic.com/animals/mammals/facts/red-fox","d":"nationalgeographic.com","q":"Red foxes are solitary hunters who feed on rodents, rabbits, birds, and other small game","ok":true}]},"ktf|{\"s\":\"På planeten Venus regner det med svovlsyre.\",\"t\":true,\"age\":5,\"e\":\"Skyerne på Venus består af svovlsyre – og derfor er planeten så varm.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-18","daily":true,"sources":[{"u":"https://science.nasa.gov/venus/facts/","d":"science.nasa.gov","q":"The atmosphere is mostly carbon dioxide — the same gas drives the greenhouse effect on both Venus and Earth — with dense clouds composed of sulfuric acid.","ok":true},{"u":"https://en.wikipedia.org/wiki/Venus","d":"wikipedia.org","q":"The atmosphere is composed mostly of carbon dioxide and has a thick cloud layer of sulfuric acid that spans the whole planet.","ok":true}]},"ktf|{\"s\":\"En bænkebider er et krebsdyr, ikke et insekt.\",\"t\":true,\"age\":10,\"e\":\"Bænkebidere er landlevende krebsdyr. De har syv par ben og ånder gennem særlige plader bag på kroppen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Woodlouse","d":"wikipedia.org","q":"woodlice are terrestrial isopods in the suborder oniscidea. their name is derived from being often found in old wood, and from louse, a parasitic insect, although woodlic","ok":true},{"u":"https://lex.dk/b%C3%A6nkebidere","d":"lex.dk","q":"bænkebidere er krebsdyr, som udgør en landlevende gruppe af de ellers marine isopoder ( tanglus ).","ok":true}]},"ktf|{\"s\":\"Nogle østers skifter køn i løbet af livet.\",\"t\":true,\"age\":11,\"e\":\"Hos nogle arter starter de som hanner og bliver senere hunner. Nogle kan skifte flere gange.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Ostrea_edulis","d":"wikipedia.org","q":"the majority of ostrea edulis start life as males. sexual maturity is reached after a period between eight and ten months. and may change sex depending on the water tempe","ok":true},{"u":"https://lex.dk/%C3%B8sters","d":"lex.dk","q":"visse østersarter er særkønnede, andre skifter i løbet af voksenlivet flere gange mellem en hanlig og en hunlig fase.","ok":true}]},"ktf|{\"s\":\"Spækhuggeren er den største delfin.\",\"t\":true,\"age\":10,\"e\":\"Spækhuggere er rovdyr i delfinfamilien og kan blive over 9 meter lange.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Orca","d":"wikipedia.org","q":"the orca ( orcinus orca ), or killer whale , is a toothed whale and the largest member of the oceanic dolphin family.","ok":true},{"u":"https://lex.dk/delfiner","d":"lex.dk","q":"spækhuggeren ( orcinus orca ) kan blive over 9 m lang og er dermed den største delfin.","ok":true}]},"ktf|{\"s\":\"En narhvals stødtand kan blive op til 3 meter lang.\",\"t\":true,\"age\":11,\"e\":\"Det er en snoet tand, som normalt kun vokser ud i venstre side hos hannen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Narwhal","d":"wikipedia.org","q":"males of this species have a spiralled tusk , which is a protruding left canine , that is 1.5-3.0 m (4.9-9.8 ft) long","ok":true},{"u":"https://lex.dk/narhval","d":"lex.dk","q":"hos hannen og normalt kun i venstre side udvikles en op til 3 m lang og 14 kg tung, snoet stødtand.","ok":true}]},"ktf|{\"s\":\"En søstjerne har et lille øje yderst på hver arm.\",\"t\":true,\"age\":10,\"e\":\"Det er en lysfølsom øjeplet. Den kan ikke se skarpt, men den kan mærke lys.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Starfish","d":"wikipedia.org","q":"there are eyespots at the ends of the arms, each one made of 80-200 simple ocelli composed of pigmented epithelial cells.","ok":true},{"u":"https://lex.dk/s%C3%B8stjerner","d":"lex.dk","q":"yderst på hver armspids findes en lille, lysfølsom øjeplet.","ok":true}]},"ktf|{\"s\":\"Bambus er en slags græs.\",\"t\":true,\"age\":9,\"e\":\"Bambus hører til græsfamilien. Nogle arter kan blive op til 40 meter høje.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bamboo","d":"wikipedia.org","q":"bamboos are a diverse group of mostly evergreen perennial flowering plants making up the subfamily bambusoideae of the grass family poaceae.","ok":true},{"u":"https://lex.dk/bambus","d":"lex.dk","q":"bambus er en fællesbetegnelse for ca. 1.000 arter fordelt på 80 slægter, der danner en egen underfamilie af græsfamilien","ok":true}]},"ktf|{\"s\":\"Termitter er tæt i familie med kakerlakker.\",\"t\":true,\"age\":11,\"e\":\"Termitter er sociale insekter, som lever i store samfund. De hører til samme gruppe som kakerlakker.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Termite","d":"wikipedia.org","q":"however, they are not ants but highly derived cockroaches","ok":true},{"u":"https://lex.dk/termitter","d":"lex.dk","q":"termitter, kakerlakker og knælere placeres i ordenen dictyoptera.","ok":true}]},"ktf|{\"s\":\"Vanilje kommer fra en orkidé.\",\"t\":true,\"age\":9,\"e\":\"Vaniljestangen er frugten af en klatrende orkidé. Krydderiet laves af de tørrede bælge.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Vanilla","d":"wikipedia.org","q":"vanilla is a spice derived from orchids of the genus vanilla , primarily obtained from the seed pods of the flat-leaved mexican and central american vanilla ( v. planifol","ok":true},{"u":"https://lex.dk/vanilje","d":"lex.dk","q":"vanilje er en slægt af klatrende, tropiske orkidéer.","ok":true}]},"ktf|{\"s\":\"Sandwichen er opkaldt efter en engelsk jarl.\",\"t\":true,\"age\":9,\"e\":\"John Montagu, 4. jarl af Sandwich, ville ikke forlade kortspillet – så maden blev serveret mellem to stykker brød.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Sandwich","d":"wikipedia.org","q":"the sandwich is named after john montagu, 4th earl of sandwich , an eighteenth-century english aristocrat.","ok":true},{"u":"https://lex.dk/sandwich","d":"lex.dk","q":"john montagu (1718-1792), 4. jarl af sandwich , kunne ikke løsrive sig fra kortspil og lod sig servere denne form for mad under spillet.","ok":true}]},"ktf|{\"s\":\"Et stjerneskud er en stjerne, der falder ned fra himlen.\",\"t\":false,\"age\":9,\"e\":\"Et stjerneskud er en lille sten fra rummet, der brænder op i Jordens atmosfære.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://lex.dk/meteor","d":"lex.dk","q":"en meteor er et kosmisk legeme på vej ned gennem jordens atmosfære.","ok":true},{"u":"https://science.nasa.gov/solar-system/meteors-meteorites/facts/","d":"science.nasa.gov","q":"when meteoroids enter earth's atmosphere, or that of another planet, at high speed and burn up, they're called meteors. this is also when we refer to them as \"shooting st","ok":true}]},"ktf|{\"s\":\"Koraller er dyr, ikke planter.\",\"t\":true,\"age\":9,\"e\":\"Koraller er små polypper, der lever i kolonier og bygger kalksten.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Coral","d":"wikipedia.org","q":"corals are colonial marine invertebrates within the subphylum anthozoa of the phylum cnidaria.","ok":true},{"u":"https://oceanservice.noaa.gov/facts/coral.html","d":"oceanservice.noaa.gov","q":"corals are sessile animals that \"take root\" on the ocean floor.","ok":true}]},"ktf|{\"s\":\"Svampe er hverken planter eller dyr.\",\"t\":true,\"age\":10,\"e\":\"Svampe har deres eget rige. De er faktisk tættere beslægtet med dyr end med planter.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Fungus","d":"wikipedia.org","q":"a characteristic that places fungus in a different kingdom from plants , bacteria , and some protists is having chitin in their cell walls.","ok":true},{"u":"https://www.nhm.ac.uk/discover/future-proofing-with-fungi.html","d":"nhm.ac.uk","q":"fungi are a kingdom of their own , neither plant nor animal.","ok":true}]},"ktf|{\"s\":\"Rafflesia-blomsten lugter af råddent kød for at tiltrække fluer.\",\"t\":true,\"age\":10,\"e\":\"Lugten lokker ådselfluer til. De hjælper blomsten med at overføre pollen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Rafflesia","d":"wikipedia.org","q":"the flowers look and smell like rotting flesh. the foul odour attracts insects such as carrion flies , which transport pollen from male to female flowers.","ok":true},{"u":"https://www.bbc.com/future/article/20240917-titan-arum-the-huge-smelly-corpse-plant-that-takes-a-decade-to-flower","d":"bbc.com","q":"the rafflesia arnoldii , another huge flowering plant which also produces a smell of rotten meat","ok":true}]},"ktf|{\"s\":\"En stor sky kan veje flere hundrede tons.\",\"t\":true,\"age\":11,\"e\":\"En sky er lavet af millioner af vanddråber. Derfor kan selv en almindelig sky veje som et stort passagerfly.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://www.usgs.gov/water-science-school/science/how-much-does-a-cloud-weigh","d":"usgs.gov","q":"that is about 500,000 kilograms or 1.1 million pounds (about 551 tons).","ok":true},{"u":"https://weather.metoffice.gov.uk/learn-about/weather/types-of-weather/clouds/facts-about-clouds","d":"weather.metoffice.gov.uk","q":"this means an average size cumulonimbus would weight about 400,000 kg, roughly the same weight as an airbus a380.","ok":true}]},"ktf|{\"s\":\"På planeten HD 189733b er der skyer med glas i.\",\"t\":true,\"age\":11,\"e\":\"Planeten er en kæmpe gasplanet, hvor det blæser voldsomt, og glasset kan blive slynget rundt.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://science.nasa.gov/exoplanet-catalog/hd-189733-b/","d":"science.nasa.gov","q":"the planet's cobalt blue color comes from a hazy, blow-torched atmosphere containing clouds laced with glass.","ok":true},{"u":"https://en.wikipedia.org/wiki/HD_189733b","d":"wikipedia.org","q":"researchers have found that the planet's weather includes raining molten glass.","ok":true}]},"ktf|{\"s\":\"Astronauter kan blive et par centimeter højere, mens de er i rummet.\",\"t\":true,\"age\":11,\"e\":\"Uden tyngdekraft bliver hvirvlerne i ryggen strakt ud. Højden går tilbage, når de kommer hjem.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://www.nasa.gov/wp-content/uploads/2018/05/whatisyourspaceheight.pdf","d":"nasa.gov","q":"nasa has found that the height of astronauts increases approximately 3% over the first 3 to 4 days of weightlessness in space.","ok":true},{"u":"https://www.scientificamerican.com/article/astronauts-get-taller-in-space/","d":"scientificamerican.com","q":"astronauts in space can grow up to 3 percent taller during the time spent living in microgravity, nasa scientists say.","ok":true}]},"ktf|{\"s\":\"En klovnefisk kan skifte køn.\",\"t\":true,\"age\":10,\"e\":\"Hvis hunen forsvinder, bliver den dominerende han til en hun.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Amphiprioninae","d":"wikipedia.org","q":"when the female disappears, the breeding male changes sex and takes her place while the others move up the hierarchy.","ok":true},{"u":"https://www.australian.museum/learn/teachers/learning/sleek-geeks-videos/sex-change-in-clownfish/","d":"australian.museum","q":"all clownfish have male and female reproductive organs. This means if a breeding female is lost, the dominant male can switch sex to replace her.","ok":true}]},"ktf|{\"s\":\"Der findes en fisk, der kan gå på land.\",\"t\":true,\"age\":9,\"e\":\"Slimskallen bruger sine finner som ben og kan bevæge sig rundt på mudderet.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Mudskipper","d":"wikipedia.org","q":"these fish use their fins to move around in a series of skips.","ok":true},{"u":"https://www.bbc.com/reel/video/p0nqp1h5/watch","d":"bbc.com","q":"meet the mudskipper: the remarkable fish that lives on land","ok":true}]},"ktf|{\"s\":\"Ispinden blev opfundet af en 11-årig dreng.\",\"t\":true,\"age\":9,\"e\":\"Frank Epperson glemte et glas sodavand med en pind i om natten. Næste morgen var det frosset til is.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://lemelson.mit.edu/resources/frank-epperson","d":"lemelson.mit.edu","q":"the ever-popular hot weather treat known as the popsicle™ was invented by frank epperson when he was just eleven years old.","ok":true},{"u":"https://www.npr.org/sections/thesalt/2015/07/22/425294957/how-an-11-year-old-boy-invented-the-popsicle","d":"npr.org","q":"back in 1905, a san francisco bay area kid by the name of frank epperson accidentally invented the summertime treat.","ok":true}]},"ktf|{\"s\":\"Play-Doh blev oprindeligt lavet til at rense tapet med.\",\"t\":true,\"age\":9,\"e\":\"Det var en blød masse, som kunne fjerne sod fra tapetet i hjem med kulovn. Senere blev den til legetøj.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Play-Doh","d":"wikipedia.org","q":"the product was first manufactured in cincinnati , ohio , as a wallpaper cleaner in the 1930s.","ok":true},{"u":"https://www.bbc.co.uk/programmes/p0mt2l2l","d":"bbc.co.uk","q":"the soft putty was used to clean soot and dirt from wallpaper.","ok":true}]},"ktf|{\"s\":\"Mikrobølgeovnen blev opdaget ved et uheld.\",\"t\":true,\"age\":10,\"e\":\"Percy Spencer opdagede, at en chokoladebar i lommen smeltede, da han arbejdede nær en radar.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Microwave_oven","d":"wikipedia.org","q":"in 1945, the heating effect of a high-power microwave beam was independently and accidentally discovered by percy spencer","ok":true},{"u":"https://lemelson.mit.edu/resources/percy-spencer","d":"lemelson.mit.edu","q":"he approached a magnetron and noticed that the chocolate bar in his pocket had started to melt, which he didn't notice at the time was due to the radar's microwaves.","ok":true}]},"ktf|{\"s\":\"Bobleplast blev oprindeligt opfundet som tapet.\",\"t\":true,\"age\":10,\"e\":\"To opfindere forsøgte at lave et tekstureret plastiktapet. Det blev en fiasko – men plasten med luftbobler var perfekt til at pakke ting ind.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Bubble_wrap","d":"wikipedia.org","q":"in 1957, two inventors named alfred fielding and marc chavannes were attempting to create a three-dimensional plastic wallpaper. although the idea was a failure, they fou","ok":true},{"u":"https://www.cbsnews.com/news/bubble-wrap-at-50-a-pop-culture-mainstay/","d":"cbsnews.com","q":"according to aurichio, a new york city designer approached inventors marc chavannes and al fielding in the late 1950s with a proposal for creating textured wallpaper.","ok":true}]},"ktf|{\"s\":\"En mursejler kan sove, mens den flyver.\",\"t\":true,\"age\":11,\"e\":\"Mursejlere tilbringer næsten hele livet i luften og lander næsten kun ved reden.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Common_swift","d":"wikipedia.org","q":"except when nesting, swifts spend their lives in the air, living on the insects caught in flight; they drink, feed, and often mate and sleep on the wing.","ok":true},{"u":"https://rspb.org.uk/birds-and-wildlife/swift/your-guide-to-helping-swifts","d":"rspb.org.uk","q":"swifts spend most of their lives on the wing (in flight). they feed, drink, sleep and even mate in the air, and usually only land at nest sites.","ok":true}]},"ktf|{\"s\":\"Jupiters måne Io har mange aktive vulkaner.\",\"t\":true,\"age\":11,\"e\":\"Io er det mest vulkansk aktive sted i solsystemet. Nogle af dens vulkaner sender lava flere kilometer op.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://science.nasa.gov/jupiter/jupiter-moons/io/","d":"science.nasa.gov","q":"jupiter's moon io is the most volcanically active world in the solar system, with hundreds of volcanoes, some erupting lava fountains dozens of miles (or kilometers) high","ok":true},{"u":"https://en.wikipedia.org/wiki/Io_(moon)","d":"wikipedia.org","q":"the tidal heating produced by io's forced orbital eccentricity has made it the most volcanically active world in the solar system, with hundreds of volcanic centers and e","ok":true}]},"ktf|{\"s\":\"På Saturns måne Titan er der søer af flydende metan.\",\"t\":true,\"age\":11,\"e\":\"Titan er det eneste andet sted i solsystemet, hvor man kender til væsker på overfladen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://science.nasa.gov/saturn/moons/titan/","d":"science.nasa.gov","q":"it has clouds, rain, rivers, lakes and seas of liquid hydrocarbons like methane and ethane.","ok":true},{"u":"https://en.wikipedia.org/wiki/Titan_(moon)","d":"wikipedia.org","q":"the cassini mission team announcing \"definitive evidence of the presence of lakes filled with liquid methane on saturn's moon titan\" in january 2007.","ok":true}]},"ktf|{\"s\":\"Du er lidt højere om morgenen, end du er om aftenen.\",\"t\":true,\"age\":9,\"e\":\"I løbet af dagen presser tyngdekraften hvirvlerne i ryggen sammen. Om natten retter de sig ud igen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://www.nasa.gov/wp-content/uploads/2018/05/whatisyourspaceheight.pdf","d":"nasa.gov","q":"our height becomes less - yes, we shrink - as the day goes on because gravity compresses our bodies. when we lie down at night, gravity no longer pulls in a direction to ","ok":true},{"u":"https://en.wikipedia.org/wiki/Human_height","d":"wikipedia.org","q":"one study revealed a mean decrease of 1.54 centimetres (0.6 in) in the heights of 100 children from getting out of bed in the morning to between 4 and 5 p.m. that same da","ok":true}]},"ktf|{\"s\":\"Hvert øje har en blind plet, hvor synsnerven forlader øjet.\",\"t\":true,\"age\":10,\"e\":\"Der sidder ingen lysfølsomme celler lige der. Hjernen fylder hullet ud, så du normalt ikke lægger mærke til det.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://www.aao.org/eye-health/anatomy/blind-spot","d":"aao.org","q":"in this area there are no light-sensitive cells so this part of your retina can't see. we call this the blind spot.","ok":true},{"u":"https://en.wikipedia.org/wiki/Blind_spot_(anatomy)","d":"wikipedia.org","q":"because there are no rods or cones overlying the optic disc, it corresponds to a small blind spot in each eye.","ok":true}]},"ktf|{\"s\":\"En axolotl kan gro nye lemmer igen, hvis den mister en.\",\"t\":true,\"age\":10,\"e\":\"Axolotlen kan regenerere lemmer, gæller og endda dele af hjernen.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://da.wikipedia.org/wiki/Axolotl","d":"wikipedia.org","q":"regenerere deres lemmer, gæller og i særlige tilfælde mere vitale dele","ok":true},{"u":"https://animals.sandiegozoo.org/animals/axolotl","d":"animals.sandiegozoo.org","q":"Axolotls have another icredible ability: they can regenerate their limbs, lungs, heart, jaws, spines, and even parts of their brain!","ok":true}]},"ktf|{\"s\":\"En ørkenfenneks kæmpestore ører er varmeafledere.\",\"t\":true,\"age\":10,\"e\":\"Ørerne er så store, at de kan afgive kroppens varme og høre bytte under sandet.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Fennec_fox","d":"wikipedia.org","q":"Its most distinctive feature is its unusually large ears, which serve to dissipate heat and listen for underground prey.","ok":true},{"u":"https://nationalzoo.si.edu/animals/fennec-fox","d":"nationalzoo.si.edu","q":"They have the largest ears relative to their body size of any member of the canid family, which they use to dispel heat and track down prey underneath the sand.","ok":true}]},"ktf|{\"s\":\"Der findes en geléhaj, der kan leve for evigt. Den kan blive ung igen.\",\"t\":true,\"age\":11,\"e\":\"Geléhajen kan køre sit livsforløb baglæns.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","daily":true,"sources":[{"u":"https://en.wikipedia.org/wiki/Turritopsis_dohrnii","d":"wikipedia.org","q":"rendering Turritopsis dohrnii potentially biologically immortal","ok":true},{"u":"https://theconversation.com/how-immortal-jellyfish-turn-back-time-197304","d":"theconversation.com","q":"it can choose an alternative path and reverse its life cycle","ok":true}]},"ktf|{\"s\":\"En bændorm (også kaldet vandbjørn) kan overleve i rummet.\",\"t\":true,\"age\":11,\"e\":\"Bændormen overlevede flere dage i vakuum i 2007.\"}":{"pool":"ktf","status":"bekræftet","date":"2026-11-19","
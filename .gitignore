# Filer og mapper der IKKE skal lægges offentligt på GitHub.
# Notér: alt hvad der står her, holdes ude af git; skal en af disse alligevel legges på en
# release, sker det som et release-asset (ikke som fil i grenen).

# Python og editor
__pycache__/
*.py[cod]
node_modules/
.vscode/
.idea/
Thumbs.db
.DS_Store
*.bak
*.tmp

# Byggede udgivelsespakker – hører hjemme i release-asset, aldrig i grenen
out/
ud/
hyggespil.zip

# Nøgler, lokale mellemresultater og personlige data – ALDRIG offentligt
tools/secrets/
tools/feedback_inbox.md
tools/auto_release.log
*.token
github.json

# Udviklerens private register over kilder og mellemresultater fra kildetjek
custom_components/hyggespil/www/ledger.json
custom_components/hyggespil/www/verify_state.json
custom_components/hyggespil/www/extra_pending.json

# Brugeres egne tiltføjelser (indholder personlige spørgsmål) – bevares på enheden, deles ikke
custom_components/hyggespil/www/hs-user-pools.js

# Brugerens/udviklerens egne/spørgsmålstilføjelser – aldrig pubiceret indhold
custom_components/hyggespil/www/extra.json
tools/*.log
custom_components/hyggespil/www/backup.js.local

# Midlertidige udvikler-scripts (altid med underscore)
tools/_*.js
# Midlertidig udviklerhjælp (én underscore; ikke __init__.py)
tools/_[^_]*
tools/klar_ci.js
tools/verificer.js
tools/ci.js
tools/sammenlign_trae.js
tools/kaede.js
tools/gransk_ordspil.js
